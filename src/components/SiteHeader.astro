---
// components
import MobileNav from "./MobileNav.tsx";
import ActionMenu from "./header/ActionMenu.tsx";
import LangToggle from "./header/LangToggle.tsx";
import Brand from "./brand/Brand.astro";
import InfoIcon from "./icons/InfoIcon.astro";

// others
import { cn } from "../lib/utils";

// Public site header (design `InfoHeader` / `InfoHeaderMobile`), shared across the
// whole customer-facing site. Two presentations of one nav model:
//   • ≥md — the design's `InfoHeader`: logo, centered 5-link pill nav, and a right
//     cluster of LangToggle → phone → "Zarezerwuj" CTA → <ActionMenu>. Its reflow is
//     driven by CONTAINER QUERIES ported verbatim from the design (see the <style>
//     block below), not by viewport breakpoints — the project's embeddable-panels
//     lesson, and what the design itself uses.
//   • <md — the design's `InfoHeaderMobile`: logo + LangToggle + <ActionMenu>, plus
//     the hamburger overlay (<MobileNav>) our app still needs for nav.
//
// <LangToggle> is visible at EVERY width, by design: it is the only affordance a
// recruiter landing on a Polish page has. No account chrome — v1 customers are
// anonymous, so the staff sign-in lives in the footer. The inner row caps at 1800px
// (max-w-shell, mirrors the footer) while page bodies stay at 1180 (S-09 P8). Plain
// anchors; the layout's <ClientRouter /> upgrades them to view transitions.
//
// The old two-segment contact/booking toggle is GONE, not adapted — see <ActionMenu>.

type NavId = "home" | "fleet" | "pricing" | "faq" | "about";

interface Props {
  active?: NavId;
}

const { active } = Astro.props;
const { locale, t } = Astro.locals;

// "Put me back where I was" after the switch. Re-validated server-side by
// `safeInternalPath`, so a tampered value can only resolve to an internal path.
// The query string rides along: a filtered `/fleet?type=cargo` must survive.
const redirect = Astro.url.pathname + Astro.url.search;

// The "Flota" nav item becomes "Fleet" while <Brand> keeps the untranslated
// BRAND — identical string, opposite requirement, which is why they live in
// different catalog namespaces (`nav` vs `layout`).
const nav: { id: NavId; label: string; href: string }[] = [
  { id: "home", label: t("nav.home"), href: "/" },
  { id: "fleet", label: t("nav.fleet"), href: "/fleet" },
  { id: "pricing", label: t("nav.pricing"), href: "/pricing" },
  { id: "faq", label: t("nav.faq"), href: "/faq" },
  { id: "about", label: t("nav.about"), href: "/about" },
];
---

<header class="bg-card border-b border-[var(--flota-hair-2)]">
  <!-- ── Desktop / tablet (≥md) — design `InfoHeader` ─────────────────────── -->
  <div class="info-header-root hidden md:block">
    <div class="info-header max-w-shell mx-auto flex items-center justify-between gap-5 px-[48px] py-[18px]">
      <a href="/" class="flex shrink-0 items-center">
        <Brand class="gap-1.5" markClass="h-10" wordmarkClass="text-[20px] tracking-[-0.4px]" />
      </a>

      <!-- Centered pill nav. `whitespace-nowrap` on every item is load-bearing:
           without it the labels are the only thing in a `justify-between` row that
           can give, which is how the old header wrapped "O nas" at 768–790px.

           `leading-[normal]` is the design's own line-height, and it is what makes the
           bar 82px instead of 87px. The design sets none, so its items inherit the UA
           `normal` (17.4px at 14.5px); this app inherits 1.5 (21.75px), which grew the
           item to 40px, the pill to 50px and the bar to 87px — the whole of the 5px
           delta the Phase 3 vision-diff found against `header-1280-pl.png`. Not carried
           to `LandingNav`'s pill: that fork has its own design and no mockup in this
           change's canonical set. -->
      <nav class="bg-background flex shrink-0 items-center gap-0.5 rounded-full p-[5px_6px]">
        {
          nav.map((item) => (
            <a
              href={item.href}
              class:list={cn(
                "info-nav-pill rounded-full px-[18px] py-[9px] text-[14.5px] leading-[normal] whitespace-nowrap transition-colors",
                active === item.id
                  ? "bg-card text-foreground font-[650] shadow-[0_2px_6px_rgba(14,21,36,0.15)]"
                  : "font-medium text-[#5A6373]",
              )}
            >
              {item.label}
            </a>
          ))
        }
      </nav>

      <div class="flex shrink-0 items-center gap-3">
        <LangToggle client:idle locale={locale} redirect={redirect} />

        <a href="tel:+48221002030" class="info-phone text-foreground items-center gap-2 text-[14.5px] font-bold">
          <InfoIcon name="phone" size={16} color="var(--flota-accent)" />
          +48 22 100 20 30
        </a>

        <a
          href="/fleet"
          class="info-cta bg-ink-deep h-[44px] shrink-0 items-center rounded-full px-[22px] text-[14.5px] font-semibold whitespace-nowrap text-white"
        >
          {t("nav.reserve")}
        </a>

        <div class="info-toggle shrink-0">
          <ActionMenu client:idle locale={locale} />
        </div>
      </div>
    </div>
  </div>

  <!-- ── Mobile (<md) — design `InfoHeaderMobile` ─────────────────────────── -->
  {
    /* The design's mobile cluster is LangToggle + ActionMenu and nothing else,
       because in the design mobile nav lives in a floating `PublicDock` pill this
       app does not have. Dropping the hamburger here would leave a phone with no
       way to reach the other four pages, so it stays — recorded as
       `deviation(no PublicDock in app; hamburger retains mobile nav)`. */
  }
  <div class="flex items-center justify-between px-[18px] py-[14px] md:hidden">
    {
      /* `min-w-0` + `truncate` on the brand is the guard the OLD header lacked: with
         the cluster at 196px and the bar's 36px padding, the row fits from 360px
         (this project's documented viewport floor) up with 11px to spare, and below
         it the wordmark clips instead of pushing a horizontal scrollbar across the
         whole page. Exactly the `min-w-0`/`truncate` absence the 768–790px nav-wrap
         bug was traced to. */
    }
    <a href="/" class="flex min-w-0 items-center">
      <Brand class="min-w-0 gap-[5px]" markClass="h-[34px]" wordmarkClass="truncate text-[18px] tracking-[-0.4px]" />
    </a>

    <div class="flex items-center gap-2">
      <LangToggle client:idle locale={locale} redirect={redirect} />
      <ActionMenu client:idle locale={locale} />
      <MobileNav active={active} locale={locale} client:idle />
    </div>
  </div>
</header>

<style>
  /* Reflow ported VERBATIM from the design's `InfoHeader` (`info-pages.jsx`), which
     drives it with container queries on a `container-type: inline-size` root rather
     than viewport breakpoints. Kept as raw CSS for two reasons: Tailwind's `@max-[N]`
     variant compiles to `width < N` (strictly less), which would flip the phone/CTA
     back on at exactly 980px; and writing the same `max-width` thresholds the design
     uses keeps the two provably identical. */
  .info-header-root {
    container-type: inline-size;
  }
  .info-phone {
    display: inline-flex;
  }
  .info-cta {
    display: inline-flex;
    align-items: center;
  }
  .info-toggle {
    display: none;
  }
  @container (max-width: 1180px) {
    .info-header {
      padding-left: 28px;
      padding-right: 28px;
    }
  }
  @container (max-width: 980px) {
    .info-phone,
    .info-cta {
      display: none;
    }
    .info-toggle {
      display: inline-flex;
    }
  }
  @container (max-width: 840px) {
    .info-nav-pill {
      padding-left: 13px;
      padding-right: 13px;
    }
  }
</style>
