---
// components
import MobileNav from "./MobileNav.tsx";
import Brand from "./brand/Brand.astro";
import InfoIcon from "./icons/InfoIcon.astro";

// others
import { cn } from "../lib/utils";

// Public site header (design `InfoHeader` / `InfoHeaderMobile`), shared across the
// whole customer-facing site. Three presentations of one nav model:
//   • Desktop (sm+): logo left, centered 5-link pill nav, phone + "Zarezerwuj" CTA right.
//   • Mobile (<sm): logo left; a phone-reveal chip + hamburger overlay (<MobileNav>) right.
// No account chrome: v1 customers are anonymous, so the staff sign-in lives elsewhere.
// The inner row caps at 1180px (mirrors the footer) with a 48px desktop gutter floor,
// so header, page body, and footer share one content edge above the design canvas.
// Plain anchors; the layout's <ClientRouter /> upgrades them to view transitions.

type NavId = "home" | "fleet" | "pricing" | "faq" | "about";

interface Props {
  active?: NavId;
}

const { active } = Astro.props;

const nav: { id: NavId; label: string; href: string }[] = [
  { id: "home", label: "Start", href: "/" },
  { id: "fleet", label: "Flota", href: "/fleet" },
  { id: "pricing", label: "Cennik", href: "/pricing" },
  { id: "faq", label: "FAQ", href: "/faq" },
  { id: "about", label: "O nas", href: "/about" },
];
---

<header class="bg-card border-b border-[var(--flota-hair-2)]">
  <div class="mx-auto flex max-w-[1180px] items-center justify-between px-[18px] py-[14px] sm:px-[48px] sm:py-[18px]">
    <a href="/" class="flex items-center">
      <Brand
        class="gap-1.5"
        markClass="h-[34px] sm:h-10"
        wordmarkClass="text-[18px] tracking-[-0.4px] sm:text-[20px]"
      />
    </a>

    <!-- Desktop pill nav (centered); hidden on mobile in favour of the overlay. -->
    <nav class="bg-background hidden items-center gap-0.5 rounded-full p-[5px_6px] sm:flex">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={cn(
              "rounded-full px-[18px] py-[9px] text-[14.5px] transition-colors",
              active === item.id
                ? "bg-card text-foreground font-[650] shadow-[0_2px_6px_rgba(14,21,36,0.15)]"
                : "font-medium text-[#5A6373]",
            )}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <!-- Desktop phone + reservation CTA; hidden on mobile. -->
    <div class="hidden items-center gap-[18px] sm:flex">
      <a href="tel:+48221002030" class="text-foreground inline-flex items-center gap-2 text-[14.5px] font-bold">
        <InfoIcon name="phone" size={16} color="var(--flota-accent)" />
        +48 22 100 20 30
      </a>
      <a
        href="/fleet"
        class="bg-ink-deep inline-flex items-center rounded-full px-[22px] py-[13px] text-[14.5px] font-semibold text-white"
      >
        Zarezerwuj
      </a>
    </div>

    <!-- Mobile controls (phone-reveal + hamburger overlay); hidden on sm+. -->
    <div class="sm:hidden">
      <MobileNav active={active} client:idle />
    </div>
  </div>
</header>
