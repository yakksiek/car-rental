---
// components
import VehicleSilhouette from "./VehicleSilhouette.astro";
import SpecIcon from "./SpecIcon.astro";

// others
import type { Vehicle } from "../../types";
import { formatPln, formatPayloadKg } from "../../lib/format";
import { categoryLabel, fuelLabel, transmissionLabel } from "../../lib/i18n/vehicle";
import { vehicleSlug } from "../../lib/slug";

// Landing-only "Popularne" card (S8) — a FORK of the shared VehicleCard (which backs
// /fleet + the reservation flow and must stay untouched). Differences per the mock:
// type/status top-left over a gradient image, 4-spec row, "od {daily} zł /dzień", a
// "Rezerwuj" CTA, and NO monthly/deposit line. The whole card is the detail link.
//
// It renders inside a 1-up → 3-up grid, so it is marked `@container` and drives its
// internal split by its OWN width (`@min-[400px]:`), never the viewport — the
// "embeddable panels" lesson. Wider (desktop 3-up / tablet 2-up) cards show the "od"
// prefix; the narrower mobile 1-up card drops it, matching the mock.

interface Props {
  vehicle: Vehicle;
}

const { vehicle } = Astro.props;
const { locale, t } = Astro.locals;

// Title = make + model on one line (e.g. "Renault Master"); subtitle = category · year
// (e.g. "Cargo van · 2021"), matching the live design's descriptor + year — the category
// is the descriptor our data model carries.
const title = [vehicle.make ?? vehicle.name, vehicle.model].filter(Boolean).join(" ");
const subtitle = [categoryLabel(vehicle.category, locale), vehicle.production_year].filter(Boolean).join(" · ");
const slug = vehicleSlug(vehicle.make ?? vehicle.name, vehicle.model ?? "");
const href = `/fleet/${vehicle.id}/${slug}`;

// A real photo fills the image block edge-to-edge (object-cover, full-bleed like the
// canonical); with none, the geometric silhouette sits centered on the gradient.
const photo = vehicle.photos.length > 0 ? vehicle.photos[0] : null;

const specs = [
  { icon: "seats" as const, value: vehicle.seats === null ? "—" : String(vehicle.seats) },
  { icon: "transmission" as const, value: transmissionLabel(vehicle.transmission, locale) },
  { icon: "fuel" as const, value: fuelLabel(vehicle.fuel_type, locale) },
  { icon: "payload" as const, value: formatPayloadKg(vehicle.payload_capacity_kg, locale) },
];
---

<!-- `@container` lives on the wrapper (not the <a>): a container query resolves against
     the nearest ANCESTOR container, so the card's own `@min-[400px]:` splits — the 18px
     radius plus the descendant padding/title/"od"/CTA switches — must query a parent. -->
<div class="@container">
  <a
    href={href}
    class="group bg-card border-border flex flex-col overflow-hidden rounded-xl border transition hover:-translate-y-0.5 hover:[box-shadow:0_18px_40px_-16px_rgba(0,0,0,0.30)] @min-[400px]:rounded-[18px]"
  >
    <!-- Image: rounded inset block, padded off the card edges (S8: rounded-[12px] mobile /
         [14px] desktop) over a gradient placeholder → silhouette/photo; status pill top-left. -->
    <div class="p-4 pb-0 @min-[400px]:p-[18px] @min-[400px]:pb-0">
      <div
        class="relative h-[150px] overflow-hidden rounded-[14px] [background:linear-gradient(135deg,#EEF1F5_0%,#E3E7EC_100%)] @min-[400px]:rounded-[12px]"
      >
        {
          photo ? (
            <img src={photo} alt={title} class="h-full w-full object-cover" loading="lazy" />
          ) : (
            <div class="flex h-full items-center justify-center text-[#B7C0CE]">
              <VehicleSilhouette category={vehicle.category} alt={title} class="max-w-[220px]" />
            </div>
          )
        }
      </div>
    </div>

    <!-- Padded content. -->
    <div class="flex flex-1 flex-col p-4 @min-[400px]:p-[18px]">
      <!-- Title (make + model) / sub (year). -->
      <div>
        <div
          class="text-foreground truncate text-[19px] font-bold tracking-[-0.4px] @min-[400px]:text-[18px] @min-[400px]:tracking-[-0.3px]"
        >
          {title}
        </div>
        {subtitle && <div class="text-muted-foreground truncate text-[13px]">{subtitle}</div>}
      </div>

      <!-- 4-up spec row. -->
      <div
        class="border-border @min-[400px]:divide-border mt-3 grid grid-cols-4 gap-2 border-y py-3 @min-[400px]:divide-x @min-[400px]:border-y-0 @min-[400px]:border-b"
      >
        {
          specs.map((spec) => (
            <div class="flex min-w-0 flex-col items-center gap-1.5 text-center">
              <SpecIcon name={spec.icon} class="text-muted-foreground size-[14px]" />
              <span class="text-foreground w-full truncate text-[12px] font-semibold @min-[280px]:w-auto">
                {spec.value}
              </span>
            </div>
          ))
        }
      </div>

      <!-- Price + CTA (no monthly/deposit line — that is why this card is forked). -->
      <div
        class="mt-3.5 flex flex-col items-stretch gap-3.5 @min-[280px]:flex-row @min-[280px]:items-end @min-[280px]:justify-between @min-[280px]:gap-3 @min-[400px]:items-center"
      >
        <div class="text-foreground text-[24px] leading-none font-bold tracking-tight @min-[400px]:text-[22px]">
          <span class="text-muted-foreground hidden text-[12px] font-medium @min-[400px]:inline">
            {t("vehicle.from")}{" "}
          </span>{formatPln(vehicle.daily_rate, locale)}<span class="text-muted-foreground text-[13px] font-medium"
            >&nbsp;{t("vehicle.perDay")}</span
          >
        </div>
        <span
          class="inline-flex h-11 w-full shrink-0 items-center justify-center gap-1.5 rounded-[12px] bg-[var(--flota-ink-deep)] px-3.5 text-[13.5px] font-[650] text-white @min-[280px]:w-auto @min-[400px]:h-10 @min-[400px]:rounded-[11px] @min-[400px]:text-[14px]"
        >
          {t("vehicle.reserve")}
          <svg
            class="size-3.5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.9"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14M13 6l6 6-6 6"></path>
          </svg>
        </span>
      </div>
    </div>
  </a>
</div>
