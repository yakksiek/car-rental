---
// components
import VehicleSilhouette from "./VehicleSilhouette.astro";
import VehicleGallery from "./VehicleGallery.tsx";
import SpecIcon from "./SpecIcon.astro";
import InfoIcon from "../icons/InfoIcon.astro";
import BookingWidget from "./BookingWidget.tsx";

// others
import type { Vehicle, VehicleBusyRange } from "../../types";
import { formatPayloadKg, formatCargoDims } from "../../lib/format";
import { categoryLabel, fuelLabel, transmissionLabel } from "../../lib/i18n/vehicle";

// The vehicle detail page — also step 1 ("Daty") of the reservation flow
// (design desktop-1). Left column: the hero (year · type, make + model title,
// status pill, image gallery), a 3-column SPECYFIKACJA icon grid, and a trust
// row. Right column (sticky on desktop): the <BookingWidget> island, which owns
// the date range, the live estimate, and the reserve action that hands the
// vehicle id + chosen dates to /reserve (step 2). When the vehicle has photos
// the <VehicleGallery> island renders a swipeable carousel; otherwise it falls
// back to the per-category silhouette (storage is S-05).

interface Props {
  vehicle: Vehicle;
  pickup?: string | null;
  returnDate?: string | null;
  /** Pending + confirmed date bounds the booking calendar greys out (Phase 6). */
  busyRanges?: VehicleBusyRange[];
}

const { vehicle, pickup, returnDate, busyRanges = [] } = Astro.props;
const { locale, t } = Astro.locals;

const title = [vehicle.make ?? vehicle.name, vehicle.model].filter(Boolean).join(" ");

const specs = [
  { icon: "seats" as const, label: t("fleet.specSeats"), value: vehicle.seats === null ? "—" : String(vehicle.seats) },
  {
    icon: "transmission" as const,
    label: t("fleet.specTransmission"),
    value: transmissionLabel(vehicle.transmission, locale),
  },
  { icon: "fuel" as const, label: t("fleet.specFuel"), value: fuelLabel(vehicle.fuel_type, locale) },
  {
    icon: "payload" as const,
    label: t("fleet.specPayload"),
    value: formatPayloadKg(vehicle.payload_capacity_kg, locale),
  },
  {
    icon: "cargo" as const,
    label: t("fleet.specCargo"),
    value: formatCargoDims(vehicle.cargo_length_cm, vehicle.cargo_width_cm, vehicle.cargo_height_cm),
  },
  {
    icon: "distance" as const,
    label: t("fleet.specKmLimit"),
    value: vehicle.km_limit === null ? "—" : `${vehicle.km_limit} km`,
  },
];

// Trust row (design desktop-1): static reassurance, not data-backed. The depot
// is the single fixed branch (no location model yet — same as HeroSearch).
// The design varies the glyph per promise — payment, insurance, availability —
// where this row used to repeat the same check three times. `shield` stands in
// for the design's key (D-10): it is already in the icon set and reads as
// insurance directly.
const trust = [
  { icon: "check" as const, title: t("fleet.trustPaymentTitle"), note: t("fleet.trustPaymentNote") },
  { icon: "shield" as const, title: t("fleet.trustInsuranceTitle"), note: t("fleet.trustInsuranceNote") },
  { icon: "clock" as const, title: t("fleet.trustPickupTitle"), note: t("fleet.trustPickupNote") },
];
---

<article class="lg:max-w-app mx-auto max-w-2xl px-5 pb-32 sm:px-8 md:max-w-3xl lg:pb-16">
  <!-- Top bar: back link -->
  <div class="flex items-center justify-between py-5">
    <a
      href="/fleet"
      class="bg-card shadow-card text-foreground hover:bg-accent inline-flex size-10 items-center justify-center rounded-full transition-colors"
      aria-label={t("fleet.backToFleet")}
    >
      <svg
        class="size-[18px]"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M19 12H5M11 18l-6-6 6-6"></path>
      </svg>
    </a>
  </div>

  <!-- Desktop (lg): scrolling detail (left) + sticky booking widget (right).
       Below lg everything stacks in one column. -->
  <div class="lg:grid lg:grid-cols-[1.5fr_1fr] lg:items-start lg:gap-10">
    <!-- Left: hero + specs + trust -->
    <div class="min-w-0">
      <!-- Hero. Two boards, one tree: below `lg` this <header> IS the card and
           holds the centred eyebrow, h1 and media, exactly as the mobile board
           draws it. At `lg` the header sheds its chrome and goes left-aligned,
           and the media child picks the chrome up as the desktop board's
           standalone image card. Duplicating the header per breakpoint would put
           a second <h1> in the DOM, so the split is done in CSS instead. -->
      <header
        class="bg-card shadow-card rounded-3xl px-6 pt-8 pb-7 text-center lg:rounded-none lg:bg-transparent lg:p-0 lg:text-left lg:shadow-none"
      >
        <p class="text-muted-foreground text-xs font-[650] tracking-wide uppercase">
          {vehicle.production_year ? `${vehicle.production_year} · ` : ""}{categoryLabel(vehicle.category, locale)}
        </p>
        <h1
          class="text-foreground mt-2 text-4xl font-bold tracking-tight sm:text-5xl lg:text-[48px] lg:leading-none lg:tracking-[-1.6px]"
        >
          {title}
        </h1>

        <!-- Image card at `lg`: radius 24, padding 40/32, min-height 320, 24px
             above and below. Below `lg` it stays a bare block inside the header
             card, unchanged. -->
        <div
          class="text-foreground lg:bg-card lg:shadow-card mt-4 lg:my-6 lg:flex lg:min-h-[320px] lg:items-center lg:justify-center lg:rounded-[24px] lg:px-8 lg:py-10"
        >
          {
            vehicle.photos.length > 0 ? (
              <VehicleGallery photos={vehicle.photos} alt={title} locale={locale} client:idle />
            ) : (
              <div class="flex items-center justify-center px-2">
                <VehicleSilhouette
                  category={vehicle.category}
                  photos={vehicle.photos}
                  alt={title}
                  class="max-w-[320px] lg:max-w-[420px]"
                />
              </div>
            )
          }
        </div>
      </header>

      <!-- Specifications: 3-column icon grid (design desktop-1). -->
      <section class="pt-7 lg:pt-0">
        <h2 class="text-muted-foreground mx-1 mt-2 mb-3.5 text-[13px] font-bold tracking-[0.4px] uppercase">
          {t("fleet.specsHeading")}
        </h2>
        <dl class="grid grid-cols-2 gap-3 sm:grid-cols-3">
          {
            /* Compact tile: the design keeps a bare 15px icon inline with the
               label and drops the value onto a second line. The 32px icon
               container this used to stack above the label is what made the tile
               116.5px tall. The icon takes its colour from the <dt> through
               `currentColor`, so no colour class is needed on it. The flex row
               lives ON the <dt> rather than in a wrapper <div>, because inside a
               <dl> the <dt> has to stay a direct child of its grouping <div>. */
            specs.map((spec) => (
              <div class="bg-card shadow-card rounded-[16px] p-[18px]">
                <dt class="text-muted-foreground flex items-center gap-2 text-[10.5px] leading-[normal] font-[650] tracking-[0.2px] uppercase">
                  <SpecIcon name={spec.icon} class="size-[15px] shrink-0" />
                  {spec.label}
                </dt>
                <dd class="text-foreground mt-2 text-[16px] leading-[normal] font-[650] tracking-[-0.3px]">
                  {spec.value}
                </dd>
              </div>
            ))
          }
        </dl>
      </section>

      <!-- What's included. The design draws this as a light reassurance strip on
           the page ground, not as three cards: the card chrome plus a longer
           first note is what made this row 87px against the design's 42.8px. The
           title carries `leading-[normal]` because the design sets no
           line-height on it; the note's 1.4 is specified. -->
      <section class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-3">
        {
          trust.map((item) => (
            <div class="flex items-start gap-3 px-0.5 py-1">
              <span class="text-success flex size-[34px] shrink-0 items-center justify-center rounded-[10px] bg-[var(--flota-success-soft)]">
                <InfoIcon name={item.icon} size={16} />
              </span>
              <div class="min-w-0">
                <p class="text-foreground text-[13.5px] leading-[normal] font-[650] tracking-[-0.1px]">{item.title}</p>
                <p class="text-muted-foreground mt-0.5 text-[12px] leading-[1.4]">{item.note}</p>
              </div>
            </div>
          ))
        }
      </section>
    </div>

    <!-- Right: booking widget (step 1). On mobile it stacks below, with a sticky
         bottom CTA bar (the calendar is far up the page). -->
    <div class="mt-7 lg:mt-0">
      <BookingWidget
        locale={locale}
        client:load
        vehicleId={vehicle.id}
        dailyRate={vehicle.daily_rate}
        monthlyRate={vehicle.monthly_rate}
        deposit={vehicle.deposit}
        initialPickup={pickup}
        initialReturn={returnDate}
        busyRanges={busyRanges}
      />
    </div>
  </div>
</article>
