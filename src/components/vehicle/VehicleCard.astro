---
// components
import VehicleSilhouette from "./VehicleSilhouette.astro";
import SpecIcon from "./SpecIcon.astro";

// others
import type { Vehicle } from "../../types";
import { categoryLabelPl, formatPln, fuelLabelPl, formatPayloadKg, transmissionLabelPl } from "../../lib/format";
import { vehicleSlug } from "../../lib/slug";

// The catalog card (design ScreenDesktopFleet → FleetCardBig). Used ONLY on /fleet,
// so restyling it in place is isolated — no reservation-funnel / Cennik ripple. The
// whole card is one link to the detail route; the "Rezerwuj" affordance is a styled
// span (not a nested button) so it stays a single anchor. Selected dates, when set,
// ride along in the href so the detail page can forward them into the Reserve CTA.
//
// The card is marked `@container` and drives its footer split by its OWN width
// (`@min-[360px]:`), never the viewport (the "size internal layout by container
// width" lesson): a wide 3-up desktop card lays price + CTA side-by-side (the 360px
// threshold reaches the 3-col grid at ~1280px vw, not ~1340); the narrower 2-up
// tablet and 1-up mobile cards stack the CTA full-width beneath.

interface Props {
  vehicle: Vehicle;
  pickup?: string | null;
  returnDate?: string | null;
}

const { vehicle, pickup, returnDate } = Astro.props;

const title = vehicle.make ?? vehicle.name;
const subtitle = [vehicle.model, vehicle.production_year].filter(Boolean).join(" · ");
const slug = vehicleSlug(vehicle.make ?? vehicle.name, vehicle.model ?? "");

const params = pickup && returnDate ? `?pickup=${pickup}&return=${returnDate}` : "";
const href = `/fleet/${vehicle.id}/${slug}${params}`;

// A real photo fills the 16:9 frame edge-to-edge (object-cover); with none, the
// geometric silhouette sits centered on the mock's diagonal gradient placeholder.
const photo = vehicle.photos.length > 0 ? vehicle.photos[0] : null;

const specs = [
  { icon: "seats" as const, value: vehicle.seats === null ? "—" : String(vehicle.seats) },
  { icon: "transmission" as const, value: transmissionLabelPl(vehicle.transmission) },
  { icon: "fuel" as const, value: fuelLabelPl(vehicle.fuel_type) },
  { icon: "payload" as const, value: formatPayloadKg(vehicle.payload_capacity_kg) },
];
---

<div class="@container">
  <a
    href={href}
    class="group bg-card shadow-card hover:shadow-pop flex flex-col rounded-[22px] p-[22px] transition hover:-translate-y-0.5"
  >
    <!-- Eyebrow / title / subtitle -->
    <div class="min-w-0">
      <div class="text-muted-foreground text-[11px] font-bold tracking-[0.4px] uppercase">
        {vehicle.production_year ? `${vehicle.production_year} · ` : ""}{categoryLabelPl(vehicle.category)}
      </div>
      <div class="mt-2 truncate text-[21px] leading-[1.1] font-bold tracking-[-0.5px] text-[var(--flota-ink)]">
        {title}
      </div>
      {subtitle && <div class="mt-[3px] truncate text-[14px] text-[#5B6474]">{subtitle}</div>}
    </div>

    <!-- Image frame: 16:9 gradient placeholder → silhouette / edge-to-edge photo. -->
    <div
      class="my-4 aspect-[16/9] overflow-hidden rounded-md [background:linear-gradient(-111deg,#EEF1F5_0%,#DBE0E8_100%)]"
    >
      {
        photo ? (
          <img
            src={photo}
            alt={`${title} ${vehicle.model ?? ""}`.trim()}
            class="h-full w-full object-cover"
            loading="lazy"
          />
        ) : (
          <div class="flex h-full items-center justify-center px-6 text-[#B7C0CE]">
            <VehicleSilhouette
              category={vehicle.category}
              alt={`${title} ${vehicle.model ?? ""}`.trim()}
              class="max-w-[260px]"
            />
          </div>
        )
      }
    </div>

    <!-- 4-up spec row with top/bottom hairlines. -->
    <div class="grid grid-cols-4 gap-2 border-y border-[var(--flota-hair-2)] py-[15px]">
      {
        specs.map((spec) => (
          <div class="flex flex-col items-center gap-[7px] text-center">
            <SpecIcon name={spec.icon} class="text-muted-foreground size-[15px]" />
            <span class="truncate text-[12.5px] font-semibold tracking-[-0.1px] text-[var(--flota-ink)]">
              {spec.value}
            </span>
          </div>
        ))
      }
    </div>

    <!-- Footer: price + sub / CTA. Side-by-side when the card is ≥ 400px wide (3-up
         desktop), stacked full-width below when narrower (2-up tablet, 1-up mobile). -->
    <div
      class="mt-4 flex flex-col gap-3.5 @min-[360px]:flex-row @min-[360px]:items-end @min-[360px]:justify-between @min-[360px]:gap-0"
    >
      <div class="min-w-0">
        <div class="text-[24px] leading-none font-bold tracking-[-0.7px] text-[var(--flota-ink)]">
          {formatPln(vehicle.daily_rate)}<span class="text-muted-foreground text-[14px] font-medium">/dzień</span>
        </div>
        <div class="text-muted-foreground mt-1.5 truncate text-[12px] font-medium">
          {formatPln(vehicle.monthly_rate)}/mies. · kaucja {formatPln(vehicle.deposit)}
        </div>
      </div>
      <span
        class="inline-flex h-[44px] w-full shrink-0 items-center justify-center gap-2 rounded-full bg-[var(--flota-ink-deep)] px-5 text-[14px] font-[650] text-white @min-[360px]:w-auto"
      >
        Rezerwuj
        <svg
          class="size-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.9"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 12h14M13 6l6 6-6 6"></path>
        </svg>
      </span>
    </div>
  </a>
</div>
