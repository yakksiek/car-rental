---
// "Proces wynajmu" stepper (S6). Desktop: two lane pills ("Online — bez telefonu" /
// "Telefonicznie") converging into circle 1, then a horizontal 4-circle track. Mobile:
// a vertical timeline with shorter step titles (the branch folds into step 1's copy).
// Static content, verbatim Polish copy; heading in Instrument Serif (font-serif).

const STEPS = [
  {
    n: 1,
    titleDesktop: "Rezerwacja",
    titleMobile: "Rezerwacja",
    desc: "Rezerwujesz online lub telefonicznie, a potwierdzenie terminu wysyłamy e-mailem.",
  },
  {
    n: 2,
    titleDesktop: "Podpisanie dokumentów i płatność",
    titleMobile: "Dokumenty i płatność",
    desc: "Sprawdzamy dokumenty, pobieramy płatność z kaucją, a umowę podpisujesz na tablecie.",
  },
  {
    n: 3,
    titleDesktop: "Oględziny i wydanie pojazdu",
    titleMobile: "Oględziny i wydanie",
    desc: "Wspólnie oglądamy pojazd i odbierasz auto z protokołem wydania na e-mailu.",
  },
  {
    n: 4,
    titleDesktop: "Zwrot pojazdu i kaucja",
    titleMobile: "Zwrot i kaucja",
    desc: "Po oględzinach podpisujesz protokół zwrotu, a kaucja wraca do Ciebie.",
  },
];
---

<section class="max-w-app mx-auto px-5 pt-16 pb-8 sm:px-8">
  <!-- Section header. -->
  <div class="mb-8 max-w-[560px]">
    <p class="text-muted-foreground text-[11px] font-bold tracking-[1.2px] uppercase">Jak to działa</p>
    <h2 class="text-foreground mt-2 font-serif text-[27px] leading-none xl:text-[38px]">
      Proces wynajmu pojazdu<span class="text-primary">.</span>
    </h2>
    <p class="mt-3 text-[15px] text-[#5B6474]">Online albo telefonicznie — wybór należy do Ciebie.</p>
  </div>

  <div class="bg-card rounded-[24px] border border-[#E7EAF0] p-[26px] xl:rounded-[28px] xl:p-16">
    <!-- Desktop: branching lanes → horizontal track. -->
    <div class="hidden xl:block">
      <p class="text-muted-foreground mb-3 text-[12.5px]">Ty wybierasz, jak zaczynasz:</p>
      <div class="mb-2 flex max-w-[520px] gap-3">
        <span
          class="inline-flex items-center gap-2 rounded-full border border-[#E7EAF0] px-4 py-2.5 text-[14px] font-medium text-[#0E1524]"
        >
          <svg
            class="text-primary size-[15px]"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect x="4" y="5" width="16" height="11" rx="1.5"></rect>
            <path d="M2 20h20"></path>
          </svg>
          Online — bez telefonu
        </span>
        <span
          class="inline-flex items-center gap-2 rounded-full border border-[#E7EAF0] px-4 py-2.5 text-[14px] font-medium text-[#0E1524]"
        >
          <svg
            class="text-primary size-[15px]"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path
              d="M15.5 13.5c-1 1-1 1-2 .5a11 11 0 0 1-4.5-4.5c-.5-1-.5-1 .5-2 .4-.4.4-.8.2-1.2L8.4 4.3A1 1 0 0 0 7.4 4H5.3A1.3 1.3 0 0 0 4 5.4 12 12 0 0 0 15.6 17a1.3 1.3 0 0 0 1.4-1.3v-2.1a1 1 0 0 0-.7-1l-1.8-.6c-.4-.1-.8 0-1 .3z"
            ></path>
          </svg>
          Telefonicznie
        </span>
      </div>

      <!-- Two connectors converging into circle 1. -->
      <svg class="h-9 w-[280px]" viewBox="0 0 280 40" fill="none" aria-hidden="true">
        <path d="M70 0 L70 20 Q70 34 40 34 L30 34" stroke="#99A2B2" stroke-width="2"></path>
        <path d="M210 0 L210 20 Q210 34 50 34 L30 34" stroke="#99A2B2" stroke-width="2"></path>
      </svg>

      <!-- Horizontal 4-circle track. -->
      <div class="relative mt-2 grid grid-cols-4 gap-8">
        <span class="absolute top-[30px] right-[12%] left-[12%] z-0 h-[2px] bg-[#E7EAF0]"></span>
        {
          STEPS.map((step) => (
            <div class="relative z-10 flex flex-col items-center text-center">
              <span class="bg-primary text-primary-foreground flex size-[60px] items-center justify-center rounded-full text-[26px] font-bold">
                {step.n}
              </span>
              <div class="text-foreground mt-4 text-[16px] font-bold tracking-tight">{step.titleDesktop}</div>
              <p class="mt-2 text-[13.5px] leading-[21px] text-[#5B6474]">{step.desc}</p>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Mobile: vertical timeline (shorter titles). -->
    <div class="flex flex-col xl:hidden">
      {
        STEPS.map((step, i) => (
          <div class="relative flex gap-4 pb-6 last:pb-0">
            {i < STEPS.length - 1 && <span class="absolute top-[44px] bottom-0 left-[21px] w-[2px] bg-[#E7EAF0]" />}
            <span class="bg-primary text-primary-foreground z-10 flex size-[44px] shrink-0 items-center justify-center rounded-full text-[19px] font-bold">
              {step.n}
            </span>
            <div class="pt-1.5">
              <div class="text-foreground text-[16px] font-bold tracking-tight">{step.titleMobile}</div>
              <p class="mt-1 text-[13.5px] leading-[21px] text-[#5B6474]">{step.desc}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
