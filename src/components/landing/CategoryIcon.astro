---
// others
import { cn } from "../../lib/utils";
import type { VehicleCategory } from "../../types";

// Landing-local category pill glyphs (S7). The design uses lucide icons for four
// categories (truck / bus / snowflake / package) plus a bespoke car-on-flatbed for
// Autolaweta; transcribed here as a small stroke icon set so the shared `SpecIcon`
// and `VehicleSilhouette` (which back /fleet + 6 surfaces) stay untouched.

interface Props {
  category: VehicleCategory;
  class?: string;
}

const { category, class: className } = Astro.props;
---

<svg
  class:list={cn("size-[18px] shrink-0", className)}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {
    category === "cargo_van" && (
      <>
        <path d="M14 18V6a1 1 0 0 0-1-1H3a1 1 0 0 0-1 1v11a1 1 0 0 0 1 1h1" />
        <path d="M15 18H9" />
        <path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.62l-3.48-4.35A1 1 0 0 0 17.52 8H14" />
        <circle cx="7" cy="18" r="2" />
        <circle cx="17" cy="18" r="2" />
      </>
    )
  }
  {
    category === "passenger_van" && (
      <>
        <path d="M8 6v6" />
        <path d="M15 6v6" />
        <path d="M2 12h19.6" />
        <path d="M18 18h3s.5-1.7.8-2.8c.1-.4.2-.8.2-1.2 0-.4-.1-.8-.2-1.2l-1.4-5C20.1 6.8 19.1 6 18 6H4a2 2 0 0 0-2 2v10h3" />
        <circle cx="7" cy="18" r="2" />
        <path d="M9 18h5" />
        <circle cx="16" cy="18" r="2" />
      </>
    )
  }
  {
    category === "car_transporter" && (
      <>
        <path d="M2 15h15l5-3" />
        <path d="M2 15v-3" />
        <path d="M5 12l2-3h6l3 3" />
        <circle cx="7" cy="18" r="1.7" />
        <circle cx="16" cy="18" r="1.7" />
      </>
    )
  }
  {
    category === "refrigerated_truck" && (
      <>
        <line x1="2" x2="22" y1="12" y2="12" />
        <line x1="12" x2="12" y1="2" y2="22" />
        <path d="m20 16-4-4 4-4" />
        <path d="m4 8 4 4-4 4" />
        <path d="m16 4-4 4-4-4" />
        <path d="m8 20 4-4 4 4" />
      </>
    )
  }
  {
    category === "flatbed_truck" && (
      <>
        <path d="M16.5 9.4 7.55 4.24" />
        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
        <path d="M3.29 7 12 12l8.71-5" />
        <path d="M12 22V12" />
      </>
    )
  }
</svg>
