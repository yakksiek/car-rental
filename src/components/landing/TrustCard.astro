---
// others
import { formatInteger, plural } from "../../lib/format";
import { VEHICLE_NOUN_FORMS } from "../../lib/i18n/vehicle";

// Landing trust card (S4) — three rows: a hardcoded ratings PLACEHOLDER, the live
// fleet count, and the reservation channels. Rendered twice (desktop floats in the
// dark hero, mobile stacks in the light sheet); it is static markup, so two copies
// carry no state cost. Each row is title + sub with one large faint accent glyph
// (76px, opacity 0.09) behind it, top-right (design TrustRow, showTiles=false) — no
// boxed icon tiles. Mobile stacks the rows (#EEF1F5 border-b dividers); the tablet
// tier (md) lays them 3-across as a white bar (#EEF1F5 border-r splits); desktop is
// a flex col (gap-2, no dividers).

interface Props {
  count: number;
  class?: string;
}

const { count, class: className } = Astro.props;
const { locale, t } = Astro.locals;

// Live fleet count with the noun form the count takes — 1 pojazd / 2–4 pojazdy /
// 5+ pojazdów, and the 12–14 exception, all from `Intl.PluralRules`. The forms
// live in the vehicle namespace so the hero eyebrow counts the same noun.
const countNoun = plural(count, locale, VEHICLE_NOUN_FORMS[locale]);

// Placeholder review count. Grouped through the app's ONE grouper so the
// separator follows the locale (`1 280` under pl, `1,280` under en) instead of
// being frozen into the markup as a literal U+00A0.
const REVIEW_COUNT = 1280;
---

<div
  class:list={[
    "bg-card border-border overflow-hidden rounded-[20px] border md:grid md:grid-cols-3 xl:flex xl:flex-col xl:gap-2 xl:rounded-[22px] xl:border-transparent xl:[box-shadow:0_18px_40px_-12px_rgba(0,0,0,0.35)]",
    className,
  ]}
>
  <!-- Row 1: ratings — HARDCODED PLACEHOLDER (no reviews feature; deviation, flagged). -->
  <div
    class="relative overflow-hidden border-b border-[#EEF1F5] px-4 py-2.5 md:border-r md:border-b-0 md:px-[18px] xl:border-r-0"
  >
    <svg
      class="text-primary pointer-events-none absolute top-1 right-8 size-[76px] opacity-[0.09]"
      viewBox="0 0 24 24"
      fill="currentColor"
      stroke="none"
      aria-hidden="true"
    >
      <path d="M12 2.6l2.9 5.88 6.49.94-4.7 4.58 1.11 6.46L12 17.98l-5.8 3.05 1.1-6.46-4.69-4.58 6.48-.94z"></path>
    </svg>
    <div class="relative min-w-0">
      <div class="text-foreground text-[17px] leading-tight font-bold">4.9 / 5</div>
      <div class="text-[12.5px] text-[var(--flota-ink-2)]">
        {formatInteger(REVIEW_COUNT, locale)}
        {t("landing.reviews")}
      </div>
    </div>
  </div>

  <!-- Row 2: live fleet count. -->
  <div
    class="relative overflow-hidden border-b border-[#EEF1F5] px-4 py-2.5 md:border-r md:border-b-0 md:px-[18px] xl:border-r-0"
  >
    <svg
      class="text-primary pointer-events-none absolute top-1 right-8 size-[76px] opacity-[0.09]"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.7"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M3 6h10v9H3zM13 9h4l3 3v3h-7z"></path>
      <circle cx="7" cy="17.5" r="1.6"></circle>
      <circle cx="17" cy="17.5" r="1.6"></circle>
    </svg>
    <div class="relative min-w-0">
      <div class="text-foreground text-[17px] leading-tight font-bold">{count} {countNoun}</div>
      <div class="text-[12.5px] text-[var(--flota-ink-2)]">{t("landing.fleetCountSub")}</div>
    </div>
  </div>

  <!-- Row 3: reservation channels. -->
  <div class="relative overflow-hidden px-4 py-2.5 md:px-[18px]">
    <svg
      class="text-primary pointer-events-none absolute top-1 right-8 size-[76px] opacity-[0.09]"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.7"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <rect x="7" y="2.5" width="10" height="19" rx="2.2"></rect>
      <path d="M11 18.5h2"></path>
    </svg>
    <div class="relative min-w-0">
      <div class="text-foreground text-[17px] leading-tight font-bold">{t("landing.channelsTitle")}</div>
      <div class="text-[12.5px] text-[var(--flota-ink-2)]">{t("landing.channelsSub")}</div>
    </div>
  </div>
</div>
