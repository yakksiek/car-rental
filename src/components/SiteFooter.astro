---
// components
import Brand from "./brand/Brand.astro";

// Public site footer (design `InfoFooter`): a 3-column contact footer shared across
// the whole customer-facing site. Brand + tagline, then WYNAJEM / INFORMACJE /
// KONTAKT columns and a bottom copyright bar. The rental-term links point at
// /pricing (no per-term landing pages); "Kontakt" points at the About contact card
// (/about#kontakt). The staff sign-in is intentionally NOT in the public footer —
// staff reach /auth/signin directly. Inner rows cap at 1800px (max-w-shell) to share
// the header's content edge — wider than the 1180 info-page bodies on purpose (S-09 P8).

const wynajem: { label: string; href: string }[] = [
  { label: "Na dobę", href: "/pricing" },
  { label: "Krótkoterminowy", href: "/pricing" },
  { label: "Średnioterminowy", href: "/pricing" },
  { label: "Długoterminowy", href: "/pricing" },
];

const informacje: { label: string; href: string }[] = [
  { label: "O nas", href: "/about" },
  { label: "Cennik", href: "/pricing" },
  { label: "FAQ", href: "/faq" },
  { label: "Kontakt", href: "/about#kontakt" },
];

const columns: { heading: string; items: { label: string; href: string }[] }[] = [
  { heading: "Wynajem", items: wynajem },
  { heading: "Informacje", items: informacje },
];

const itemClass = "text-[13.5px] font-medium text-[#3B4453] transition-colors hover:text-foreground";
const headingClass = "mb-3 text-[11px] font-bold uppercase tracking-[0.5px] text-[#99A2B2]";
---

<footer class="bg-card border-t border-[#E7EAF0]">
  <div class="max-w-shell mx-auto px-[22px] pt-[30px] pb-[26px] sm:px-[48px] sm:pt-[46px] sm:pb-[34px]">
    <div class="flex flex-col justify-between gap-[26px] sm:flex-row sm:gap-10">
      <!-- Brand + tagline -->
      <div class="max-w-[300px]">
        <a href="/" class="mb-3 flex items-center">
          <Brand class="gap-1.5" markClass="h-[38px]" wordmarkClass="text-[18px] tracking-[-0.4px]" />
        </a>
        <p class="text-[13px] leading-[1.5] text-[#5B6474]">
          Wynajem samochodów dostawczych w Warszawie — na dobę, krótko- i długoterminowo.
        </p>
      </div>

      <div class="flex gap-10 sm:gap-16">
        {
          columns.map((col) => (
            <div>
              <div class:list={headingClass}>{col.heading}</div>
              <div class="flex flex-col gap-[9px]">
                {col.items.map((item) => (
                  <a href={item.href} class:list={itemClass}>
                    {item.label}
                  </a>
                ))}
              </div>
            </div>
          ))
        }
      </div>

      <!-- Contact column -->
      <div>
        <div class:list={headingClass}>Kontakt</div>
        <div class="flex flex-col gap-[9px]">
          <a href="tel:+48221002030" class:list={itemClass}>+48 22 100 20 30</a>
          <a href="mailto:kontakt@flota.pl" class:list={itemClass}>kontakt@flota.pl</a>
          <div class="text-[13.5px] font-medium text-[#3B4453]">Al. Jerozolimskie 200, Warszawa</div>
          <div class="text-primary text-[13.5px] font-bold">Czynne 24/7</div>
        </div>
      </div>
    </div>

    <div class="mt-[26px] border-t border-[#EEF1F5] pt-[18px] text-[12px] text-[#99A2B2]">
      © 2026 Flota. Wszelkie prawa zastrzeżone.
    </div>
  </div>
</footer>
