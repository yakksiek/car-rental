---
// components
import NavIcon from "./NavIcon.astro";
import Brand from "../brand/Brand.astro";
import GlobalSearch from "../search/GlobalSearch";
import QuickAddButton from "../dashboard/QuickAddButton";
import LangRow from "./LangRow";

// others
import type { AppRole } from "../../types";
import { staffIdentity } from "../../lib/staff-identity";
import { countReturnsDueToday } from "../../lib/services/protocols";

// Shared staff app-shell (S-03 follow-up L1/L2/L6): a single responsive nav —
// a left sidebar with a user chip at md+, a floating dark tab bar below md —
// wrapping every staff page so the queue and calendar are reachable without
// bouncing through /dashboard. Source: design `staff-desktop.jsx` StaffShell +
// `shared.jsx` TabBar. Profile (S-11) hangs off the account chip and a mobile
// tab rather than the Operations nav list — matching the design.
//
// *** The nav labels are the phase's least visible translation work. *** Of
// `Pulpit` / `Wnioski` / `Wydania` / `Zwroty` / `Kalendarz` / `Flota` /
// `Operacje` / `Profil` / `Wyloguj`, not one carries a diacritic (only `Zespół`
// does), so a diacritic sweep finds almost none of them — they are enumerated in
// `i18n/staff.ts` instead. `navFleet` becomes "Fleet" while the wordmark above
// stays "Flota".

interface Props {
  active: "dash" | "requests" | "pickups" | "returns" | "cal" | "fleet" | "staff" | "me";
  title: string;
  subtitle?: string;
  pendingCount?: number;
  // Open overdue-returns count (S-07) — paints the danger badge on "Zwroty" and
  // deep-links the nav item to the overdue filter. Threaded per page like pendingCount.
  overdueCount?: number;
  user: { email?: string } | null;
  role: AppRole | null;
  // The page's own create action, promoted to the quick-add menu's first row
  // (Phase 6). A KEY, not an object: island props are serialized to JSON, so an
  // icon component and a click handler cannot cross this boundary — the island
  // resolves the key through `PROMOTED_ACTIONS`. Omitted on the five pages that
  // own no create action, which then show the canonical 2-row menu.
  promotedAction?: "vehicle" | "employee";
  // "This page has a normal title header" — and therefore, since S-12b, "this
  // page gets the quick-add pill". The task screens (add/edit vehicle, protocol)
  // draw their own back/close/submit header over unsaved form state, which is
  // both a duplicate heading and no place for a create action (design contract
  // D10). Keep the two coupled: do NOT add a second opt-out prop. It does NOT
  // gate the <GlobalSearch> island — see the render comment on the band.
  showHeader?: boolean;
  // Render the desktop search FIELD? Pulpit only (design `StaffTopbar` takes
  // `search` and only `ScreenStaffDash` passes it). The <GlobalSearch> island is
  // mounted regardless on every page: it owns the ⌘K listener and the mobile
  // overlay, both of which have to work off-Pulpit.
  search?: boolean;
  // Ask the island to open its search surface on mount. Set by Pulpit when it was
  // reached through ⌘K from a fieldless page (`/dashboard?search=1`).
  autoOpen?: boolean;
  // Claim ⌘K on this page? Default true. The two vehicle-form sub-screens pass
  // false: search is a navigation affordance, and the desktop shortcut leaves the
  // page — on a screen whose whole job is data entry that abandons the form. The
  // line is "reached from the menu" (keeps it) vs "reached from inside a screen
  // and holds a form" (doesn't). `protocols/[id]` is a read-only view, so it keeps it.
  searchHotkey?: boolean;
}

const {
  active,
  title,
  subtitle,
  pendingCount = 0,
  overdueCount = 0,
  user,
  role,
  showHeader = true,
  promotedAction,
  search = false,
  autoOpen = false,
  searchHotkey = true,
} = Astro.props;
// Read before `staffIdentity`, which now needs the locale for its role label.
const { isDemo, locale, t } = Astro.locals;
const { initials, displayName, roleLabel } = staffIdentity(user?.email, role, locale);

// The search dropdown's third quick-jump ("Dzisiejsze zwroty") needs a count no
// page currently threads. It is read HERE rather than added to all 10 staff pages'
// `Promise.all`s: one call site cannot drift, and the helper degrades to 0 instead
// of throwing, so the shell can never take a page down. `today` is the server's UTC
// calendar date — the same basis `dashboard.astro` / `returns.astro` use, and it is
// handed to the island so its "dziś / wczoraj" wording survives hydration.
const today = new Date().toISOString().slice(0, 10);
const dueTodayCount = await countReturnsDueToday(Astro.locals.supabase, today);

// The demo marker for the quick-add menu's promoted row. Read HERE rather than
// added to all 10 staff pages' props, for `dueTodayCount`'s reason directly
// above: it is a property of the REQUEST, not of the page, so one call site
// cannot drift while ten can. Only `/dashboard/staff` (promotedAction="employee")
// acts on it — the island ignores it for every other promoted key.
//
// `staff.astro` still passes `isDemo` explicitly to <StaffList>, because that is
// a page-owned island the shell does not mount.

// "Put me back where I was" after a locale switch; re-validated server-side by
// `safeInternalPath`. The query string rides along so a filtered list survives.
const localeRedirect = Astro.url.pathname + Astro.url.search;

// Shared so the two <GlobalSearch> call sites below cannot drift. The island is mounted
// on all 10 pages whether or not the band draws — it owns the ⌘K listener and the mobile
// overlay, and gating it with the band would kill both on the three pages that hide it.
const searchProps = {
  pendingCount,
  overdueCount,
  dueTodayCount,
  today,
  field: search,
  autoOpen,
  hotkey: searchHotkey,
  locale,
};

type IconName = "home" | "list" | "calendar" | "truck" | "key" | "return" | "users" | "user";
// Deep-link "Zwroty" straight to the overdue filter when vehicles are overdue, so
// the badge and the tap land on the same view (S-07 deviation(deep-link)).
const NAV: { id: Props["active"]; href: string; label: string; icon: IconName; badge?: number }[] = [
  { id: "dash", href: "/dashboard", label: t("staff.navDash"), icon: "home" },
  { id: "requests", href: "/dashboard/reservations", label: t("staff.navRequests"), icon: "list", badge: pendingCount },
  { id: "pickups", href: "/dashboard/pickups", label: t("staff.navPickups"), icon: "key" },
  {
    id: "returns",
    href: `/dashboard/returns${overdueCount > 0 ? "?filter=overdue" : ""}`,
    label: t("staff.navReturns"),
    icon: "return",
    badge: overdueCount,
  },
  { id: "cal", href: "/dashboard/calendar", label: t("staff.navCalendar"), icon: "calendar" },
  { id: "fleet", href: "/dashboard/vehicles", label: t("staff.navFleet"), icon: "truck" },
  // Admin-only team tab (S-08) — the first role-gated nav entry. Rendered
  // only for an admin; absent for a plain employee.
  ...(role === "admin"
    ? [{ id: "staff" as const, href: "/dashboard/staff", label: t("staff.navTeam"), icon: "users" as const }]
    : []),
];
---

<div class="bg-background flex min-h-screen">
  {/* ── Sidebar (md+) ─────────────────────────────────────────────── */}
  {/* Icon rail on tablet (md–lg), full sidebar with labels at lg+. */}
  <aside
    class="border-border bg-card sticky top-0 hidden h-screen shrink-0 flex-col border-r py-6 md:flex md:w-[72px] md:items-center md:px-2 lg:w-[240px] lg:items-stretch lg:px-3.5"
  >
    <a
      href="/dashboard"
      class="flex items-center md:justify-center md:pb-4 lg:justify-start lg:gap-2.5 lg:px-2.5 lg:pb-5"
    >
      <Brand variant="mark" markClass="h-6 lg:h-[30px]" class="shrink-0" />
      <span class="hidden leading-none lg:block">
        <span class="text-foreground block text-[15px] font-bold tracking-tight">Flota</span>
        <span class="text-muted-foreground mt-1 block text-[10px] font-semibold tracking-wider uppercase"
          >{roleLabel}</span
        >
      </span>
    </a>

    <div
      class="text-muted-foreground hidden px-2.5 pt-3 pb-1.5 text-[10px] font-bold tracking-wider uppercase lg:block"
    >
      {t("staff.sectionOperations")}
    </div>
    <nav class="flex w-full flex-col gap-0.5 md:items-center lg:items-stretch">
      {
        NAV.map((n) => (
          <a
            href={n.href}
            aria-current={active === n.id ? "page" : undefined}
            title={n.label}
            class:list={[
              "relative flex items-center rounded-[10px] transition-colors md:size-11 md:justify-center lg:size-auto lg:justify-start lg:gap-2.5 lg:px-2.5 lg:py-2.5 lg:text-[13px] lg:tracking-tight",
              active === n.id
                ? "bg-foreground text-background lg:font-[650]"
                : "text-foreground hover:bg-background lg:font-[540]",
            ]}
          >
            <NavIcon glyph={n.icon} size={18} />
            <span class="hidden lg:inline">{n.label}</span>
            {(n.badge ?? 0) > 0 && (
              <span
                class:list={[
                  "flex items-center justify-center font-bold",
                  // tablet rail: a small filled indicator dot on the icon's corner
                  "ring-card absolute top-1 right-1 size-[15px] rounded-full text-[9px] leading-none ring-2",
                  // desktop: an inline soft count pill
                  "lg:static lg:top-auto lg:right-auto lg:ml-auto lg:size-auto lg:h-[18px] lg:min-w-[18px] lg:rounded-full lg:px-1.5 lg:text-[10.5px] lg:ring-0",
                  n.id === "returns"
                    ? "bg-primary lg:text-primary text-white lg:bg-[var(--flota-danger-soft)]"
                    : "bg-warning lg:text-warning text-white lg:bg-[var(--flota-warning-soft)]",
                  active === n.id && "lg:text-background lg:bg-white/20",
                ]}
              >
                {n.badge}
              </span>
            )}
          </a>
        ))
      }
    </nav>

    <div class="mt-auto w-full">
      {
        /* The locale row is the FIRST child of the mt-auto block, above the user
        chip — the one part of the staff chrome with slack (design `SidebarLangRow`;
        the top band cannot hold it, see the note on <LangRow>). Mobile gets no
        chrome control: the tab bar below is already at 8 items = 360px on a 360px
        viewport, so the preference lives on /dashboard/account instead. */
      }
      <LangRow client:idle variant="sidebar" locale={locale} redirect={localeRedirect} />

      {
        /* The chip is the desktop entry point to Profil (S-11) — the design reaches
        the account screen from here rather than from an Operacje nav row. */
      }
      <a
        href="/dashboard/account"
        aria-current={active === "me" ? "page" : undefined}
        aria-label={`${t("staff.profile")} — ${displayName}`}
        title={t("staff.profile")}
        class:list={[
          "mt-2 flex items-center rounded-lg transition-colors md:justify-center md:p-0 lg:justify-start lg:gap-2.5 lg:p-3",
          active === "me"
            ? "bg-background ring-foreground/15 ring-2"
            : "bg-background lg:bg-background md:hover:bg-background md:bg-transparent",
        ]}
      >
        <span
          class="bg-foreground text-background flex size-8 shrink-0 items-center justify-center rounded-full text-[12px] font-bold"
        >
          {initials}
        </span>
        <span class="hidden min-w-0 flex-1 lg:block">
          <span class="text-foreground block truncate text-[12px] font-[650] tracking-tight">{displayName}</span>
          <span class="text-muted-foreground block text-[10.5px]">{roleLabel} · Warszawa</span>
        </span>
      </a>
      {
        /* The pending label rides a `data-` attribute rather than `define:vars`:
          that directive makes the script INLINE, which would ship the TypeScript
          below to the browser unprocessed. */
      }
      <form
        method="POST"
        action="/api/auth/signout"
        class="mt-2 w-full"
        data-signout
        data-signing-out={t("staff.signingOut")}
      >
        <button
          type="submit"
          aria-label={t("staff.signOut")}
          class="text-muted-foreground hover:text-foreground hover:bg-background flex items-center justify-center rounded-[10px] text-xs font-medium transition-colors disabled:opacity-60 md:mx-auto md:size-11 lg:w-full lg:py-2"
        >
          <svg
            class="size-4 lg:hidden"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"></path>
          </svg>
          <span class="hidden lg:inline">{t("staff.signOut")}</span>
        </button>
      </form>
    </div>
  </aside>

  {/* ── Content column ────────────────────────────────────────────── */}
  <div class="flex min-w-0 flex-1 flex-col">
    {
      /* Desktop top bar — the one consistent title/action band across the staff
        pages that carry a normal title (`showHeader`). Pages that used to hand-roll
        their own full-bleed `border-b` band migrated onto its slots — there must
        never be a second band stacked under this one.

        *** The `showHeader={false}` branch is NOT "render nothing". *** <GlobalSearch>
        owns the ⌘K registration and the mobile overlay's `flota:search-open` listener,
        so the island has to mount on all 10 staff pages, band or no band. With `field`
        false it emits no box of its own — the cmdk root is `display: contents` and its
        only child is an `sr-only` label — so those pages still start at their own
        content. Collapsing this ternary to a bare `showHeader && …` fails SILENTLY:
        no type error, no failing test, just no ⌘K on `protocols/[id]` and no mobile
        search overlay on any of the three headerless screens. */
    }
    {
      showHeader ? (
        <header class="border-border bg-card hidden items-center justify-between gap-3 border-b px-8 py-[22px] md:flex">
          <div class="min-w-0">
            <div class="text-foreground text-[21px] leading-[1.1] font-bold tracking-[-0.5px]">{title}</div>
            {subtitle && <div class="text-muted-foreground mt-[3px] text-[13px]">{subtitle}</div>}
          </div>
          {/* The band's right cluster, in the design's own (`StaffTopbar`) order:
              field → the page's control → QuickAdd, gap 12. <GlobalSearch> is first
              and draws its 520px field only where `search` is set (Pulpit); a page
              contributes its own controls through `header-actions`; the quick-add
              pill is the unconditional last child, so it rides onto every page with
              a normal header. `min-w-0` on BOTH sides: the field's 520px flex basis
              would otherwise refuse to shrink and crush the title at md, where the
              content column is only ~696px wide. */}
          <div class="flex min-w-0 items-center justify-end gap-3">
            <GlobalSearch client:load {...searchProps} />
            <slot name="header-actions" />
            <QuickAddButton client:load mode="desktop" promoted={promotedAction} isDemo={isDemo} locale={locale} />
          </div>
        </header>
      ) : (
        <GlobalSearch client:load {...searchProps} />
      )
    }
    <div class="pb-28 md:pb-0">
      <slot />
    </div>
  </div>

  {/* ── Floating tab bar (below md) ───────────────────────────────── */}
  {
    /* The pill grows with the nav: an admin is at 8 items (7 + Profil) = 360px,
    exactly a 360px viewport's width. Cap it to the viewport and let it scroll
    rather than clip — same idiom as FleetTypeScroll's dark pill. Items are
    `shrink-0` so they keep their 40px hit target instead of squeezing. Search
    appends NO ninth tab: it is reached from Pulpit's hero magnifier and ⌘K only
    (an icon inherits its container's scope, so a magnifier in the global nav
    would promise global search from a screen that cannot serve it). */
  }
  <nav
    class="fixed bottom-5 left-1/2 z-30 flex max-w-[calc(100vw-24px)] -translate-x-1/2 gap-1 overflow-x-auto rounded-full bg-[#0A0A0F] p-1.5 shadow-[0_8px_24px_rgba(0,0,0,0.18),0_2px_6px_rgba(0,0,0,0.1)] [scrollbar-width:none] md:hidden [&::-webkit-scrollbar]:hidden"
  >
    {
      /* Icon-only so the pill stays compact regardless of item count (the active
         page is shown by the white highlight + its own <h1>, not an expanding
         label — which would overflow with 7 nav items). Attention counts collapse
         to a small corner dot. */
      NAV.map((n) => (
        <a
          href={n.href}
          aria-current={active === n.id ? "page" : undefined}
          aria-label={n.label}
          class:list={[
            "relative flex size-10 shrink-0 items-center justify-center rounded-full transition-colors",
            active === n.id ? "bg-white text-[#0A0A0F]" : "text-white/70 hover:text-white",
          ]}
        >
          <NavIcon glyph={n.icon} size={18} />
          {(n.badge ?? 0) > 0 && (
            <span
              class:list={[
                "absolute top-1.5 right-1.5 size-2 rounded-full ring-2",
                n.id === "returns" ? "bg-primary" : "bg-warning",
                active === n.id ? "ring-white" : "ring-[#0A0A0F]",
              ]}
            />
          )}
        </a>
      ))
    }
    {
      /* Profil (S-11) — appended after NAV rather than added to it, so it stays
         out of the desktop Operacje sidebar (the chip is that entry point) and
         gives mobile its only account + sign-out affordance. Icon-only, no badge,
         and the pill's last entry: nothing follows it (S-13 adds no tab). */
    }
    <a
      href="/dashboard/account"
      aria-current={active === "me" ? "page" : undefined}
      aria-label={t("staff.profile")}
      class:list={[
        // `shrink-0` for the same reason as the NAV items above — without it this
        // is the pill's ONLY shrinkable child, so at the 360px floor it absorbs
        // the whole 24px overflow alone and collapses to a 16px hit target.
        "relative flex size-10 shrink-0 items-center justify-center rounded-full transition-colors",
        active === "me" ? "bg-white text-[#0A0A0F]" : "text-white/70 hover:text-white",
      ]}
    >
      <NavIcon glyph="user" size={18} />
    </a>
  </nav>
</div>

<script>
  // Sign-out has no React island, so wire a tiny submit handler that disables
  // the button and swaps its label while the native POST → redirect round-trips
  // (otherwise the click gives no feedback). Re-binds after view-transition
  // navigations; guarded so a button is wired only once.
  function bindSignout() {
    document.querySelectorAll<HTMLFormElement>("form[data-signout]").forEach((form) => {
      if (form.dataset.bound) return;
      form.dataset.bound = "1";
      form.addEventListener("submit", () => {
        const btn = form.querySelector<HTMLButtonElement>("button[type='submit']");
        if (!btn) return;
        btn.disabled = true;
        btn.textContent = form.dataset.signingOut ?? "";
      });
    });
  }
  document.addEventListener("astro:page-load", bindSignout);

  // The mobile search magnifier is Astro markup — it lives in the dashboard hero
  // (Pulpit is the only mobile entry point) while the search UI is a React island,
  // so the button asks for the overlay through a document event the island listens
  // for. Bound here rather than on the page because the island is the shell's, and
  // any future Astro trigger only has to carry `data-search-trigger`. Same
  // per-element `dataset.bound` guard as above: this IS an element, unlike the
  // island's document-level ⌘K listener, which needs a module-scoped singleton
  // instead (see useGlobalSearchHotkey.ts).
  function bindSearchTrigger() {
    document.querySelectorAll<HTMLButtonElement>("button[data-search-trigger]").forEach((button) => {
      if (button.dataset.bound) return;
      button.dataset.bound = "1";
      button.addEventListener("click", () => {
        document.dispatchEvent(new CustomEvent("flota:search-open"));
      });
    });
  }
  document.addEventListener("astro:page-load", bindSearchTrigger);
</script>
