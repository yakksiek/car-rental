---
// others
import { cn } from "../../lib/utils";

// Status head for the auth state cards (S-14, design `password-reset.jsx`
// `statusHead()`): a 56px tinted tile carrying a 27px glyph, left-aligned with
// the title. Every state card gets one — the three new screens (R11/R12/R13)
// shipped with it in Phases 1–2, and Phase 4 retrofitted R2/R4/R5 so the surface
// stays coherent (design-contract §7.1, deviation 1).
//
// Glyphs are inline SVG rather than lucide-react: this is an Astro component and
// the auth shell already hand-rolls its SVGs. Paths are transcribed verbatim from
// `lucide-react@1.14.0` so the set stays consistent with the React islands, and
// laid out as a `glyph === …` guard chain per the shell's NavIcon.astro — the
// project avoids `set:html`.
//
// The design uses its own icon set, so the mapping is an approximation confirmed
// against the mockups (design-contract §7.1) — `settings` is the crosshair-like
// mark in `auth-inapp-m.png`, which is lucide's `locate-fixed`, not a cog. The
// Phase 4 three were each confirmed against their artboard: `mail` envelope in
// `auth-sent-m.png`, green `shieldCheck` in `auth-success-m.png`, red `alert`
// triangle in `auth-expired-{d,m}.png`.
interface Props {
  tone: "ink" | "green" | "red";
  icon: "info" | "settings" | "user" | "mail" | "shieldCheck" | "alert";
  class?: string;
}

const { tone, icon, class: className } = Astro.props;

const TONES: Record<Props["tone"], string> = {
  ink: "bg-secondary text-[var(--flota-ink-2)]",
  green: "bg-[var(--flota-success-soft)] text-success",
  red: "bg-[var(--flota-danger-soft)] text-destructive",
};
---

<div class:list={cn("mb-5 flex size-14 items-center justify-center rounded-[16px]", TONES[tone], className)}>
  <svg
    class="size-[27px]"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    {
      icon === "info" && (
        <Fragment>
          <circle cx="12" cy="12" r="10" />
          <path d="M12 16v-4" />
          <path d="M12 8h.01" />
        </Fragment>
      )
    }
    {
      icon === "user" && (
        <Fragment>
          <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" />
          <circle cx="12" cy="7" r="4" />
        </Fragment>
      )
    }
    {
      icon === "settings" && (
        <Fragment>
          <line x1="2" x2="5" y1="12" y2="12" />
          <line x1="19" x2="22" y1="12" y2="12" />
          <line x1="12" x2="12" y1="2" y2="5" />
          <line x1="12" x2="12" y1="19" y2="22" />
          <circle cx="12" cy="12" r="7" />
          <circle cx="12" cy="12" r="3" />
        </Fragment>
      )
    }
    {
      icon === "mail" && (
        <Fragment>
          <path d="m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7" />
          <rect x="2" y="4" width="20" height="16" rx="2" />
        </Fragment>
      )
    }
    {
      icon === "shieldCheck" && (
        <Fragment>
          <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z" />
          <path d="m9 12 2 2 4-4" />
        </Fragment>
      )
    }
    {
      icon === "alert" && (
        <Fragment>
          <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3" />
          <path d="M12 9v4" />
          <path d="M12 17h.01" />
        </Fragment>
      )
    }
  </svg>
</div>
