---
// components
import ActionMenu from "./header/ActionMenu.tsx";
import LangToggle from "./header/LangToggle.tsx";
import Brand from "./brand/Brand.astro";

// others
import { cn } from "../lib/utils";

// Landing-scoped floating navigation (S1) — a FORK, not the shared <SiteHeader>.
// SiteHeader backs 5 public pages; the landing needs a different chrome that sits
// OVER the dark hero: a floating white pill on desktop, a glass bar on tablet, and
// a logo + glass controls on mobile. The mobile menu is a landing-local <details>
// dropdown (dark surface, 5 links + phone) — the shared <MobileNav.tsx> is
// deliberately untouched, so /fleet + the other public pages keep their own overlay.
//
// *** The design's ActionMenu collapse is ported here, not just to <SiteHeader>. ***
// Without it, adding <LangToggle> would have WIDENED a live bug. Measured 2026-09-01:
// the desktop pill is `grid-cols-[1fr_auto_1fr]`, so each side column is
// (pill − 36 padding − 393 nav) / 2 and the WIDER of the two ends sets the threshold.
// The right cluster needed 322px (CTA 154 + phone 148 + gap 20), reached only at
// vw ≥ 1136 — yet the phone was deferred to `xl` (1280), leaving 1024–1279 with NO
// phone affordance at all. Adding the toggle takes the cluster past 400px, which
// the column only reaches around vw ≥ 1310: a naive port would have stretched the
// dead band to 1024 up past 1300. Folding phone + CTA into <ActionMenu> below the threshold
// removes the band entirely — the number is always one tap away, at every width,
// which is a strictly better answer than the number simply not being there.
// Do NOT "fix" this by lowering the phone's breakpoint to `lg`: that overflows.
// Full write-up in `known-issues.md`; evidence PNGs in the change's `design-review/`.
//
// `leading-[normal]` on both pills' items is the design's own line-height — it sets
// no line-height, so its items inherit the UA `normal` (17.4px at 14.5px) while this
// app inherits 1.5 (21.75px), which grows each item 35px → 40px and the track 45 → 50.
// Verified against `design-review/design-landing-desktop-en.png`, rendered from
// `customer-desktop.jsx` itself. <SiteHeader>'s pill carries the same class, so the
// two public headers now agree with each other and with the design.
//
// Positioned `absolute` over the hero: the consuming <section> must be `relative`.

interface Props {
  active?: "home" | "fleet" | "pricing" | "faq" | "about";
}

const { active = "home" } = Astro.props;
const { locale } = Astro.locals;

// "Put me back where I was" after the switch; re-validated server-side.
const redirect = Astro.url.pathname + Astro.url.search;

const PHONE_LABEL = "+48 22 100 20 30";
const PHONE_HREF = "tel:+48221002030";

type NavId = "home" | "fleet" | "pricing" | "faq" | "about";

const nav: { id: NavId; label: string; href: string }[] = [
  { id: "home", label: "Start", href: "/" },
  { id: "fleet", label: "Flota", href: "/fleet" },
  { id: "pricing", label: "Cennik", href: "/pricing" },
  { id: "faq", label: "FAQ", href: "/faq" },
  { id: "about", label: "O nas", href: "/about" },
];
---

<div class="pointer-events-none absolute inset-x-0 top-0 z-40">
  <!-- Desktop: floating white pill (≥lg). Marked `@container` so the collapse is
       driven by the PILL's own width, not the viewport — the project's
       embeddable-panels lesson, and what the design's own reflow uses. -->
  <div
    class="@container pointer-events-auto absolute top-7 right-8 left-8 hidden grid-cols-[1fr_auto_1fr] items-center rounded-full bg-white py-[11px] pr-[22px] pl-[14px] [box-shadow:0_12px_34px_-10px_rgba(0,0,0,0.25)] lg:grid"
  >
    <a href="/" class="flex items-center justify-self-start">
      <Brand markClass="h-[20px]" wordmarkClass="text-[20px]" />
    </a>

    <nav class="bg-background flex items-center gap-1 justify-self-center rounded-full px-1.5 py-[5px]">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={cn(
              "rounded-full px-[18px] py-[9px] text-[14.5px] leading-[normal] whitespace-nowrap transition-colors",
              active === item.id
                ? "text-foreground bg-white font-semibold [box-shadow:0_2px_6px_rgba(14,21,36,0.15)]"
                : "hover:text-foreground font-medium text-[var(--flota-ink-2)]",
            )}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-5 justify-self-end">
      <LangToggle client:idle locale={locale} redirect={redirect} />

      {
        /* The threshold, derived from measurement rather than guessed. A container
           query resolves against the container's CONTENT box, which here is the
           grid's `1fr auto 1fr` track space: it must hold the 393px nav plus TWICE
           the right cluster, because `1fr` side columns are symmetric and the wider
           end sets the width. Expanded the cluster measures 402px
           (LangToggle 61 + 20 + phone 149 + 20 + CTA 152), so 393 + 2×402 = 1197;
           rounded to 1208 for font-rendering slack, since a `1fr` column cannot
           shrink below its nowrap min-content and would push the grid out of the
           pill instead of clipping. Below it the phone and the CTA fold into
           <ActionMenu> together, exactly as the design's
           `@container (max-width:980px)` rule does for <SiteHeader>. */
      }
      <a
        href={PHONE_HREF}
        class="text-foreground hidden items-center gap-2 text-[14.5px] font-bold whitespace-nowrap @min-[1208px]:flex"
      >
        <svg
          class="text-primary size-[15px]"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.9"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path
            d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"
          ></path>
        </svg>
        {PHONE_LABEL}
      </a>
      <a
        href="/fleet"
        class="text-background hidden rounded-full bg-[var(--flota-ink-deep)] px-[22px] py-[13px] text-[14.5px] font-semibold whitespace-nowrap transition hover:opacity-90 @min-[1208px]:block"
      >
        Przeglądaj flotę
      </a>
      <div class="@min-[1208px]:hidden">
        <ActionMenu client:idle />
      </div>
    </div>
  </div>

  <!-- Tablet band (md–<lg): over-hero glass bar, ported from the design's
       `ScreenTabletHome` — brand · 4-item pill · LangToggle + ActionMenu, spaced apart.
       Matches the design's 4-item pill (Start / Flota / Cennik / FAQ — "O nas" stays
       reachable via footer + pages). The old glass phone/book toggle is replaced by the
       same LangToggle + ActionMenu pair: at 768px the 4-item nav plus that toggle plus
       the switcher left under 30px of slack, which is exactly the margin that produced
       the header bugs this phase deletes. -->
  <div
    class="pointer-events-auto absolute top-[22px] right-7 left-7 hidden grid-cols-[1fr_auto_1fr] items-center md:grid lg:hidden"
  >
    <a href="/" class="flex items-center justify-self-start">
      <Brand tone="inverse" markClass="h-[19px]" wordmarkClass="text-[21px]" />
    </a>

    {
      /* THREE direct children — brand, pill, controls — which is how the design's
         `ScreenTabletHome` header row is built. Do NOT wrap the pill and the controls
         in a shared group: that makes the bar two children, glues the pill to the right
         edge, and throws its centre +63px off at 768 and +191px at 1023 (the state this
         replaced). `shrink-0` on the controls is the design's own `flexShrink: 0`.

         `deviation(true centre)`: the design uses `space-between`, which with unequal
         flanks (brand 98 vs controls 132) leaves the pill 17px left of centre at every
         width. The desktop pill above is `grid-cols-[1fr_auto_1fr]` — a pre-existing
         app choice that centres it exactly — so `space-between` here would shift the
         pill 17px on crossing `lg`. Same grid, same centre, no jump. It fits with room
         to spare: 2×132 + 298 = 562 of 712 usable at 768. */
    }
    <nav class="flex items-center gap-1.5 rounded-full bg-white/[0.12] px-1.5 py-[5px] backdrop-blur-[6px]">
      {
        nav.slice(0, 4).map((item) => (
          <a
            href={item.href}
            class:list={cn(
              "rounded-full px-4 py-[9px] text-[14px] leading-[normal] whitespace-nowrap transition-colors",
              active === item.id
                ? "bg-white/[0.92] font-[650] text-[#0E1524]"
                : "font-medium text-white/[0.86] hover:text-white",
            )}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex shrink-0 items-center gap-2 justify-self-end">
      <LangToggle client:idle locale={locale} redirect={redirect} tone="dark" />
      <ActionMenu client:idle tone="dark" />
    </div>
  </div>

  <!-- Mobile: logo + glass switcher/action pair + hamburger over the photo (<md).
       Mirrors <SiteHeader>'s mobile cluster so the two public headers behave
       identically; the CSS-only phone-reveal chip it replaces is now ActionMenu's
       first row. -->
  <div class="pointer-events-auto absolute inset-x-4 top-4 flex items-center justify-between md:hidden">
    <a href="/" class="flex items-center">
      <Brand tone="inverse" markClass="h-[18px]" wordmarkClass="text-[19px]" />
    </a>

    <div class="flex items-center gap-2">
      <LangToggle client:idle locale={locale} redirect={redirect} tone="dark" />
      <ActionMenu client:idle tone="dark" />

      <details class="group relative">
        <summary
          aria-label="Menu"
          class="flex size-10 list-none items-center justify-center rounded-[12px] bg-white/15 backdrop-blur-[6px] select-none [&::-webkit-details-marker]:hidden"
        >
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            class="text-white"
            aria-hidden="true"
          >
            <path d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
        </summary>
        <div
          class="absolute right-0 mt-2 w-56 rounded-2xl border border-white/10 bg-[#0A0D14]/95 p-2 [box-shadow:0_18px_40px_-12px_rgba(0,0,0,0.6)] backdrop-blur-md"
        >
          {
            nav.map((item) => (
              <a
                href={item.href}
                class:list={cn(
                  "block rounded-xl px-4 py-3 text-[15px] font-semibold transition-colors",
                  active === item.id ? "bg-white/10 text-white" : "text-white/70 hover:bg-white/5 hover:text-white",
                )}
              >
                {item.label}
              </a>
            ))
          }
          <a
            href={PHONE_HREF}
            class="mt-1 flex items-center gap-2 rounded-xl px-4 py-3 text-[15px] font-semibold text-white/70 transition-colors hover:bg-white/5 hover:text-white"
          >
            <svg
              class="text-primary size-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.9"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path
                d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"
              ></path>
            </svg>
            {PHONE_LABEL}
          </a>
        </div>
      </details>
    </div>
  </div>
</div>
