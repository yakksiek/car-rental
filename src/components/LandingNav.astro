---
// components
import Brand from "./brand/Brand.astro";

// others
import { cn } from "../lib/utils";

// Landing-scoped floating navigation (S1) — a FORK, not the shared <SiteHeader>.
// SiteHeader backs 5 public pages; the landing needs a different chrome that sits
// OVER the dark hero: a floating white pill on desktop/tablet, a logo + glass
// phone-reveal + hamburger on mobile. The mobile menu is a landing-local <details>
// dropdown (dark surface, 5 links + phone) — the shared <MobileNav.tsx> is deliberately
// untouched, so /fleet + the other public pages keep their existing light menu.
//
// Nav parity (S-09 P7): lists all 5 destinations like the shell (Start / Flota / Cennik
// / FAQ / O nas), per `customer-desktop.jsx` DesktopHeader/LandingNav. The full pill
// shows from `lg` (tablet+); below it, the mobile row carries the dark-glass phone-reveal
// call chip (ported from `ScreenMobileHome`, CSS-only). The pill's phone text-block only
// appears at `xl` so the tablet pill (lg–xl) never overflows — the 5-link nav + logo +
// CTA fit, but nav + phone + CTA together do not (no tablet mock; phone lives in the
// mobile reveal below lg and the CTA carries the tablet band).
//
// Positioned `absolute` over the hero: the consuming <section> must be `relative`.

interface Props {
  active?: "home" | "fleet" | "pricing" | "faq" | "about";
}

const { active = "home" } = Astro.props;

const PHONE_LABEL = "+48 22 100 20 30";
const PHONE_HREF = "tel:+48221002030";

type NavId = "home" | "fleet" | "pricing" | "faq" | "about";

const nav: { id: NavId; label: string; href: string }[] = [
  { id: "home", label: "Start", href: "/" },
  { id: "fleet", label: "Flota", href: "/fleet" },
  { id: "pricing", label: "Cennik", href: "/pricing" },
  { id: "faq", label: "FAQ", href: "/faq" },
  { id: "about", label: "O nas", href: "/about" },
];
---

<div class="pointer-events-none absolute inset-x-0 top-0 z-40">
  <!-- Desktop/tablet: floating white pill (≥lg). -->
  <div
    class="pointer-events-auto absolute top-7 right-8 left-8 hidden grid-cols-[1fr_auto_1fr] items-center rounded-full bg-white py-[11px] pr-[22px] pl-[14px] [box-shadow:0_12px_34px_-10px_rgba(0,0,0,0.25)] lg:grid"
  >
    <a href="/" class="flex items-center justify-self-start">
      <Brand markClass="h-[20px]" wordmarkClass="text-[20px]" />
    </a>

    <nav class="bg-background flex items-center gap-1 justify-self-center rounded-full px-1.5 py-[5px]">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={cn(
              "rounded-full px-[18px] py-[9px] text-[14.5px] transition-colors",
              active === item.id
                ? "text-foreground bg-white font-semibold [box-shadow:0_2px_6px_rgba(14,21,36,0.15)]"
                : "hover:text-foreground font-medium text-[var(--flota-ink-2)]",
            )}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-5 justify-self-end">
      <!-- Phone text-block: xl+ only (keeps the tablet pill from overflowing). -->
      <a href={PHONE_HREF} class="text-foreground hidden items-center gap-2 text-[14.5px] font-bold xl:flex">
        <svg
          class="text-primary size-[15px]"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.9"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path
            d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"
          ></path>
        </svg>
        {PHONE_LABEL}
      </a>
      <a
        href="/fleet"
        class="text-background rounded-full bg-[var(--flota-ink-deep)] px-[22px] py-[13px] text-[14.5px] font-semibold transition hover:opacity-90"
      >
        Przeglądaj flotę
      </a>
    </div>
  </div>

  <!-- Tablet band (md–<lg): over-hero glass pill + glass phone/book toggle (design
       ScreenTabletHome). The white pill takes over at lg+. Matches the design's 4-item
       pill (Start / Flota / Cennik / FAQ — "O nas" stays reachable via footer + pages).
       The toggle renders its default state (book active) as two direct links; no reveal
       animation is needed here (the phone icon is itself a tel: link). -->
  <div
    class="pointer-events-auto absolute top-[22px] right-7 left-7 hidden items-center justify-between md:flex lg:hidden"
  >
    <a href="/" class="flex items-center">
      <Brand tone="inverse" markClass="h-[19px]" wordmarkClass="text-[21px]" />
    </a>

    <div class="flex items-center gap-3">
      <nav class="flex items-center gap-1.5 rounded-full bg-white/[0.12] px-1.5 py-[5px] backdrop-blur-[6px]">
        {
          nav.slice(0, 4).map((item) => (
            <a
              href={item.href}
              class:list={cn(
                "rounded-full px-4 py-[9px] text-[14px] whitespace-nowrap transition-colors",
                active === item.id
                  ? "bg-white/[0.92] font-[650] text-[#0E1524]"
                  : "font-medium text-white/[0.86] hover:text-white",
              )}
            >
              {item.label}
            </a>
          ))
        }
      </nav>

      <div class="inline-flex items-center gap-1 rounded-full bg-white/[0.14] p-1 backdrop-blur-[6px]">
        <a
          href={PHONE_HREF}
          aria-label={`Zadzwoń: ${PHONE_LABEL}`}
          class="flex size-[38px] items-center justify-center rounded-full text-white"
        >
          <svg
            width="17"
            height="17"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path
              d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"
            ></path>
          </svg>
        </a>
        <a
          href="/fleet"
          class="bg-primary flex h-[38px] items-center gap-2 rounded-full px-[15px] text-[14px] font-[650] text-white"
        >
          <svg
            width="17"
            height="17"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect x="3" y="5" width="18" height="16" rx="2"></rect>
            <path d="M3 10h18M8 3v4M16 3v4"></path>
          </svg>
          Zarezerwuj
        </a>
      </div>
    </div>
  </div>

  <!-- Mobile: logo + glass phone-reveal + hamburger over the photo (<md). -->
  <div class="pointer-events-auto absolute inset-x-4 top-4 flex items-center justify-between md:hidden">
    <a href="/" class="flex items-center">
      <Brand tone="inverse" markClass="h-[18px]" wordmarkClass="text-[19px]" />
    </a>

    <div class="flex items-center gap-[10px]">
      <!-- Phone-reveal call chip (dark-hero glass variant, CSS-only via peer checkbox).
           Closed: 40×40 pill; checked: expands to reveal the number as a real tel link. -->
      <div class="flex h-10 items-center overflow-hidden rounded-full bg-white/15 backdrop-blur-[6px]">
        <input type="checkbox" id="landing-phone-reveal" class="peer sr-only" />
        <label
          for="landing-phone-reveal"
          aria-label="Pokaż numer telefonu"
          class="flex size-10 shrink-0 cursor-pointer items-center justify-center select-none"
        >
          <svg
            width="17"
            height="17"
            viewBox="0 0 24 24"
            fill="none"
            stroke="#fff"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path
              d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"
            ></path>
          </svg>
        </label>
        <a href={PHONE_HREF} class="phone-num block overflow-hidden text-[14px] font-bold whitespace-nowrap text-white">
          {PHONE_LABEL}
        </a>
      </div>

      <details class="group relative">
        <summary
          aria-label="Menu"
          class="flex size-10 list-none items-center justify-center rounded-[12px] bg-white/15 backdrop-blur-[6px] select-none [&::-webkit-details-marker]:hidden"
        >
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            class="text-white"
            aria-hidden="true"
          >
            <path d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
        </summary>
        <div
          class="absolute right-0 mt-2 w-56 rounded-2xl border border-white/10 bg-[#0A0D14]/95 p-2 [box-shadow:0_18px_40px_-12px_rgba(0,0,0,0.6)] backdrop-blur-md"
        >
          {
            nav.map((item) => (
              <a
                href={item.href}
                class:list={cn(
                  "block rounded-xl px-4 py-3 text-[15px] font-semibold transition-colors",
                  active === item.id ? "bg-white/10 text-white" : "text-white/70 hover:bg-white/5 hover:text-white",
                )}
              >
                {item.label}
              </a>
            ))
          }
          <a
            href={PHONE_HREF}
            class="mt-1 flex items-center gap-2 rounded-xl px-4 py-3 text-[15px] font-semibold text-white/70 transition-colors hover:bg-white/5 hover:text-white"
          >
            <svg
              class="text-primary size-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.9"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path
                d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"
              ></path>
            </svg>
            {PHONE_LABEL}
          </a>
        </div>
      </details>
    </div>
  </div>
</div>

<style>
  /* Phone-reveal (dark-hero glass variant) — CSS-only width/opacity expand, ported
     from customer-desktop.jsx ScreenMobileHome. The checkbox toggles the number's
     reveal; timings match the source (max-width .4s, opacity .28s, padding .4s). */
  .phone-num {
    max-width: 0;
    padding-right: 0;
    opacity: 0;
    transition:
      max-width 0.4s cubic-bezier(0.4, 0, 0.2, 1),
      opacity 0.28s ease,
      padding 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }
  #landing-phone-reveal:checked ~ .phone-num {
    max-width: 160px;
    padding-right: 14px;
    opacity: 1;
  }
</style>
