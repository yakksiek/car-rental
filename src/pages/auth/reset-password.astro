---
import AuthShell from "../../components/auth/AuthShell.astro";
import AccountBox from "../../components/auth/AccountBox.astro";
import AuthBackLink from "../../components/auth/AuthBackLink.astro";
import AuthPrimaryLink from "../../components/auth/AuthPrimaryLink.astro";
import StatusHead from "../../components/auth/StatusHead.astro";
import ResetPasswordForm from "../../components/auth/ResetPasswordForm";
import { LINK_ORIGIN_COOKIE, PW_SET_DONE_COOKIE, readLinkOrigin, readSessionOrigin } from "../../lib/auth-session";
import { resolveAuthError } from "../../lib/auth-messages";

// Set-password surface (S-08, restated in S-14). The page used to render on the
// sole condition that *a* session existed, so it showed the form to any signed-in
// staffer and told a cold visitor their link had expired — a history that never
// happened. It now branches in this exact order:
//
//   1. done cookie  → R4 success — the marker a successful POST swapped in
//   2. no session   → R13 "Nie ma tu nic do ustawienia"
//   3. not a link   → R12 "Zmień hasło w ustawieniach" (send them to the account screen)
//   4. no marker    → R5  "Link wygasł" — now semantically true: the link was spent
//   5. otherwise    → the form, in recovery (R3/R9) or invite (R6/R10) mode
//
// The page's refusals mirror the route's gate (src/pages/api/auth/reset-password.ts)
// so a rejection is explained here rather than surfacing as a bare 403.
const user = Astro.locals.user;
const supabase = Astro.locals.supabase;

// `?error=` carries a short code, never a sentence (S-14, F6) — an unrecognised
// one resolves to null and renders no alert.
const error = resolveAuthError("resetPassword", Astro.url.searchParams.get("error"));

// One-shot: consumed as it renders, so a reload or a typed URL cannot replay the
// success card. This replaces the old `?done=1` read, which anyone could forge.
const done = Astro.cookies.has(PW_SET_DONE_COOKIE);
if (done) {
  Astro.cookies.delete(PW_SET_DONE_COOKIE, { path: "/" });
}

// Only meaningful with a session; `readSessionOrigin` fails closed anyway.
const origin = user && supabase ? await readSessionOrigin(supabase) : "unknown";

// `mode` comes from the marker cookie the callback stamped — NOT from the query
// string, which any link can set.
const mode = readLinkOrigin(Astro.cookies.get(LINK_ORIGIN_COOKIE)?.value);

const metadata = user?.user_metadata as { full_name?: unknown } | undefined;
const fullName = typeof metadata?.full_name === "string" ? metadata.full_name : null;
---

<AuthShell pageTitle="Strefa pracownika — ustaw hasło">
  {
    done ? (
      <div class="flex flex-col gap-[18px]">
        <div>
          <StatusHead tone="green" icon="shieldCheck" />
          <h1 class="text-foreground text-[28px] leading-[1.05] font-bold tracking-[-0.8px]">Hasło zaktualizowane</h1>
          <p class="text-muted-foreground mt-2 text-sm leading-[1.45]">Możesz teraz zalogować się nowym hasłem.</p>
        </div>
        <AuthPrimaryLink href="/auth/signin">Przejdź do logowania</AuthPrimaryLink>
      </div>
    ) : !user ? (
      <div class="flex flex-col gap-[18px]">
        <div>
          <StatusHead tone="ink" icon="info" />
          <h1 class="text-foreground text-[28px] leading-[1.05] font-bold tracking-[-0.8px]">
            Nie ma tu nic do ustawienia
          </h1>
          <p class="text-muted-foreground mt-2 text-sm leading-[1.45]">
            Aby ustawić hasło, potrzebujesz linku do resetu. Poproś o niego, a wyślemy go e-mailem.
          </p>
        </div>
        <AuthPrimaryLink href="/auth/forgot-password">Poproś o link do resetu</AuthPrimaryLink>
        <AuthBackLink />
      </div>
    ) : origin !== "link" ? (
      <div class="flex flex-col gap-[18px]">
        <div>
          <StatusHead tone="ink" icon="settings" />
          <h1 class="text-foreground text-[28px] leading-[1.05] font-bold tracking-[-0.8px]">
            Zmień hasło w ustawieniach
          </h1>
          <p class="text-muted-foreground mt-2 text-sm leading-[1.45]">
            Ta sesja jest aktywna, więc nie ma tu linku do resetu. Otwórz Konto → „Zmień hasło” — najpierw potwierdzisz
            obecne hasło.
          </p>
        </div>
        <div>
          <AccountBox label="Zalogowano jako" email={user.email ?? ""} fullName={fullName} class="mb-5" />
          <AuthPrimaryLink href="/dashboard/account/password">Przejdź do ustawień konta</AuthPrimaryLink>
        </div>
      </div>
    ) : !mode ? (
      <div class="flex flex-col gap-[18px]">
        <div>
          <StatusHead tone="red" icon="alert" />
          <h1 class="text-foreground text-[28px] leading-[1.05] font-bold tracking-[-0.8px]">Link wygasł</h1>
          <p class="text-muted-foreground mt-2 text-sm leading-[1.45]">
            Linki resetujące są ważne 60 minut. Poproś o nowy, aby kontynuować.
          </p>
        </div>
        <AuthPrimaryLink href="/auth/forgot-password">Poproś o nowy link</AuthPrimaryLink>
        <AuthBackLink />
      </div>
    ) : (
      // The account box names the address whose password is about to change. It is
      // slotted in rather than passed as a prop so R3/R9 and R6/R10 share the one
      // AccountBox.astro with R11/R12 instead of growing a React copy of it
      // (design-contract §7.2, §8.4). Astro renders slotted children to static HTML
      // before the island hydrates, which is all this needs to be.
      <ResetPasswordForm mode={mode} serverError={error} client:load>
        <AccountBox label="Ustawiasz hasło dla" email={user.email ?? ""} fullName={fullName} />
      </ResetPasswordForm>
    )
  }
</AuthShell>
