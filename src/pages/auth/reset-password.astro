---
// components
import AuthShell from "../../components/auth/AuthShell.astro";
import AccountBox from "../../components/auth/AccountBox.astro";
import AuthBackLink from "../../components/auth/AuthBackLink.astro";
import AuthPrimaryLink from "../../components/auth/AuthPrimaryLink.astro";
import StatusHead from "../../components/auth/StatusHead.astro";
import ResetPasswordForm from "../../components/auth/ResetPasswordForm";

// others
import {
  LINK_ORIGIN_COOKIE,
  PW_SET_DONE_COOKIE,
  linkOriginOf,
  readPendingToken,
  resolveLinkTarget,
  selectResetPasswordBranch,
} from "../../lib/auth-session";
import { resolveAuthError } from "../../lib/auth-messages";

// Set-password surface (S-08, restated in S-14, re-sourced by invite-journey-fixes).
// The page used to render on the sole condition that *a* session existed, so it
// showed the form to any signed-in staffer and told a cold visitor their link had
// expired — a history that never happened. It branches in this exact order:
//
//   1. done cookie   → R4  success — the marker a successful POST swapped in
//   2. no token, no session → R13 `auth.noLinkTitle`
//   3. token target has no role → R14 `auth.inactiveTitle`
//   4. no token, but a session → R12 `auth.inAppTitle`
//   5. token that no longer resolves → R5 `auth.expiredTitle`
//   6. otherwise → the form, in recovery (R3/R9) or invite (R6/R10) mode
//
// WHAT CHANGED, and what did NOT: the exchange no longer happens on the callback
// GET, so there is no `Astro.locals.user` on the link path and no `amr` claim to
// classify. Identity, name and role now come from `resolve_link_token`, which
// reads them WITHOUT spending the token. Every screen, its copy and its metrics
// are unchanged — design-contract §8.2 asserts parity, not a new surface.
//
// ⚠ Branches 2 and 4 partition the "no pending token" case BY WHETHER A SESSION
// EXISTS. "No token" alone is NOT a drop-in for the old "no session": collapsing
// them would swallow branch 4's whole population — a signed-in staffer who typed
// the URL — and take R12's block dead with it, including its AccountBox. The
// decision is a pure function (`selectResetPasswordBranch`) with unit tests,
// because an `.astro`-only edit runs no test at all (research §4).
const user = Astro.locals.user;
const supabase = Astro.locals.supabase;
const { locale, t } = Astro.locals;

// `?error=` carries a short code, never a sentence (S-14, F6) — an unrecognised
// one resolves to null and renders no alert.
const error = resolveAuthError("resetPassword", Astro.url.searchParams.get("error"), locale);

// One-shot: consumed as it renders, so a reload or a typed URL cannot replay the
// success card. This replaces the old `?done=1` read, which was forgeable by
// anyone *linking* to it. The cookie is still writable by the visitor's own
// devtools — `httpOnly` blocks scripts, not the user — but that is self-inflicted
// and grants nothing: this branch only renders a static card.
const done = Astro.cookies.has(PW_SET_DONE_COOKIE);
if (done) {
  Astro.cookies.delete(PW_SET_DONE_COOKIE, { path: "/" });
}

// The cookie now carries `token_hash` + `type` rather than a bare marker. Its
// PRESENCE is still unforgeable by URL — only a resolved link stamps it — and its
// VALUE is now the credential itself, re-checked against GoTrue on every render.
const pendingToken = done ? null : readPendingToken(Astro.cookies.get(LINK_ORIGIN_COOKIE)?.value);

// Lookup only — repeating it on every render is exactly why reopening the link
// works. A null target means the link is dead; a null role means R14.
const target = pendingToken && supabase ? await resolveLinkTarget(supabase, pendingToken) : null;

const branch = selectResetPasswordBranch({ done, hasSession: Boolean(user), pendingToken, target });

// `mode` comes from the token cookie, never from the query string: `?mode=invite`
// on this page's own URL is ignored. Its value is the `type` the lookup matched
// the hash against (resolve_link_token clause 1), so a recovery link cannot be
// dressed up as an invite (auth-followups, F3).
const mode = pendingToken ? linkOriginOf(pendingToken.type) : "recovery";

// R14 and the form name the LINK'S TARGET, from the lookup. `full_name` must come
// from `profiles` here, not from `user.user_metadata`: on the link path there is
// no user, and falling back would silently downgrade the initials avatar to an
// email-derived one on the invite form — the exact screen this change exists to fix.
// (`services/staff.ts` writes the profile name and the metadata copy together at
// invite time, so it is the same name.)
const linkEmail = target?.email ?? "";
const linkFullName = target?.fullName ?? null;

// R12 is the one branch with no token, so it has no lookup to read from: its
// AccountBox names the SESSION that is in the way (`auth.signedInAs`), which is a
// different subject from the link's target.
const sessionMetadata = user?.user_metadata as { full_name?: unknown } | undefined;
const sessionFullName = typeof sessionMetadata?.full_name === "string" ? sessionMetadata.full_name : null;
---

<AuthShell pageTitle={t("auth.titleSetPassword")}>
  {
    branch === "done" ? (
      <div class="flex flex-col gap-[18px]">
        <div>
          <StatusHead tone="green" icon="shieldCheck" />
          <h1 class="text-foreground text-[28px] leading-[1.05] font-bold tracking-[-0.8px]">{t("auth.doneTitle")}</h1>
          <p class="text-muted-foreground mt-2 text-sm leading-[1.45]">{t("auth.doneSub")}</p>
        </div>
        <AuthPrimaryLink href="/auth/signin">{t("auth.doneCta")}</AuthPrimaryLink>
      </div>
    ) : branch === "nothing-to-set" ? (
      <div class="flex flex-col gap-[18px]">
        <div>
          <StatusHead tone="ink" icon="info" />
          <h1 class="text-foreground text-[28px] leading-[1.05] font-bold tracking-[-0.8px]">
            {t("auth.noLinkTitle")}
          </h1>
          <p class="text-muted-foreground mt-2 text-sm leading-[1.45]">{t("auth.noLinkSub")}</p>
        </div>
        <AuthPrimaryLink href="/auth/forgot-password">{t("auth.noLinkCta")}</AuthPrimaryLink>
        <AuthBackLink />
      </div>
    ) : branch === "inactive-account" ? (
      <div class="flex flex-col gap-[18px]">
        <div>
          <StatusHead tone="ink" icon="user" />
          <h1 class="text-foreground text-[28px] leading-[1.05] font-bold tracking-[-0.8px]">
            {t("auth.inactiveTitle")}
          </h1>
          <p class="text-muted-foreground mt-2 text-sm leading-[1.45]">{t("auth.inactiveSub")}</p>
        </div>
        {/* No AuthBackLink: this card's own CTA already goes to /auth/signin, and
            two controls with the same destination are just noise — the same call
            the R4 success card above and dashboard/account/password.astro make.
            The cards that DO carry the back link (R5, R13) send their CTA to
            /auth/forgot-password, so theirs offers a second destination. */}
        <AuthPrimaryLink href="/auth/signin">{t("auth.inactiveCta")}</AuthPrimaryLink>
      </div>
    ) : branch === "in-app" ? (
      <div class="flex flex-col gap-[18px]">
        <div>
          <StatusHead tone="ink" icon="settings" />
          <h1 class="text-foreground text-[28px] leading-[1.05] font-bold tracking-[-0.8px]">{t("auth.inAppTitle")}</h1>
          <p class="text-muted-foreground mt-2 text-sm leading-[1.45]">{t("auth.inAppSub")}</p>
        </div>
        <div>
          <AccountBox label={t("auth.signedInAs")} email={user?.email ?? ""} fullName={sessionFullName} class="mb-5" />
          <AuthPrimaryLink href="/dashboard/account/password">{t("auth.inAppCta")}</AuthPrimaryLink>
        </div>
      </div>
    ) : branch === "expired" ? (
      <div class="flex flex-col gap-[18px]">
        <div>
          <StatusHead tone="red" icon="alert" />
          <h1 class="text-foreground text-[28px] leading-[1.05] font-bold tracking-[-0.8px]">
            {t("auth.expiredTitle")}
          </h1>
          <p class="text-muted-foreground mt-2 text-sm leading-[1.45]">{t("auth.expiredSub")}</p>
        </div>
        <AuthPrimaryLink href="/auth/forgot-password">{t("auth.expiredCta")}</AuthPrimaryLink>
        <AuthBackLink />
      </div>
    ) : (
      // The account box names the address whose password is about to change. It is
      // slotted in rather than passed as a prop so R3/R9 and R6/R10 share the one
      // AccountBox.astro with R11/R12 instead of growing a React copy of it
      // (design-contract §7.2, §8.4). Astro renders slotted children to static HTML
      // before the island hydrates, which is all this needs to be.
      <ResetPasswordForm mode={mode} serverError={error} locale={locale} client:load>
        {/* Username anchor — the only thing that lets a password manager attribute
            the password typed below to THIS link's target. With no username in the
            submitted form, Chrome falls back to whichever credential it already
            holds for this origin (the admin who sent the invite) and offers to
            *update* that one, silently corrupting it.

            Three attributes look removable and are not:
            • `type="text"`, NEVER `type="hidden"` — Chrome, Firefox and WebKit all
              refuse to parse a hidden input as a username. `class="hidden"`
              (display:none) is what hides it; the type must stay text.
            • no `name` — deliberate. It is therefore never submitted, so it cannot
              reach /api/auth/reset-password nor be tampered into it.
            • it must sit BEFORE both password fields — Firefox only searches
              fields preceding the first one. `{children}` renders above the
              password group (ResetPasswordForm.tsx:77), which satisfies that.

            Guarded on a non-empty address because Chrome drops empty-valued fields
            while saving, which would defeat the fix with no visible symptom. */}
        {linkEmail && (
          <input type="text" id="username" value={linkEmail} autocomplete="username" readonly class="hidden" />
        )}
        <AccountBox label={t("auth.settingPasswordFor")} email={linkEmail} fullName={linkFullName} />
      </ResetPasswordForm>
    )
  }
</AuthShell>
