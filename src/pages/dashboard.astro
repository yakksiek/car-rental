---
// components
import Layout from "../layouts/Layout.astro";
import StaffShell from "../components/shell/StaffShell.astro";
import NavIcon from "../components/shell/NavIcon.astro";
import DispatchBoard from "../components/dashboard/DispatchBoard";
import QuickAddButton from "../components/dashboard/QuickAddButton";

// others
import { countOverdueReturns, listDispatchToday, listReturnsToday } from "../lib/services/protocols";
import { listPendingReservations } from "../lib/services/reservations";
import { staffIdentity } from "../lib/staff-identity";
import { dayCounts, parseSection, scheduleGroups } from "../lib/dispatch-board";
import { dateEyebrow } from "../lib/format-date";

// The staff pulpit — the dispatch cockpit. Everything the board renders is fetched
// here in one server-side `Promise.all` (no client fetching): today's dispatch and
// return worklists (mirroring `pickups.astro` / `returns.astro`), the pending
// requests that feed both the shell badge and the Need-a-decision rail, and the
// overdue count the urgency card shows.
//
// `today` is the server's UTC calendar date, matching the DB's `current_date`
// (Supabase runs UTC), so the overdue split the board paints agrees with the
// `return_date <= current_date` filter the RPC applied.
const { user, role, supabase, locale, t } = Astro.locals;

const [pending, overdueCount, pickupRows, returnRows] = await Promise.all([
  listPendingReservations(supabase),
  countOverdueReturns(supabase),
  listDispatchToday(supabase),
  listReturnsToday(supabase),
]);

const now = new Date();
const today = now.toISOString().slice(0, 10);

const counts = dayCounts(pickupRows, returnRows, pending, overdueCount);
const groups = scheduleGroups(pickupRows, returnRows, today, locale);

const { initials, displayName } = staffIdentity(user?.email, role, locale);
// The greeting is deliberately STATIC ("Dzień dobry" / "Good morning"), not
// time-of-day derived: the server runs UTC while the depot lives in
// Europe/Warsaw, so an hour-based greeting would read wrong for up to two hours
// a day (design-contract deviation 3).
const firstName = displayName.split(" ")[0];

// Mobile header eyebrow — `PT · 25 LIPCA` / `SAT · 25 JULY`, from `Intl` on the
// same UTC calendar the `today` split uses.
const eyebrow = dateEyebrow(now, locale);

// Parse `?section` server-side and hand the island a typed initial value, so a
// deep-link (e.g. `?section=wydania`) renders pre-filtered with no client-only read
// → no hydration flash. Junk validates away to `wszystko` (all sections).
const initialSection = parseSection(Astro.url.searchParams.get("section"));

// Pulpit is the app's ONLY search entry point, so it is also where ⌘K lands when it
// is pressed at desktop width on a page that renders no field. `?search=1` is that
// hand-off; the island opens on mount and strips the parameter from the URL.
const autoOpenSearch = Astro.url.searchParams.get("search") === "1";
---

<Layout title={`${t("staff.navDash")} — Flota`}>
  <StaffShell
    active="dash"
    title={`${t("staff.greeting")}, ${firstName}`}
    subtitle={t("staff.dashSubtitle")}
    user={user}
    role={role}
    pendingCount={pending.length}
    overdueCount={overdueCount}
    search
    autoOpen={autoOpenSearch}
  >
    {
      /* The greeting rides the shell's own band since S-12b — it reproduced that
        band unit for unit, so keeping a hand-rolled copy would have meant two
        right edges once the quick-add pill landed. The calendar button keeps its
        place, now as the page's contribution to the band's action cluster, at the
        design's gap 12 — between the search field the shell draws first and the
        quick-add pill it draws last, which is `StaffTopbar`'s own
        field → calendar → QuickAdd order (design-contract §A + D7).
        `shrink-0` because the cluster now also holds a 520px field: without it
        flexbox squeezes this 38px square at tablet widths. */
    }
    <a
      slot="header-actions"
      href="/dashboard/calendar"
      aria-label={t("staff.navCalendar")}
      class="border-border bg-card flex size-[38px] shrink-0 items-center justify-center rounded-[10px] border text-[var(--flota-ink-2)]"
    >
      <NavIcon glyph="calendar" size={16} />
    </a>

    <main class="mx-auto w-full max-w-[1440px] px-4 py-6 lg:p-8">
      {
        /* Mobile hero — date eyebrow, title, and the three-item action cluster the
          design draws on the right (see the comment on that cluster below). */
      }
      <header class="flex items-start justify-between gap-4 md:hidden">
        <div class="min-w-0">
          <p class="text-muted-foreground text-[12px] font-semibold tracking-[0.3px] uppercase">{eyebrow}</p>
          <h1 class="text-foreground mt-1 text-[40px] leading-none font-bold tracking-[-1px]">
            {t("staff.navDash")}
          </h1>
        </div>
        {
          /* The hero's action cluster — magnifier → quick-add → avatar at 44 / 40 / 44,
            gap 10, exactly as `ScreenWorkerDash` now draws it (mock updated 2026-08-26,
            which retires D8's `deviation(reach)`: the design draws all three itself).
            At the 360px floor the cluster is 44+10+40+10+44 = 148px, leaving ~190px
            for the 40px `Pulpit` h1.

            The magnifier is the app's ONLY mobile search entry (the floating tab bar
            deliberately has none): a scoped icon in a section header would read as
            "search this section". It carries `data-search-trigger`, which StaffShell's
            binder wires to the island's `flota:search-open` event. */
        }
        <div class="flex shrink-0 items-center gap-2.5">
          <button
            type="button"
            data-search-trigger
            aria-label={t("staff.search")}
            class="bg-card text-foreground shadow-card flex size-11 items-center justify-center rounded-full border border-[var(--flota-hair)] p-0"
          >
            <NavIcon glyph="search" size={19} />
          </button>
          <QuickAddButton client:load mode="mobile" locale={locale} />
          <span
            class="bg-primary text-primary-foreground shadow-accent flex size-11 shrink-0 items-center justify-center rounded-full text-[16px] font-medium tracking-[0.4px]"
          >
            {initials}
          </span>
        </div>
      </header>

      <DispatchBoard
        locale={locale}
        client:load
        pending={pending}
        counts={counts}
        groups={groups}
        today={today}
        initialSection={initialSection}
      />
    </main>
  </StaffShell>
</Layout>
