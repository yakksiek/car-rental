---
// components
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import InfoIcon from "../components/icons/InfoIcon.astro";
import CategoryIcon from "../components/vehicle/CategoryIcon.astro";

// others
import type { InfoIconName } from "../components/icons/info-icons";
import { getCategoryPricing } from "../lib/services/vehicles";
import { formatPln } from "../lib/format";

const { locale, t } = Astro.locals;
import { cn } from "../lib/utils";

// Cennik — hybrid page (design ScreenPricingDesktop/Mobile, PricingBody). Only the
// "Stawki wg typu pojazdu" table is live: per-category "od" rates from
// getCategoryPricing over active vehicles. The rental-length tier cards, "W każdej
// cenie" benefits, and the "Dobrze wiedzieć" globals are STATIC marketing copy
// (verbatim) — they encode a length-discount ladder and single global values we do
// not store. Money always routes through formatPln (never .toFixed()).

const pricing = await getCategoryPricing(Astro.locals.supabase, locale);

interface Tier {
  icon: InfoIconName;
  name: string;
  when: string;
  from: string;
  note: string;
  tag?: string;
  feat?: boolean;
}

const tiers: Tier[] = [
  {
    icon: "calendar",
    name: t("info.tierDailyName"),
    when: t("info.tierDailyWhen"),
    from: "219",
    note: t("info.tierDailyNote"),
  },
  {
    icon: "van",
    name: t("info.tierShortName"),
    when: t("info.tierShortWhen"),
    from: "199",
    note: t("info.tierShortNote"),
    tag: t("info.tierShortTag"),
  },
  {
    icon: "gauge",
    name: t("info.tierMediumName"),
    when: t("info.tierMediumWhen"),
    from: "169",
    note: t("info.tierMediumNote"),
  },
  {
    icon: "spark",
    name: t("info.tierLongName"),
    when: t("info.tierLongWhen"),
    from: "149",
    note: t("info.tierLongNote"),
    tag: t("info.tierLongTag"),
    feat: true,
  },
];

const included: string[] = [
  t("info.included1"),
  t("info.included2"),
  t("info.included3"),
  t("info.included4"),
  t("info.included5"),
  t("info.included6"),
];

const goodToKnow: [k: string, v: string][] = [
  [t("info.goodToKnowDepositKey"), t("info.goodToKnowDepositValue")],
  [t("info.goodToKnowVatKey"), t("info.goodToKnowVatValue")],
  [t("info.goodToKnowInvoiceKey"), t("info.goodToKnowInvoiceValue")],
  [t("info.goodToKnowPaymentKey"), t("info.goodToKnowPaymentValue")],
];
---

<Layout title={t("info.pricingTitle")}>
  <SiteHeader active="pricing" />

  <main>
    <!-- Hero -->
    <div
      class="bg-card border-b border-[var(--flota-hair-2)] px-[22px] pt-[30px] pb-[34px] sm:px-[48px] sm:pt-[58px] sm:pb-[62px]"
    >
      <div class="mx-auto max-w-[1180px]">
        <div class="text-primary inline-flex items-center gap-2 text-[12px] font-bold tracking-[1px] uppercase">
          <span class="bg-primary size-1.5 rounded-full"></span>
          {t("info.pricingEyebrow")}
        </div>
        <h1
          class="text-foreground mt-4 text-[34px] leading-[1.02] font-bold tracking-[-1px] text-balance sm:text-[54px] sm:tracking-[-1.8px]"
        >
          {t("info.pricingHeading")}
        </h1>
        <p class="mt-4 max-w-[680px] text-[15px] leading-[1.55] text-[var(--flota-ink-2)] sm:text-[18px]">
          {t("info.pricingLead")}
        </p>
      </div>
    </div>

    <!-- Rental-length tier cards (static marketing) -->
    <div class="mx-auto max-w-[1180px] px-[22px] pt-[32px] sm:px-[48px] sm:pt-[54px]">
      <div class="grid grid-cols-2 gap-3 sm:grid-cols-4 sm:gap-[18px]">
        {
          tiers.map((tier) => {
            const feat = Boolean(tier.feat);
            return (
              <div
                class:list={cn(
                  "relative overflow-hidden rounded-[20px] border p-[18px_18px_20px] sm:p-[22px_22px_24px]",
                  feat
                    ? "bg-ink-deep border-transparent shadow-[0_20px_44px_-18px_rgba(20,27,45,0.55)]"
                    : "bg-card shadow-card border-[var(--flota-hair)]",
                )}
              >
                <div
                  class:list={cn(
                    "absolute inset-x-0 top-0 h-[3px]",
                    feat ? "bg-primary" : "bg-[linear-gradient(90deg,var(--flota-accent)_0%,rgba(180,54,56,0)_82%)]",
                  )}
                />
                <div class="relative mb-[14px] flex items-center gap-2">
                  <div
                    class:list={cn(
                      "flex size-[44px] items-center justify-center rounded-[12px]",
                      feat ? "bg-white/12" : "bg-accent",
                    )}
                  >
                    <InfoIcon name={tier.icon} size={22} color={feat ? "#fff" : "var(--flota-accent)"} />
                  </div>
                  {tier.tag && (
                    <span
                      class:list={cn(
                        "rounded-full px-[9px] py-[4px] text-[10px] font-bold tracking-[0.4px] uppercase",
                        feat ? "bg-primary text-white" : "bg-accent text-primary",
                      )}
                    >
                      {tier.tag}
                    </span>
                  )}
                </div>
                <div
                  class:list={cn(
                    "text-[15px] font-bold tracking-[-0.3px] sm:text-[16.5px]",
                    feat ? "text-white" : "text-foreground",
                  )}
                >
                  {tier.name}
                </div>
                <div
                  class:list={cn(
                    "mt-0.5 text-[12.5px] font-semibold",
                    feat ? "text-white/60" : "text-muted-foreground",
                  )}
                >
                  {tier.when}
                </div>
                <div class:list={cn("my-4 h-px", feat ? "bg-white/12" : "bg-[var(--flota-hair-2)]")} />
                <div class="flex items-baseline gap-1">
                  <span class:list={cn("text-[12px] font-semibold", feat ? "text-white/60" : "text-muted-foreground")}>
                    {t("info.tierFrom")}
                  </span>
                  <span
                    class:list={cn(
                      "text-[26px] font-[750] tracking-[-1px] sm:text-[30px]",
                      feat ? "text-white" : "text-foreground",
                    )}
                  >
                    {tier.from}
                  </span>
                  <span class:list={cn("text-[13px] font-semibold", feat ? "text-white/60" : "text-muted-foreground")}>
                    {t("info.tierPerDay")}
                  </span>
                </div>
                <div
                  class:list={cn(
                    "mt-1.5 text-[12px] leading-[1.4]",
                    feat ? "text-white/70" : "text-[var(--flota-ink-2)]",
                  )}
                >
                  {tier.note}
                </div>
              </div>
            );
          })
        }
      </div>
    </div>

    <!-- Live per-category rate table -->
    <div class="mx-auto max-w-[1180px] px-[22px] pt-[32px] sm:px-[48px] sm:pt-[54px]">
      <h2 class="text-foreground text-[23px] font-bold tracking-[-0.6px] sm:text-[32px] sm:tracking-[-1px]">
        {t("info.ratesHeading")}
      </h2>
      <div class="mt-1 mb-5 text-[14px] text-[var(--flota-ink-2)] sm:text-[15px]">
        {t("info.ratesLead")}
      </div>
      <div class="bg-card shadow-card overflow-hidden rounded-[20px] border border-[var(--flota-hair)]">
        <!-- Header band (desktop only) -->
        <div
          class="hidden grid-cols-[2.4fr_1fr_1fr] border-b border-[var(--flota-hair)] bg-[#E7EAF1] px-[22px] py-[14px] sm:grid"
        >
          <div class="text-muted-foreground text-[11px] font-bold tracking-[0.4px] uppercase">
            {t("info.ratesColVehicle")}
          </div>
          <div class="text-muted-foreground text-right text-[11px] font-bold tracking-[0.4px] uppercase">
            {t("info.ratesColDay")}
          </div>
          <div class="text-muted-foreground text-right text-[11px] font-bold tracking-[0.4px] uppercase">
            {t("info.ratesColMonth")}
          </div>
        </div>
        {
          pricing.length === 0 ? (
            <div class="text-muted-foreground px-[16px] py-[18px] text-[14px] sm:px-[22px]">{t("info.ratesEmpty")}</div>
          ) : (
            pricing.map((row, i) => (
              <div
                class:list={cn(
                  "grid grid-cols-[1fr_auto] items-center gap-[10px] px-[16px] py-[14px] sm:grid-cols-[2.4fr_1fr_1fr] sm:gap-0 sm:px-[22px] sm:py-[16px]",
                  i > 0 && "border-t border-[var(--flota-hair-2)]",
                )}
              >
                <div class="flex min-w-0 items-center gap-[13px]">
                  <div class="bg-background flex size-[40px] shrink-0 items-center justify-center rounded-[10px]">
                    <CategoryIcon category={row.category} class="size-[21px] text-[var(--flota-ink-2)]" />
                  </div>
                  <div class="min-w-0">
                    <div class="text-foreground text-[14.5px] font-[650] tracking-[-0.2px] sm:text-[15.5px]">
                      {row.label}
                    </div>
                  </div>
                </div>
                {/* Mobile: stacked rates; desktop: two right-aligned cells. */}
                <div class="shrink-0 text-right sm:hidden">
                  <div class="text-foreground text-[15px] font-[750] tracking-[-0.4px]">
                    {t("info.ratesFrom")} {formatPln(row.minDaily, locale)}
                    <span class="text-muted-foreground text-[11px] font-semibold">{t("info.ratesPerDayShort")}</span>
                  </div>
                  <div class="text-muted-foreground mt-px text-[12px]">
                    {t("info.ratesFrom")} {formatPln(row.minMonthly, locale)}
                    {t("info.ratesPerMonthShort")}
                  </div>
                </div>
                <div class="text-foreground hidden text-right text-[16px] font-[750] tracking-[-0.4px] sm:block">
                  {t("info.ratesFrom")} {formatPln(row.minDaily, locale)}
                </div>
                <div class="hidden text-right text-[16px] font-bold tracking-[-0.4px] text-[var(--flota-ink-2)] sm:block">
                  {t("info.ratesFrom")} {formatPln(row.minMonthly, locale)}
                </div>
              </div>
            ))
          )
        }
      </div>
    </div>

    <!-- Included + good-to-know (static) -->
    <div class="mx-auto max-w-[1180px] px-[22px] pt-[32px] sm:px-[48px] sm:pt-[54px]">
      <div class="grid grid-cols-1 items-start gap-5 sm:grid-cols-[1.3fr_1fr] sm:gap-7">
        <div>
          <h2 class="text-foreground text-[23px] font-bold tracking-[-0.6px] sm:text-[32px] sm:tracking-[-1px]">
            {t("info.includedHeading")}
          </h2>
          <div class="mt-[18px] grid grid-cols-1 gap-[10px] sm:grid-cols-2 sm:gap-3">
            {
              included.map((item) => (
                <div class="flex items-start gap-[11px]">
                  <span class="mt-px flex size-6 shrink-0 items-center justify-center rounded-full bg-[var(--flota-success-soft)]">
                    <InfoIcon name="check" size={15} color="var(--flota-success)" />
                  </span>
                  <span class="text-[14px] leading-[1.35] font-medium text-[var(--flota-ink-2)] sm:text-[14.5px]">
                    {item}
                  </span>
                </div>
              ))
            }
          </div>
        </div>

        <div class="bg-ink-deep rounded-[20px] p-[22px] text-white sm:p-[26px]">
          <div class="text-[15.5px] font-bold tracking-[-0.2px]">{t("info.goodToKnowHeading")}</div>
          <div class="mt-4 flex flex-col gap-3">
            {
              goodToKnow.map(([k, v]) => (
                <div class="flex gap-3 border-b border-white/10 pb-3">
                  <div class="w-[76px] shrink-0 pt-px text-[12px] font-bold tracking-[0.3px] text-white/55 uppercase">
                    {k}
                  </div>
                  <div class="text-[13.5px] leading-[1.4] text-white/[0.92]">{v}</div>
                </div>
              ))
            }
          </div>
          <a
            href="/fleet"
            class="bg-primary mt-[18px] flex h-[46px] items-center justify-center gap-2 rounded-[12px] text-[14.5px] font-[650] text-white"
          >
            {t("info.reserveVehicle")}
            <InfoIcon name="arrowRight" size={16} color="#fff" />
          </a>
        </div>
      </div>
    </div>

    <div class="h-9 sm:h-[60px]"></div>
  </main>

  <SiteFooter />
</Layout>
