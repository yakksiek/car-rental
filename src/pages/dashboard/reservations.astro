---
// components
import Layout from "../../layouts/Layout.astro";
import StaffShell from "../../components/shell/StaffShell.astro";
import PendingQueue from "../../components/dashboard/PendingQueue";
import NewReservationButton from "../../components/dashboard/NewReservationButton";

// others
import { countOverdueReturns } from "../../lib/services/protocols";
import { listPendingReservations } from "../../lib/services/reservations";
import { listFleet } from "../../lib/services/vehicles";

// Employee pending-request queue (S-03). The /dashboard/reservations route is
// gated to `employee` by the middleware (src/lib/access.ts); this page SSRs the
// pending list through the role-gated definer RPC and mounts the decision island.
const { user, role, supabase } = Astro.locals;
// The active fleet feeds the manual-reservation modal's vehicle picker (S-12) —
// only bookable vehicles are offered (design contract D3: there is no
// maintenance state in the model).
const [reservations, overdueCount, fleet] = await Promise.all([
  listPendingReservations(supabase),
  countOverdueReturns(supabase),
  listFleet(supabase),
]);
const count = reservations.length;
const countLabel = `${count} oczekuje na decyzję`;

// The mobile back affordance (design 08) points at the dashboard, so it only
// makes sense when the user arrived from there. The Pulpit cockpit links carry
// `?from=pulpit`; the persistent nav tab does not — reaching this as a top-level
// destination shows no back button.
const fromDashboard = Astro.url.searchParams.get("from") === "pulpit";
---

<Layout title="Oczekujące wnioski — Flota">
  <StaffShell
    active="requests"
    title="Oczekujące wnioski"
    subtitle={countLabel}
    user={user}
    role={role}
    pendingCount={count}
    overdueCount={overdueCount}
  >
    <main class="mx-auto w-full max-w-7xl px-4 py-6 md:px-8">
      {
        /* Manual-reservation entry point (S-12), right-aligned above the queue.
          Page-owned on purpose: the frame keeps S-12 off the shell nav, which
          S-11 owns. */
      }
      <div class="mb-4 flex justify-end">
        <NewReservationButton client:load vehicles={fleet} />
      </div>
      {
        /* The mobile list header (design 08) lives inside the island so it shows
          only in the queue state and disappears on the request detail — passing
          `fromDashboard` so the island can render the back-to-pulpit affordance. */
      }
      <PendingQueue client:load reservations={reservations} fromDashboard={fromDashboard} />
    </main>
  </StaffShell>
</Layout>
