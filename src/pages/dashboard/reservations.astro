---
// components
import Layout from "../../layouts/Layout.astro";
import StaffShell from "../../components/shell/StaffShell.astro";
import PendingQueue from "../../components/dashboard/PendingQueue";

// others
import { countOverdueReturns } from "../../lib/services/protocols";
import { listPendingReservations } from "../../lib/services/reservations";

// Employee pending-request queue (S-03). The /dashboard/reservations route is
// gated to `employee` by the middleware (src/lib/access.ts); this page SSRs the
// pending list through the role-gated definer RPC and mounts the decision island.
const { user, role, supabase, locale, t } = Astro.locals;
// No fleet fetch here any more (S-12b): the manual-reservation picker is loaded
// on demand from `GET /api/vehicles` when a staffer actually picks that row, so
// this page costs one SSR read fewer than it did under S-12.
const [reservations, overdueCount] = await Promise.all([
  listPendingReservations(supabase),
  countOverdueReturns(supabase),
]);
const count = reservations.length;
const countLabel = `${String(count)} ${t("dashboard.awaitingDecisionCount")}`;

// The mobile back affordance (design 08) points at the dashboard, so it only
// makes sense when the user arrived from there. The cockpit's own links carry
// `?from=dashboard`; the persistent nav tab does not — reaching this as a
// top-level destination shows no back button. (The marker was `pulpit` until
// english-localization Phase 5; it is an internal token, not copy, so renaming
// it costs nothing and keeps the Polish sweep honest.)
const fromDashboard = Astro.url.searchParams.get("from") === "dashboard";
---

<Layout title={`${t("dashboard.requestsTitle")} — Flota`}>
  <StaffShell
    active="requests"
    title={t("dashboard.requestsTitle")}
    subtitle={countLabel}
    user={user}
    role={role}
    pendingCount={count}
    overdueCount={overdueCount}
  >
    <main class="mx-auto w-full max-w-7xl px-4 py-6 md:px-8">
      {
        /* The mobile list header (design 08) lives inside the island so it shows
          only in the queue state and disappears on the request detail — passing
          `fromDashboard` so the island can render the back-to-pulpit affordance. */
      }
      <PendingQueue client:load reservations={reservations} fromDashboard={fromDashboard} locale={locale} />
    </main>
  </StaffShell>
</Layout>
