---
// components
import Layout from "../../layouts/Layout.astro";
import StaffShell from "../../components/shell/StaffShell.astro";
import NavIcon from "../../components/shell/NavIcon.astro";
import LangRow from "../../components/shell/LangRow";

// others
import { staffIdentity } from "../../lib/staff-identity";
import { listPendingReservations } from "../../lib/services/reservations";
import { countOverdueReturns } from "../../lib/services/protocols";

// Staff self-service profile (S-11 Phase 2). Read-only identity + the two account
// actions; there is no edit path (profiles UPDATE is admin-only by RLS), so this
// screen owns no mutation of its own — "Zmień hasło" hands off to the sub-route
// and "Wyloguj się" posts to the shared sign-out endpoint.
//
// Design contract: context/changes/staff-account/design-contract.md. The mockup's
// Telefon (D1), Powiadomienia (D2) and Praca/Oddział (D3) rows are deliberate
// trims — the data model carries no phone, notification or branch field.
const { user, role, supabase, locale, t } = Astro.locals;

// The caller's own profiles row is self-SELECT-able under RLS. `maybeSingle` keeps
// a missing row non-fatal: the name simply degrades to the humanised email.
const [profileResult, pending, overdueCount] = await Promise.all([
  supabase && user
    ? supabase.from("profiles").select("full_name").eq("user_id", user.id).maybeSingle()
    : Promise.resolve({ data: null }),
  listPendingReservations(supabase),
  countOverdueReturns(supabase),
]);

const { initials, displayName, roleLabel } = staffIdentity(user?.email, role, locale);
const fullName = profileResult.data?.full_name ?? null;
const name = fullName ?? displayName;

// The hero avatar has to agree with the name printed beside it. `staffIdentity`
// derives initials from the email local-part only (S-08 predates `full_name`), so
// on a named profile it would pair "Karolina Mazur" with an "E" from
// employee@… — take the initials from whichever source won the name above.
const initialsOf = (value: string) =>
  value
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((part) => part[0].toUpperCase())
    .join("");
const avatarInitials = (fullName ? initialsOf(fullName) : "") || initials;
---

<Layout title={`${t("dashboard.accountTitle")} — Flota`}>
  <StaffShell
    active="me"
    title={t("dashboard.accountTitle")}
    subtitle={t("dashboard.accountSubtitle")}
    user={user}
    role={role}
    pendingCount={pending.length}
    overdueCount={overdueCount}
  >
    {/* Mobile bottom clearance for the floating tab bar comes from the shell's own pb-28. */}
    <main class="mx-auto w-full max-w-[980px] px-[18px] pt-[54px] md:px-8 md:pt-8 md:pb-8">
      {/* Mobile centered header (the desktop topbar carries this at md+) */}
      <header class="mb-3 text-center md:hidden">
        <h1 class="text-foreground text-[17px] font-[650] tracking-[-0.2px]">{t("dashboard.accountTitle")}</h1>
      </header>

      <div class="flex flex-col gap-[18px] pt-1.5 md:gap-5 md:pt-0">
        {/* ── Identity ────────────────────────────────────────────────── */}
        <section class="bg-card shadow-card rounded-lg md:rounded-[18px]">
          <div class="flex items-center gap-4 p-[18px] md:p-[22px]">
            <span
              class="bg-primary text-primary-foreground flex size-[60px] shrink-0 items-center justify-center rounded-full text-[20px] font-semibold tracking-[0.5px] shadow-[0_4px_14px_rgba(180,54,56,0.30)] md:size-[72px] md:text-[24px]"
            >
              {avatarInitials}
            </span>
            <div class="min-w-0">
              <div class="text-foreground truncate text-[18px] font-bold tracking-[-0.4px] md:text-[22px]">{name}</div>
              <div class="mt-[5px] flex flex-wrap items-center gap-[7px]">
                <span
                  class="inline-flex h-5 items-center gap-1 rounded-[6px] bg-[var(--flota-neutral-soft)] px-2 text-[10px] font-bold text-[var(--flota-neutral)] uppercase"
                >
                  <NavIcon glyph="user" size={10} />
                  {roleLabel}
                </span>
              </div>
            </div>
          </div>
        </section>

        <div class="grid gap-[18px] md:grid-cols-2 md:gap-5">
          {/* ── Contact ───────────────────────────────────────────────── */}
          <section>
            <div class="text-muted-foreground mx-1 mb-2 text-[11.5px] font-bold tracking-[0.4px] uppercase">
              {t("info.contactEyebrow")}
            </div>
            <div class="bg-card shadow-card overflow-hidden rounded-lg">
              <div class="flex items-center gap-[13px] px-4 py-3.5">
                <span class="bg-background flex size-9 shrink-0 items-center justify-center rounded-[10px]">
                  <svg
                    class="size-4 text-[var(--flota-ink-2)]"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.7"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                  </svg>
                </span>
                <div class="min-w-0">
                  <div class="text-foreground text-[13.5px] font-[650] tracking-[-0.15px]">
                    {t("dashboard.accountWorkEmail")}
                  </div>
                  <div class="text-muted-foreground mt-0.5 truncate text-[12px]">{user?.email}</div>
                </div>
              </div>
            </div>
          </section>

          {/* ── Konto ─────────────────────────────────────────────────── */}
          <section>
            <div class="text-muted-foreground mx-1 mb-2 text-[11.5px] font-bold tracking-[0.4px] uppercase">
              {t("dashboard.accountSectionAccount")}
            </div>
            <div class="bg-card shadow-card overflow-hidden rounded-lg">
              {
                /* Language is the one preference this screen can actually write —
                 the sidebar row is desktop-only, and the mobile tab bar has no room
                 for a chrome control, so /dashboard/account is where a
                 `profiles.locale` setting belongs (design has no mockup for it:
                 `deviation(no source)`). Both write through POST /api/locale. */
              }
              <div class="border-b border-[var(--flota-hair-2)]">
                <LangRow client:idle variant="account" locale={locale} redirect="/dashboard/account" />
              </div>

              <a
                href="/dashboard/account/password"
                class="hover:bg-background flex items-center gap-[13px] px-4 py-3.5 transition-colors"
              >
                <span class="bg-background flex size-9 shrink-0 items-center justify-center rounded-[10px]">
                  <span class="text-[var(--flota-ink-2)]"><NavIcon glyph="key" size={16} /></span>
                </span>
                <div class="text-foreground min-w-0 text-[13.5px] font-[650] tracking-[-0.15px]">
                  {t("dashboard.accountChangePassword")}
                </div>
                <svg
                  class="text-muted-foreground ml-auto size-[15px] shrink-0"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="m9 6 6 6-6 6"></path>
                </svg>
              </a>

              {
                /* Sign-out keeps `data-signout` so the shell's existing submit binder
                 paints the pending label — this is the only such affordance on mobile. */
              }
              <form method="POST" action="/api/auth/signout" data-signout class="border-t border-[var(--flota-hair-2)]">
                {
                  /* min-h/text-destructive on the button itself so the binder's
                   textContent swap keeps the row's height and colour. */
                }
                <button
                  type="submit"
                  class="text-destructive hover:bg-background flex min-h-16 w-full items-center gap-[13px] px-4 py-3.5 text-left text-[13.5px] font-[650] transition-colors disabled:opacity-60"
                >
                  <span
                    class="flex size-9 shrink-0 items-center justify-center rounded-[10px] bg-[var(--flota-danger-soft)]"
                  >
                    <svg
                      class="text-destructive size-4"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.7"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"></path>
                    </svg>
                  </span>
                  <span class="text-destructive min-w-0 text-[13.5px] font-[650] tracking-[-0.15px]">
                    {t("dashboard.accountSignOut")}
                  </span>
                  <svg
                    class="text-muted-foreground ml-auto size-[15px] shrink-0"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.7"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="m9 6 6 6-6 6"></path>
                  </svg>
                </button>
              </form>
            </div>
          </section>
        </div>
      </div>
    </main>
  </StaffShell>
</Layout>
