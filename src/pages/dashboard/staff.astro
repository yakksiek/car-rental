---
// components
import Layout from "../../layouts/Layout.astro";
import StaffShell from "../../components/shell/StaffShell.astro";
import StaffList from "../../components/staff/StaffList";

// others
import { listStaff } from "../../lib/services/staff";
import { staffCountLabel } from "../../lib/staff-format";
import { listPendingReservations } from "../../lib/services/reservations";
import { countOverdueReturns } from "../../lib/services/protocols";

// Employees admin surface (S-08 Phase 4). /dashboard/staff is gated to `admin`
// by the middleware (src/lib/access.ts → /dashboard/staff prefix), so this page
// simply SSR-loads the roster through the admin-gated list_staff RPC and mounts
// the island. Since S-12b the shell's band carries the title and the roster
// count at md+ (the island kept only its mobile header), so the count is
// computed here for the subtitle. Nav badge counts are loaded for parity with
// the other staff pages.
//
// `isDemo` rides through to the island so the three demo-gated controls render
// fenced rather than inviting a click the server will 403. The shell reads the
// same flag off `Astro.locals` itself for the quick-add menu's promoted row.
const { user, role, supabase, isDemo, locale } = Astro.locals;

const [staff, pending, overdueCount] = await Promise.all([
  listStaff(supabase),
  listPendingReservations(supabase),
  countOverdueReturns(supabase),
]);

const adminCount = staff.filter((s) => s.role === "admin").length;
---

<Layout title="Pracownicy — Flota">
  <StaffShell
    active="staff"
    title="Pracownicy"
    subtitle={staffCountLabel(staff.length, adminCount, locale)}
    promotedAction="employee"
    user={user}
    role={role}
    pendingCount={pending.length}
    overdueCount={overdueCount}
  >
    <StaffList client:load staff={staff} currentUserId={user?.id ?? ""} isDemo={isDemo} locale={locale} />
  </StaffShell>
</Layout>
