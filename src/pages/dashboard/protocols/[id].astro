---
// components
import Layout from "../../../layouts/Layout.astro";
import StaffShell from "../../../components/shell/StaffShell.astro";
import ProtocolView from "../../../components/protocol/ProtocolView";

// others
import type {
  ProtocolViewBaselineDamage,
  ProtocolViewDamage,
  ProtocolViewPhoto,
} from "../../../components/protocol/ProtocolView";
import { countOverdueReturns, getProtocol } from "../../../lib/services/protocols";
import { listPendingReservations } from "../../../lib/services/reservations";
import { resolveBackTarget } from "../../../lib/back-target";
import { PHOTO_SLOTS } from "../../../lib/protocol-schema";
import { damageTypeLabel, photoSlotLabel } from "../../../lib/i18n/protocol";

// Read-only view of an issued protocol (S-05 Phase 6). Gated to `employee` by the
// middleware (/dashboard prefix); `get_protocol` is role-gated too, so a non-staff
// caller gets zero rows and this page 404s regardless.
//
// Every object is served through a short-TTL SIGNED url minted HERE, server-side,
// with the staff JWT — the customer never receives a bucket URL. The view island
// only renders the urls it is handed.
//
// No early `return` in frontmatter: a top-level return crashes
// `@typescript-eslint/no-misused-promises` under `astro-eslint-parser`. The 404
// follows the `Astro.response.status` pattern used elsewhere.
const { user, role, supabase, locale, t } = Astro.locals;
const { id } = Astro.params;

// Nav badge counts for the shell (S-07 added the overdue one; S-12b adds the
// pending one). This was the ONE staff route that never passed `pendingCount`,
// so the Wnioski badge silently read 0 here and only here — the shell defaults
// it to 0 rather than treating it as unknown (known-issues.md). Fetching the
// pending list only to read `.length` is the same duplication the other nine
// pages carry; `service-read-projections` replaces all ten with a count RPC.
//
// `showHeader={false}` stays through S-13: the ProtocolView island's header is a
// CARD inside the content area (not a full-bleed band), and it carries context the
// shell's title slot cannot — reference · customer · vehicle · plate · time. This
// page still keeps ⌘K, though — it is a read-only view, not a form — and the shell
// mounts <GlobalSearch> on the `showHeader={false}` branch precisely for that.
const [overdueCount, pending] = await Promise.all([countOverdueReturns(supabase), listPendingReservations(supabase)]);

const protocol = id ? await getProtocol(supabase, id) : null;

if (!protocol) {
  Astro.response.status = 404;
}

// Reachable from either worklist AND from the cockpit. Absent a `?from`, fall back
// to the worklist that matches the protocol kind — the view's previous behaviour.
const back = resolveBackTarget(
  Astro.url.searchParams.get("from"),
  protocol?.type === "return" ? "/dashboard/returns" : "/dashboard/pickups",
  locale,
);

const BUCKET = "protocols";
const SIGNED_URL_TTL_SECONDS = 300;

// One batch sign for every object the page shows. Missing/unsignable paths map to
// null so a single broken object never takes the whole view down.
const signedByPath = new Map<string, string>();
if (protocol && supabase) {
  const paths = [
    ...(protocol.pdf_path ? [protocol.pdf_path] : []),
    protocol.signature,
    ...protocol.photos.map((p) => p.path),
    ...protocol.damages.flatMap((d) => d.photos),
  ];
  if (paths.length > 0) {
    const { data } = await supabase.storage.from(BUCKET).createSignedUrls(paths, SIGNED_URL_TTL_SECONDS);
    for (const entry of data ?? []) {
      if (entry.path && entry.signedUrl && !entry.error) {
        signedByPath.set(entry.path, entry.signedUrl);
      }
    }
  }
}

const sign = (path: string | null): string | null => (path ? (signedByPath.get(path) ?? null) : null);

// Photos in canonical capture order, each carrying its Polish slot label.
const photos: ProtocolViewPhoto[] = protocol
  ? PHOTO_SLOTS.map((slot) => {
      const match = protocol.photos.find((p) => p.slot === slot);
      return { slot, label: photoSlotLabel(slot, locale), url: match ? sign(match.path) : null };
    })
  : [];

const damages: ProtocolViewDamage[] = protocol
  ? protocol.damages.map((d) => ({
      id: d.id,
      type: d.type,
      typeLabel: damageTypeLabel(d.type, locale),
      location: d.location,
      size: d.size,
      photoUrls: d.photos.map((p) => sign(p)).filter((u): u is string => u !== null),
      // The persisted existing/new decision (S-06): the return view renders the tag
      // from it; null on issue rows, where no tag is shown.
      baselineDamageId: d.baseline_damage_id,
    }))
  : [];

// For a return protocol, load the issue baseline it is measured against — the same
// type-agnostic `get_protocol`, keyed by `baseline_protocol_id` (no new read RPC).
// The comparison block reads its odometer/fuel; the read-only baseline damage
// reference reads its damages. Deltas are computed client-side by the same pure
// helper the form and the PDF use, so the three surfaces cannot disagree. No baseline
// photos are signed — the reference is metadata only.
const isReturn = protocol?.type === "return";
// `isReturn` narrows `protocol` to non-null in this branch (it can only be `'return'`
// on a loaded row), so no extra `&& protocol` guard is needed.
const baseline = isReturn ? await getProtocol(supabase, protocol.baseline_protocol_id) : null;

const baselineDamages: ProtocolViewBaselineDamage[] = baseline
  ? baseline.damages.map((d) => ({
      id: d.id,
      typeLabel: damageTypeLabel(d.type, locale),
      location: d.location,
      size: d.size,
    }))
  : [];

const vehicle = protocol ? [protocol.vehicle_make, protocol.vehicle_model].filter(Boolean).join(" ") : "";
---

<Layout
  title={protocol
    ? `${t("dashboard.protocolPageTitle")} ${protocol.reference} — Flota`
    : `${t("dashboard.notFoundTitle")} — Flota`}
>
  <StaffShell
    active={isReturn ? "returns" : "pickups"}
    title={t("dashboard.protocolPageTitle")}
    user={user}
    role={role}
    pendingCount={pending.length}
    overdueCount={overdueCount}
    showHeader={false}
  >
    {
      protocol ? (
        <ProtocolView
          locale={locale}
          back={back}
          client:load
          protocolId={protocol.id}
          reference={protocol.reference}
          customerName={protocol.customer_name}
          customerEmail={protocol.customer_email}
          vehicle={vehicle}
          plate={protocol.vehicle_plate}
          pickupTime="14:00"
          odometerKm={protocol.odometer_km}
          fuelEighths={protocol.fuel_eighths}
          signedAt={protocol.signed_at}
          customerAck={protocol.customer_ack}
          pdfPath={protocol.pdf_path}
          pdfUrl={sign(protocol.pdf_path)}
          deliveryStatus={protocol.delivery_status}
          signatureUrl={sign(protocol.signature)}
          photos={photos}
          damages={damages}
          kind={protocol.type}
          returnTime="10:00"
          comparison={
            baseline
              ? { baselineOdometerKm: baseline.odometer_km, baselineFuelEighths: baseline.fuel_eighths }
              : undefined
          }
          baselineDamages={baselineDamages}
        />
      ) : (
        <main class="mx-auto flex min-h-[60vh] max-w-[460px] flex-col justify-center px-5 text-center">
          <h1 class="text-foreground text-[21px] font-bold tracking-tight">{t("dashboard.protocolNotFoundTitle")}</h1>
          <p class="text-muted-foreground mt-1.5 text-[13px]">{t("dashboard.protocolNotFoundBody")}</p>
          <a
            href={back.href}
            class="bg-foreground text-background mt-6 flex h-12 items-center justify-center rounded-[13px] text-[15px] font-[650]"
          >
            {back.label}
          </a>
        </main>
      )
    }
  </StaffShell>
</Layout>
