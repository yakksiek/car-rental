---
// components
import Layout from "../../../layouts/Layout.astro";
import StaffShell from "../../../components/shell/StaffShell.astro";
import VehicleForm from "../../../components/fleet/VehicleForm";

// others
import { countOverdueReturns } from "../../../lib/services/protocols";
import { listPendingReservations } from "../../../lib/services/reservations";

// Add-vehicle route (S-04 Phase 5). Gated to `employee` by the middleware
// (/dashboard prefix); renders the shared VehicleForm island in create mode. The
// island POSTs /api/vehicles and, on success, hard-navigates to the fleet list.
// The pending queue is loaded only for the shell's nav badge (consistency with
// the other staff pages). `showHeader={false}`: the island draws its own
// full-bleed strip (back arrow + title + submit actions) at every width, and by
// D10 a task screen gets no quick-add pill either. `searchHotkey={false}` on top
// of it — the shell still MOUNTS <GlobalSearch> on this branch (mobile overlay),
// it just does not claim ⌘K, which at desktop width would navigate away from a
// part-filled form.
const { user, role, supabase, locale } = Astro.locals;
const [pending, overdueCount] = await Promise.all([listPendingReservations(supabase), countOverdueReturns(supabase)]);
---

<Layout title="Dodaj pojazd — Flota">
  <StaffShell
    active="fleet"
    title="Dodaj pojazd"
    user={user}
    role={role}
    pendingCount={pending.length}
    overdueCount={overdueCount}
    showHeader={false}
    searchHotkey={false}
  >
    <VehicleForm client:load mode="create" locale={locale} />
  </StaffShell>
</Layout>
