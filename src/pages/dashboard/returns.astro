---
// components
import Layout from "../../layouts/Layout.astro";
import StaffShell from "../../components/shell/StaffShell.astro";
import QuickAddButton from "../../components/dashboard/QuickAddButton";
import ReturnQueue from "../../components/dashboard/ReturnQueue";

// others
import { countOverdueReturns, listReturnsToday } from "../../lib/services/protocols";
import { listPendingReservations } from "../../lib/services/reservations";
import { parseReturnsFilter } from "../../lib/returns-filter";
import { dateEyebrow, dateLabel } from "../../lib/format-date";

// The returns worklist (S-06 Phase 6): confirmed reservations due-or-overdue to
// return, each awaiting a return protocol or already returned today. Gated to
// `employee` by the middleware (/dashboard prefix); the list itself comes from the
// role-gated `list_returns_today` RPC, so a non-staff caller would see zero rows
// even if the page rendered. The pickups list's return sibling.
//
// `ReturnQueue` mounts `client:load` — it is lightweight (no pdf-lib/heic2any), so
// unlike the form island there is no Worker-bundle reason to force `client:only`.
// `today` is the server's UTC calendar date, matching the DB's `current_date`
// (Supabase runs UTC), so the overdue-vs-due split the queue paints agrees with the
// RPC's `return_date <= current_date` filter.
const { user, role, supabase, locale, t } = Astro.locals;

const [rows, pending, overdueCount] = await Promise.all([
  listReturnsToday(supabase),
  listPendingReservations(supabase),
  countOverdueReturns(supabase),
]);

// Parse `?filter` server-side and hand the island a typed initial value, so a
// deep-link (e.g. the nav badge's `?filter=overdue`) renders pre-filtered with no
// client-only read → no hydration flash. Junk validates away to `null` (Wszystkie).
const initialFilter = parseReturnsFilter(Astro.url.searchParams.get("filter"));

const now = new Date();
const today = now.toISOString().slice(0, 10);
const subtitle = t("dashboard.returnsSubtitle");

// Mobile header eyebrow — `ŚR · 16 LIPCA`; desktop filter-bar date (design O2) —
// `Śr, 16 lip`. Both come from `Intl`, keyed on the same UTC calendar the `today`
// split uses.
const eyebrow = dateEyebrow(now, locale);
const label = dateLabel(now, locale);
---

<Layout title={`${t("dashboard.returnsTitle")} — Flota`}>
  <StaffShell
    active="returns"
    title={t("dashboard.returnsTitle")}
    subtitle={subtitle}
    user={user}
    role={role}
    pendingCount={pending.length}
    overdueCount={overdueCount}
  >
    <main class="mx-auto w-full max-w-[1440px] px-4 py-6">
      {
        /* Mobile centered header (the desktop topbar carries this at md+). A date
          eyebrow sits above the title, matching the mockup's `ŚR · 16 LIPCA`. */
      }
      <header class="mb-4 flex items-start justify-between gap-4 md:hidden">
        <div class="min-w-0">
          <p class="text-muted-foreground text-[11px] font-bold tracking-[0.08em]">{eyebrow}</p>
          <h1 class="text-foreground mt-1 text-[28px] leading-none font-bold tracking-tight">
            {t("dashboard.returnsTitle")}
          </h1>
        </div>
        <QuickAddButton client:load mode="mobile" locale={locale} />
      </header>
      <ReturnQueue
        client:load
        rows={rows}
        today={today}
        initialFilter={initialFilter}
        dateLabel={label}
        locale={locale}
      />
    </main>
  </StaffShell>
</Layout>
