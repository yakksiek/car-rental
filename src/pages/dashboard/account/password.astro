---
// components
import Layout from "../../../layouts/Layout.astro";
import StaffShell from "../../../components/shell/StaffShell.astro";
import ChangePasswordForm from "../../../components/account/ChangePasswordForm";

// others
import { listPendingReservations } from "../../../lib/services/reservations";
import { countOverdueReturns } from "../../../lib/services/protocols";

// In-session change-password sub-page (S-11 Phase 3). Gated to `employee` by the
// middleware (/dashboard prefix), so the session is guaranteed here — unlike
// /auth/reset-password there is no "link expired" branch, only done vs form.
// The card's spacing is the auth card's verbatim (design-contract D6: no mockup).
const done = Astro.url.searchParams.get("done") === "1";
const error = Astro.url.searchParams.get("error");

const { user, role, supabase } = Astro.locals;
const [pending, overdueCount] = await Promise.all([listPendingReservations(supabase), countOverdueReturns(supabase)]);
---

<Layout title="Zmień hasło — Flota">
  <StaffShell
    active="me"
    title="Zmień hasło"
    subtitle="Ustaw nowe hasło do konta"
    user={user}
    role={role}
    pendingCount={pending.length}
    overdueCount={overdueCount}
  >
    <main class="mx-auto w-full max-w-[980px] px-[18px] pt-[54px] md:px-8 md:pt-8 md:pb-8">
      {/* Mobile centered header (the desktop topbar carries this at md+) */}
      <header class="mb-3 text-center md:hidden">
        <h1 class="text-foreground text-[17px] font-[650] tracking-[-0.2px]">Zmień hasło</h1>
      </header>

      {
        /* Suppressed on the success state — the panel's own CTA is the way back,
        and two controls with the same label would just be noise. */
      }
      {
        !done && (
          <a
            href="/dashboard/account"
            class="text-muted-foreground hover:text-foreground mb-3 inline-flex items-center gap-1.5 text-[13px] font-medium transition-colors"
          >
            <span aria-hidden="true">←</span> Wróć do profilu
          </a>
        )
      }

      <div class="bg-card shadow-card rounded-lg px-6 py-7 md:w-[440px] md:rounded-[20px] md:px-10 md:py-9">
        {
          done ? (
            <div class="flex flex-col gap-[18px]">
              <div>
                <h2 class="text-foreground text-[28px] leading-[1.05] font-bold tracking-[-0.8px]">
                  Hasło zaktualizowane
                </h2>
                <p class="text-muted-foreground mt-2 text-sm leading-[1.45]">Od tej pory loguj się nowym hasłem.</p>
              </div>
              <a
                href="/dashboard/account"
                class="bg-primary text-primary-foreground inline-flex h-12 items-center justify-center gap-1.5 rounded-xl px-4 text-sm font-semibold"
              >
                Wróć do profilu <span aria-hidden="true">→</span>
              </a>
            </div>
          ) : (
            <ChangePasswordForm serverError={error} client:load />
          )
        }
      </div>
    </main>
  </StaffShell>
</Layout>
