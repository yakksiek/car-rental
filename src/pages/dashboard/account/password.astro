---
// components
import Layout from "../../../layouts/Layout.astro";
import StaffShell from "../../../components/shell/StaffShell.astro";
import ChangePasswordForm from "../../../components/account/ChangePasswordForm";
import StatusHead from "../../../components/auth/StatusHead.astro";
import AuthPrimaryLink from "../../../components/auth/AuthPrimaryLink.astro";

// others
import { listPendingReservations } from "../../../lib/services/reservations";
import { countOverdueReturns } from "../../../lib/services/protocols";
import { resolveAuthError } from "../../../lib/auth-messages";

// In-session change-password sub-page (S-11 Phase 3). Gated to `employee` by the
// middleware (/dashboard prefix), so the session is guaranteed here — unlike
// /auth/reset-password there is no "link expired" branch, only done vs form.
// The card's spacing is the auth card's verbatim (design-contract D6: no mockup).
// `?error=` carries a short code, never a sentence (S-14, F6): an unrecognised
// one renders no alert, and GoTrue's English `same_password` no longer reaches
// this Polish surface.
//
// `searchHotkey={false}` (S-13): a form sub-screen reached only from inside Profil,
// so by the "reached from inside a screen and holds a form" rule it does not claim
// ⌘K — at desktop width the shortcut navigates to `/dashboard?search=1` and would
// discard a half-typed password. It keeps a normal header (and so the quick-add
// pill), unlike the vehicle-form screens which draw their own. The <GlobalSearch>
// island still mounts, so the mobile search overlay works here.
const done = Astro.url.searchParams.get("done") === "1";

const { user, role, supabase, locale, t } = Astro.locals;
const error = resolveAuthError("changePassword", Astro.url.searchParams.get("error"), locale);
const [pending, overdueCount] = await Promise.all([listPendingReservations(supabase), countOverdueReturns(supabase)]);
---

<Layout title={`${t("dashboard.passwordTitle")} — Flota`}>
  <StaffShell
    active="me"
    title={t("dashboard.passwordTitle")}
    subtitle={t("dashboard.passwordSubtitle")}
    user={user}
    role={role}
    pendingCount={pending.length}
    overdueCount={overdueCount}
    searchHotkey={false}
  >
    <main class="mx-auto w-full max-w-[980px] px-[18px] pt-[54px] md:px-8 md:pt-8 md:pb-8">
      {/* Mobile centered header (the desktop topbar carries this at md+) */}
      <header class="mb-3 text-center md:hidden">
        <h1 class="text-foreground text-[17px] font-[650] tracking-[-0.2px]">{t("dashboard.passwordTitle")}</h1>
      </header>

      {
        /* Suppressed on the success state — the panel's own CTA is the way back,
        and two controls with the same label would just be noise. */
      }
      {
        !done && (
          <a
            href="/dashboard/account"
            class="text-muted-foreground hover:text-foreground mb-3 inline-flex items-center gap-1.5 text-[13px] font-medium transition-colors"
          >
            <span aria-hidden="true">←</span> {t("dashboard.passwordBackToProfile")}
          </a>
        )
      }

      <div class="bg-card shadow-card rounded-lg px-6 py-7 md:w-[440px] md:rounded-[20px] md:px-10 md:py-9">
        {
          done ? (
            <div class="flex flex-col gap-[18px]">
              <div>
                <StatusHead tone="green" icon="shieldCheck" />
                <h2 class="text-foreground text-[28px] leading-[1.05] font-bold tracking-[-0.8px]">
                  {t("dashboard.passwordDoneTitle")}
                </h2>
                <p class="text-muted-foreground mt-2 text-sm leading-[1.45]">{t("dashboard.passwordDoneBody")}</p>
              </div>
              <AuthPrimaryLink href="/dashboard/account">{t("dashboard.passwordBackToProfile")}</AuthPrimaryLink>
            </div>
          ) : (
            <ChangePasswordForm serverError={error} locale={locale} client:load>
              {/* Username anchor — same shape and same reasons as
                  auth/reset-password.astro, differing only in its source: this
                  form changes the SESSION's own password, so it names
                  `user.email`. `autoComplete="current-password"` on the first
                  field anchors a manager only when the typed current password
                  is already in its vault; with two accounts saved for this
                  origin and the signed-in one absent, it falls back to
                  `credentials.front()` and updates the wrong account.

                  Load-bearing and all three look removable:
                  • `type="text"`, NEVER `type="hidden"` — every engine refuses
                    to parse a hidden input as a username. `class="hidden"`
                    (display:none) is what hides it.
                  • no `name` — never submitted, so it cannot reach nor be
                    tampered into /api/auth/change-password (which reads three
                    explicit fields and reauthenticates from the server-side
                    session anyway).
                  • it must precede the `Obecne hasło` field — Firefox only
                    searches fields before the first password one. The slot
                    renders as the form's first child. */}
              {user?.email && (
                <input type="text" id="username" value={user.email} autocomplete="username" readonly class="hidden" />
              )}
            </ChangePasswordForm>
          )
        }
      </div>
    </main>
  </StaffShell>
</Layout>
