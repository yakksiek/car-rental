---
// components
import Layout from "../../layouts/Layout.astro";
import StaffShell from "../../components/shell/StaffShell.astro";
import QuickAddButton from "../../components/dashboard/QuickAddButton";
import PickupQueue from "../../components/dashboard/PickupQueue";

// others
import { plural, type PluralForms } from "../../lib/format";
import type { Locale } from "../../lib/i18n/types";
import { countOverdueReturns, listDispatchToday } from "../../lib/services/protocols";
import { listPendingReservations } from "../../lib/services/reservations";

// The dispatch list (S-05 Phase 6): today's confirmed reservations, each awaiting
// handover or already issued. Gated to `employee` by the middleware (/dashboard
// prefix); the list itself comes from the role-gated `list_dispatch_today` RPC,
// so a non-staff caller would see zero rows even if the page rendered.
//
// This is the entry point S-06 (return) and S-07 (overdue) reuse. `PickupQueue`
// mounts `client:load` — it is lightweight (no pdf-lib/heic2any), so unlike the
// form island there is no Worker-bundle reason to force `client:only`.
const { user, role, supabase, locale } = Astro.locals;

const [rows, pending, overdueCount] = await Promise.all([
  listDispatchToday(supabase),
  listPendingReservations(supabase),
  countOverdueReturns(supabase),
]);

// The subtitle's counted noun. The old inline conditional was a TWO-form
// approximation of a THREE-form language: it rendered the `few` form for every
// count above one, so five pickups read "5 rezerwacje" where Polish requires the
// genitive "5 rezerwacji". `Intl.PluralRules` picks the right form (and the 12–14
// exception with it) instead of the count being compared to 1.
const RESERVATION_FORMS: Record<Locale, PluralForms> = {
  en: { one: "reservation", other: "reservations" },
  pl: { one: "rezerwacja", few: "rezerwacje", many: "rezerwacji", other: "rezerwacji" },
};

const count = rows.length;
const countLabel =
  count === 0 ? "Brak wydań na dziś" : `${count} ${plural(count, locale, RESERVATION_FORMS[locale])} do wydania`;
---

<Layout title="Wydania — Flota">
  <StaffShell
    active="pickups"
    title="Wydania"
    subtitle={countLabel}
    user={user}
    role={role}
    pendingCount={pending.length}
    overdueCount={overdueCount}
  >
    <main class="mx-auto w-full max-w-3xl px-4 py-6">
      {
        /* Mobile centered header (the desktop topbar carries this at md+). The
          quick-add circle is absolutely placed rather than a flex sibling, so the
          title stays optically centred (S-12b). */
      }
      <header class="relative mb-4 text-center md:hidden">
        <h1 class="text-foreground text-xl font-bold tracking-tight">Wydania</h1>
        <p class="text-muted-foreground mt-1 text-sm">{countLabel}</p>
        <div class="absolute top-1/2 right-0 -translate-y-1/2">
          <QuickAddButton client:load mode="mobile" locale={locale} />
        </div>
      </header>
      <PickupQueue client:load rows={rows} />
    </main>
  </StaffShell>
</Layout>
