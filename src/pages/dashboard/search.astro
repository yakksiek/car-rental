---
// core
import { z } from "zod";

// components
import Layout from "../../layouts/Layout.astro";
import StaffShell from "../../components/shell/StaffShell.astro";
import SearchResults from "../../components/search/SearchResults";

// others
import { MIN_QUERY_LENGTH, searchStaff } from "../../lib/services/search";
import { listPendingReservations } from "../../lib/services/reservations";
import { countOverdueReturns } from "../../lib/services/protocols";
import { pluralPl } from "../../lib/format";

// The ⌘K dropdown's Enter target (S-13 Phase 4): the same three groups, widened
// into a page with filter chips. Gated to `employee` by the middleware
// (src/lib/access.ts → /dashboard/search); the `search_staff` RPC re-checks the
// role in the database regardless.
//
// The groups are resolved HERE, server-side, and handed to the island whole — so a
// pasted `?q=` deep-link paints its results in the first render with no fetch and
// no hydration flash. Chip filtering is then pure client-side slicing.
const { user, role, supabase } = Astro.locals;

// Same floor as the endpoint and the RPC. A too-short/blank query is not a crash:
// the page still renders (with its guided empty state) and only the status code
// says the request was malformed — hence `Astro.response.status`, never a
// top-level `return`, which would skip the shell entirely.
const querySchema = z.string().trim().min(MIN_QUERY_LENGTH).max(100);
const parsed = querySchema.safeParse(Astro.url.searchParams.get("q") ?? "");
const q = parsed.success ? parsed.data : "";
if (!parsed.success) {
  Astro.response.status = 400;
}

const [results, pending, overdueCount] = await Promise.all([
  searchStaff(supabase, q),
  listPendingReservations(supabase),
  countOverdueReturns(supabase),
]);

// The server's UTC calendar date, on the same basis as the other staff pages, so
// the returns rows' "dziś / wczoraj" wording cannot flip during hydration.
const today = new Date().toISOString().slice(0, 10);

const resultCount = results.reservations.length + results.returns.length + results.vehicles.length;
const countLabel = `${resultCount} ${pluralPl(resultCount, ["wynik", "wyniki", "wyników"])}`;
// Reaching the page with a blank `?q=` only happens by hand-editing the URL; the
// headline drops the empty quotes and the body shows a prompt instead (see
// SearchResults' `prompt` copy).
const headline = q ? `„${q}”` : "Szukaj";
---

<Layout title={q ? `Wyniki dla „${q}” — Flota` : "Szukaj — Flota"}>
  <StaffShell
    active="search"
    title="Wyniki wyszukiwania"
    user={user}
    role={role}
    pendingCount={pending.length}
    overdueCount={overdueCount}
  >
    {
      /* The shell's own top bar IS this page's topbar (contract Surface 3) — the
        left block just needs an eyebrow above a mixed-weight headline, which the
        plain title/subtitle pair cannot express. */
    }
    <div slot="header-title" class="min-w-0">
      {q && <div class="text-muted-foreground text-[13px]">Wyniki dla</div>}
      <div class="text-foreground mt-0.5 truncate text-[22px] font-bold tracking-tight">
        {headline}
        {q && <span class="text-muted-foreground text-[13px] font-normal">· {countLabel}</span>}
      </div>
    </div>

    <main>
      {
        /* Mobile header — the desktop topbar above carries this at md+. A back
          button sits left of the same eyebrow + headline (contract Surface 4). */
      }
      <header class="bg-card flex items-center gap-3 border-b border-[var(--flota-hair-2)] px-4 py-4 md:hidden">
        <a
          href="/dashboard"
          aria-label="Wróć"
          class="border-border bg-card text-foreground flex size-10 shrink-0 items-center justify-center rounded-[11px] border"
        >
          <svg
            class="size-[18px]"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M19 12H5M12 19l-7-7 7-7"></path>
          </svg>
        </a>
        <div class="min-w-0">
          {q && <div class="text-muted-foreground text-[12px]">Wyniki dla</div>}
          <h1 class="text-foreground mt-0.5 truncate text-[19px] font-bold tracking-tight">
            {headline}
            {q && <span class="text-muted-foreground text-[12px] font-normal">· {countLabel}</span>}
          </h1>
        </div>
      </header>

      <SearchResults client:load q={q} initial={results} today={today} />
    </main>
  </StaffShell>
</Layout>
