---
// components
import { Picture } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import LandingNav from "../components/LandingNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import VehicleCard from "../components/vehicle/VehicleCard.astro";
import VehicleSilhouette from "../components/vehicle/VehicleSilhouette.astro";

// others
import type { VehicleCategory, VehicleFilters } from "../types";
import { listVehicles } from "../lib/services/vehicles";
import { categoryLabelPl } from "../lib/format";
import heroImg from "../assets/hero-airfield.jpg";
import vanImg from "../assets/van-cutout.png";

// Public landing (restyled — `customer-desktop.jsx` → ScreenDesktopHome / ScreenMobileHome).
// A dark immersive hero (full-bleed photo → translucent FLOTA wordmark → van-cutout
// z-order → glass search pill + trust card) rising into a light sheet that carries the
// "Proces wynajmu" stepper, a click-to-route category selector, and a "Popularne" strip.
// Built over existing data + tokens (no global.css edit) and existing fonts. NO account
// chrome (logged-in surfaces are deferred to v2).
//
// Dark hero palette is landing-local arbitrary hex (`#080B12` desktop / `#0A0D14` mobile);
// no token layer added. The forked <LandingNav> replaces the shared <SiteHeader>.

const NO_FILTERS: VehicleFilters = {
  category: null,
  pickup: null,
  return: null,
  minPayload: null,
  sort: null,
};

const vehicles = await listVehicles(Astro.locals.supabase, NO_FILTERS);
const featured = vehicles.slice(0, 3);

const CATEGORIES: VehicleCategory[] = [
  "cargo_van",
  "passenger_van",
  "car_transporter",
  "refrigerated_truck",
  "flatbed_truck",
];
---

<Layout title="Flota — wynajem pojazdów użytkowych">
  <!-- Dark hero (S2) — full-bleed. Positioning context for the floating <LandingNav>. -->
  <section class="relative w-full overflow-hidden bg-[#0A0D14] xl:bg-[#080B12]">
    <!-- Photo (z-0) — the LCP element: eager + high priority, optimized to AVIF/WebP. -->
    <Picture
      src={heroImg}
      formats={["avif", "webp"]}
      alt=""
      loading="eager"
      fetchpriority="high"
      width={1376}
      height={768}
      class="absolute inset-0 z-0 h-full w-full object-cover object-[center_46%] xl:object-center"
    />

    <!-- Top scrim (z-1). -->
    <div
      class="absolute inset-x-0 top-0 z-[1] h-[130px] [background:linear-gradient(180deg,rgba(8,11,18,0.55)_0%,rgba(8,11,18,0)_100%)] xl:h-[300px] xl:[background:linear-gradient(180deg,rgba(10,10,18,0.6)_0%,rgba(10,10,18,0)_100%)]"
    >
    </div>
    <!-- Bottom scrim (z-2) — fades the photo into the dark canvas. -->
    <div
      class="absolute inset-x-0 bottom-0 z-[2] h-[120px] [background:linear-gradient(180deg,rgba(10,13,20,0)_0%,#0A0D14_94%)] xl:top-[420px] xl:h-[460px] xl:[background:linear-gradient(180deg,rgba(10,10,18,0)_0%,rgba(10,10,18,0.95)_100%)]"
    >
    </div>

    <!-- FLOTA wordmark (z-3) — Inter 700, gradient-clip fading UP to transparent. -->
    <div class="pointer-events-none absolute inset-x-0 top-[70px] z-[3] text-center xl:top-[172px]">
      <span
        class="[background-image:linear-gradient(0deg,#FFFFFF_0%,#FFFFFF_40%,rgba(238,242,255,0)_82%)] bg-clip-text font-sans text-[122px] leading-none font-bold tracking-[-5px] text-transparent opacity-[0.85] xl:text-[258px] xl:tracking-[-10px] xl:opacity-70"
      >
        FLOTA
      </span>
    </div>

    <!-- Van cutout (z-4) — SAME crop/position as the photo, so it lands over the van. -->
    <Picture
      src={vanImg}
      formats={["avif", "webp"]}
      alt=""
      loading="eager"
      width={1376}
      height={768}
      class="pointer-events-none absolute inset-0 z-[4] h-full w-full object-cover object-[center_46%] xl:object-center"
    />

    <LandingNav active="home" />

    <!-- Hero content column + trust card + search island land in Phase 2. Shell height
         keeps the composition (photo/wordmark/van) visible until then. -->
    <div class="relative z-[5] h-[336px] xl:h-[880px]"></div>
  </section>

  <!-- Category quick-links -->
  <section id="kategorie" class="max-w-app mx-auto px-5 pt-16 pb-8 sm:px-8">
    <div class="mb-7 flex items-end justify-between gap-4">
      <div>
        <p class="text-muted-foreground text-xs font-semibold tracking-wide uppercase">5 kategorii</p>
        <h2 class="text-foreground mt-1.5 text-3xl font-bold tracking-tight sm:text-4xl">
          Wybierz typ pojazdu<span class="text-primary">.</span>
        </h2>
      </div>
      <a
        href="/fleet"
        class="text-foreground hover:text-primary inline-flex items-center gap-1.5 text-sm font-semibold"
      >
        Cała flota
        <svg
          class="size-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 12h14M13 6l6 6-6 6"></path>
        </svg>
      </a>
    </div>
    <div
      class="-mx-5 flex gap-3 overflow-x-auto px-5 [scrollbar-width:none] sm:mx-0 sm:grid sm:grid-cols-3 sm:overflow-visible sm:px-0 lg:grid-cols-5 [&::-webkit-scrollbar]:hidden"
    >
      {
        CATEGORIES.map((category) => (
          <a
            href={`/fleet?category=${category}`}
            class="group bg-card shadow-card hover:shadow-pop flex min-h-[180px] w-44 shrink-0 flex-col justify-between rounded-xl p-5 transition hover:-translate-y-0.5 sm:w-auto"
          >
            <div class="text-foreground flex flex-1 items-center justify-center py-3">
              <VehicleSilhouette category={category} alt={categoryLabelPl(category)} class="max-w-[150px]" />
            </div>
            <div class="flex items-center justify-between">
              <span class="text-foreground font-semibold tracking-tight">{categoryLabelPl(category)}</span>
              <svg
                class="text-muted-foreground group-hover:text-foreground size-4 transition"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M5 12h14M13 6l6 6-6 6" />
              </svg>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Popular -->
  {
    featured.length > 0 && (
      <section class="max-w-app mx-auto px-5 pt-8 pb-16 sm:px-8">
        <div class="mb-6 flex items-end justify-between gap-4">
          <h2 class="text-foreground text-3xl font-bold tracking-tight sm:text-4xl">Popularne</h2>
          <a href="/fleet" class="text-primary text-sm font-semibold hover:underline">
            Wszystkie
          </a>
        </div>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {featured.map((vehicle) => (
            <VehicleCard vehicle={vehicle} />
          ))}
        </div>
      </section>
    )
  }

  <SiteFooter />
</Layout>
