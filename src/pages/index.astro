---
// core
import { Picture } from "astro:assets";

// components
import Layout from "../layouts/Layout.astro";
import LandingNav from "../components/LandingNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import HeroSearch from "../components/vehicle/HeroSearch.tsx";
import TrustCard from "../components/landing/TrustCard.astro";
import ProcessSteps from "../components/landing/ProcessSteps.astro";
import TypeSelector from "../components/landing/TypeSelector.astro";
import LandingVehicleCard from "../components/vehicle/LandingVehicleCard.astro";

// others
import type { VehicleFilters } from "../types";
import { listVehicles } from "../lib/services/vehicles";
import heroImg from "../assets/hero-airfield.jpg";
import vanImg from "../assets/van-cutout.png";

// Public landing (restyled — `customer-desktop.jsx` → ScreenDesktopHome / ScreenMobileHome).
// A dark immersive hero (full-bleed photo → translucent FLOTA wordmark → van-cutout
// z-order → glass search pill + trust card) rising into a light sheet that carries the
// "Proces wynajmu" stepper, a click-to-route category selector, and a "Popularne" strip.
// Built over existing data + tokens (no global.css edit) and existing fonts. NO account
// chrome (logged-in surfaces are deferred to v2).
//
// Dark hero palette is landing-local arbitrary hex (`#080B12` desktop / `#0A0D14` mobile);
// no token layer added. The forked <LandingNav> replaces the shared <SiteHeader>.

const NO_FILTERS: VehicleFilters = {
  category: null,
  pickup: null,
  return: null,
  minPayload: null,
  sort: null,
};

const vehicles = await listVehicles(Astro.locals.supabase, NO_FILTERS);
const featured = vehicles.slice(0, 3);
---

<Layout title="Flota — wynajem pojazdów użytkowych">
  <!-- Dark hero (S2) — full-bleed. Positioning context for the floating <LandingNav>
       and (on desktop) the absolutely-composed content column + trust card. -->
  <section class="relative w-full overflow-hidden bg-[#0A0D14] xl:h-[880px] xl:bg-[#080B12]">
    <LandingNav active="home" />

    <!-- Photo stage: a 336px band on mobile; full-fill on the 880px desktop canvas.
         Holds the photo → wordmark → van z-order. -->
    <div class="relative h-[336px] w-full md:h-[452px] xl:absolute xl:inset-0 xl:h-auto">
      <!-- Photo (z-0) — the LCP element: eager + high priority, optimized to AVIF/WebP. -->
      <Picture
        src={heroImg}
        formats={["avif", "webp"]}
        alt=""
        loading="eager"
        fetchpriority="high"
        width={1376}
        height={768}
        class="absolute inset-0 z-0 h-full w-full object-cover object-[center_46%] xl:object-center"
      />

      <!-- Top scrim (z-1). -->
      <div
        class="absolute inset-x-0 top-0 z-[1] h-[130px] [background:linear-gradient(180deg,rgba(8,11,18,0.55)_0%,rgba(8,11,18,0)_100%)] md:h-[150px] xl:h-[300px] xl:[background:linear-gradient(180deg,rgba(10,10,18,0.6)_0%,rgba(10,10,18,0)_100%)]"
      >
      </div>
      <!-- Bottom scrim (z-2) — fades the photo into the dark canvas. -->
      <div
        class="absolute inset-x-0 bottom-0 z-[2] h-[120px] [background:linear-gradient(180deg,rgba(10,13,20,0)_0%,#0A0D14_94%)] md:h-[150px] xl:top-[420px] xl:h-[460px] xl:[background:linear-gradient(180deg,rgba(10,10,18,0)_0%,rgba(10,10,18,0.95)_100%)]"
      >
      </div>

      <!-- FLOTA wordmark (z-3) — Inter 700, gradient-clip: white solid at the TOP, fading
           DOWN to transparent (design uses 180deg — the glyph tops read, bases dissolve
           into the horizon). -->
      <div class="pointer-events-none absolute inset-x-0 top-[86px] z-[3] text-center md:top-[118px] xl:top-[172px]">
        <span
          class="[background-image:linear-gradient(180deg,#FFFFFF_0%,#FFFFFF_48%,rgba(238,242,255,0)_96%)] bg-clip-text font-sans text-[122px] leading-none font-bold tracking-[-5px] text-transparent opacity-[0.85] md:text-[210px] md:tracking-[-9px] xl:[background-image:linear-gradient(180deg,#FFFFFF_0%,#FFFFFF_42%,rgba(238,242,255,0)_90%)] xl:text-[258px] xl:tracking-[-10px] xl:opacity-[0.72]"
        >
          FLOTA
        </span>
      </div>

      <!-- Van cutout (z-4) — SAME crop/position as the photo, so it lands over the van. -->
      <Picture
        src={vanImg}
        formats={["avif", "webp"]}
        alt=""
        loading="eager"
        width={1376}
        height={768}
        class="pointer-events-none absolute inset-0 z-[4] h-full w-full object-cover object-[center_46%] xl:object-center"
      />
    </div>

    <!-- Mobile hero content (below the photo stage, on solid dark). Copy is intentionally
         different from desktop; the eyebrow is mobile-only (fixed genitive, deviation). -->
    <div class="relative z-[5] flex flex-col gap-[18px] px-[22px] pt-0.5 pb-[34px] md:hidden">
      <p class="text-[11px] font-bold tracking-[1.4px] text-white/60 uppercase">
        {vehicles.length} POJAZDÓW DOSTĘPNYCH DZIŚ
      </p>
      <h1 class="font-serif text-[46px] leading-[1.02] tracking-[-1.8px] text-white">
        Pojazdy<br />użytkowe<span class="bg-primary ml-[3px] inline-block size-[9px] rounded-full align-baseline"
        ></span>
      </h1>
      <p class="text-[15px] leading-[23px] text-white/72">
        Wynajem długoterminowy i na dobę, w pełni online, z fakturą VAT.
      </p>
      <ul class="flex flex-col gap-2.5">
        {
          [
            "Darmowe podstawienie i odbiór w mieście",
            "Bezpłatne odwołanie rezerwacji",
            "Wynajem średnioterminowy już od 1 miesiąca",
          ].map((text) => (
            <li class="flex items-center gap-2.5 text-[14px] font-medium text-white/[0.92]">
              <span class="flex size-[22px] shrink-0 items-center justify-center rounded-full border border-white/[0.14] bg-white/10">
                <svg
                  class="text-primary size-3"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="3"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M20 6 9 17l-5-5" />
                </svg>
              </span>
              {text}
            </li>
          ))
        }
      </ul>
      <a
        href="/fleet"
        class="bg-primary text-primary-foreground mt-1.5 inline-flex h-14 w-full items-center justify-center gap-2 rounded-[16px] text-[16px] font-bold [box-shadow:0_14px_30px_-10px_rgba(180,54,56,0.55)]"
      >
        Zarezerwuj online
        <svg
          class="size-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 12h14M13 6l6 6-6 6"></path>
        </svg>
      </a>
    </div>

    <!-- Tablet hero content (834, design ScreenTabletHome) — a solid-dark content band
         IN FLOW below the 452px photo stage. The design puts this copy on solid dark
         (not overlaid on the photo); this band is what gives the tablet hero its height.
         The single <HeroSearch> island is lifted from the sheet to fill the band's
         bottom-right, bottom-aligned with the copy (see the search wrapper below). -->
    <div class="relative z-[5] ml-10 hidden w-[408px] flex-col gap-5 pt-1.5 pb-[46px] md:flex xl:hidden">
      <p class="text-[12px] font-bold tracking-[1.4px] text-white/60 uppercase">
        {vehicles.length} POJAZDÓW DOSTĘPNYCH DZIŚ
      </p>
      <h1 class="font-serif text-[62px] leading-[62px] tracking-[-2.4px] text-white">
        Pojazdy<br />użytkowe<span class="bg-primary mb-3 ml-[7px] inline-block size-[11px] rounded-full align-baseline"
        ></span>
      </h1>
      <p class="max-w-[420px] text-[16.5px] leading-[26px] text-white/72">
        Wynajem długoterminowy i na dobę, w pełni online, z fakturą VAT.
      </p>
      <ul class="flex flex-col gap-3">
        {
          [
            "Darmowe podstawienie i odbiór w mieście",
            "Bezpłatne odwołanie rezerwacji",
            "Wynajem średnioterminowy już od 1 miesiąca",
          ].map((text) => (
            <li class="flex items-center gap-3 text-[14.5px] font-medium text-white/[0.92]">
              <span class="flex size-6 shrink-0 items-center justify-center rounded-full border border-white/[0.14] bg-white/10">
                <svg
                  class="text-primary size-[13px]"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="3"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M20 6 9 17l-5-5" />
                </svg>
              </span>
              {text}
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Desktop hero content — absolutely composed on the 880px canvas. -->
    <div class="hidden xl:block">
      <div class="absolute top-[414px] left-16 z-[5] w-[560px]">
        <h1 class="font-serif text-[56px] leading-[56px] tracking-[-2px] text-white">
          Pojazdy<br />użytkowe<span class="text-primary">.</span>
        </h1>
        <p class="mt-5 max-w-[440px] text-[15.5px] leading-[24px] text-white/80">
          Nowe samochody dla Twojej firmy. Dostępne od ręki!
        </p>
        <ul class="mt-6 flex flex-col gap-3">
          {
            [
              "Darmowe podstawienie i odbiór na terenie miasta",
              "Bezpłatne odwołanie rezerwacji",
              "Wynajem średnioterminowy już od 1 miesiąca",
            ].map((text) => (
              <li class="flex items-center gap-3 text-[15.5px] font-medium text-white/95">
                <span class="bg-primary size-[7px] shrink-0 rounded-full" />
                {text}
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Trust card floats bottom-right of the hero, bottom-aligned with the search pill. -->
      <div class="absolute top-[600px] right-16 z-[6] w-[300px]">
        <TrustCard count={vehicles.length} />
      </div>
    </div>
  </section>

  <!-- Light body sheet (S5) — rises over the dark hero with an upward shadow. -->
  <div
    class="bg-background relative z-10 -mt-4 rounded-t-[28px] pt-5 [box-shadow:0_-20px_48px_rgba(0,0,0,0.14)] md:rounded-t-[32px] md:pt-[30px] xl:-mt-10 xl:rounded-t-[40px]"
  >
    <!-- Search island — SINGLE mount. Mobile: a white card at the top of the sheet.
         Tablet (md–<xl): absolutely lifted into the hero's bottom-right column.
         Desktop (≥xl): absolutely lifted up into the dark hero's content column
         (bottom-left). It is never duplicated (a second mount = a second island state). -->
    <div
      class="mx-auto w-full max-w-[560px] px-4 sm:px-6 md:absolute md:top-[-315px] md:right-10 md:z-20 md:mx-0 md:w-[320px] md:max-w-none md:px-0 xl:top-[-145px] xl:right-auto xl:left-16 xl:w-[740px]"
    >
      <HeroSearch client:load />
    </div>

    <!-- Trust card — stacked on mobile, a 3-across white bar at the tablet tier
         (TrustCard lays its rows side-by-side at md); desktop's copy floats in the hero. -->
    <div class="mx-auto mt-4 w-full max-w-[560px] px-4 sm:px-6 md:mt-0 md:max-w-none md:px-8 xl:hidden">
      <TrustCard count={vehicles.length} />
    </div>

    <!-- Proces wynajmu (S6) -->
    <ProcessSteps />

    <!-- Wybierz typ pojazdu (S7) — click-to-route category selector -->
    <TypeSelector />

    <!-- Popularne (S8) — forked LandingVehicleCard over live top-3 -->
    {
      featured.length > 0 && (
        <section class="max-w-app mx-auto px-5 pt-8 pb-16 sm:px-8">
          <h2 class="text-foreground mb-6 font-serif text-[26px] leading-none md:text-[30px] xl:text-[38px]">
            Popularne
          </h2>
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-3">
            {featured.map((vehicle) => (
              <LandingVehicleCard vehicle={vehicle} />
            ))}
          </div>
        </section>
      )
    }

    <SiteFooter />
  </div>
</Layout>
