---
// components
import Layout from "../../layouts/Layout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import ReservationStatusCard from "../../components/reservation/ReservationStatusCard.astro";
import StatusStepper from "../../components/reservation/StatusStepper.astro";

// others
import { useTranslations } from "../../lib/i18n";
import { asLocale } from "../../lib/i18n/types";
import { getReservationStatus } from "../../lib/services/reservations";

// Tokenized reservation status route (design screens 06 / mobile-4 / desktop-3).
// One screen, two arrivals: the post-submit "request received" landing and the
// durable status link the confirmation email carries. The `access_token` path
// segment is the only credential — resolution crosses the RLS boundary through
// the `get_reservation_status` definer RPC (`reservations` stays anon-denied),
// and an unknown/malformed token yields `null` → a styled HTTP 404. The URL is
// a bearer secret, so the page is marked noindex.

const { token } = Astro.params;
const { supabase, t } = Astro.locals;

const view = token ? await getReservationStatus(supabase, token) : null;

if (!view) {
  Astro.response.status = 404;
}

// *** Two locales on one page, deliberately. ***
//
// `t` above is the SESSION's — it renders <SiteHeader> and <SiteFooter>, which
// belong to the visitor: the switcher in the header has to keep working, and
// pressing it must change something.
//
// `bt` is the BOOKING's, off `reservations.locale`, and it renders everything
// between them. A Polish customer books in Polish, gets a Polish confirmation
// e-mail, and clicks the status link inside it. They arrive with no cookie, so
// the session resolves to the default (English) and the page they were sent to
// would greet them in a language they did not choose.
//
// `asLocale`'s default IS right here, unlike on the two protocol pages (Phase 10
// §2): this is a page, re-rendered on every visit, so a value that somehow went
// missing costs one English render rather than a permanently mis-stamped PDF.
const bookingLocale = asLocale(view?.locale);
const bt = view ? useTranslations(bookingLocale) : t;

// `<main>` below carries `lang={bookingLocale}`. `<html lang>` is the SESSION's,
// and when the two differ a screen reader would otherwise announce a Polish
// booking in an English voice. Marking the region is HTML's own mechanism for a
// language change inside a document; the 404 branch needs none, since it is the
// session's language all the way down.

const title = view ? `${bt("booking.statusTitlePrefix")} ${view.reference}` : t("booking.statusNotFoundTitle");
---

<Layout title={`${title} — Flota`}>
  <meta slot="head" name="robots" content="noindex" />
  <SiteHeader />
  {
    view ? (
      <main lang={bookingLocale} class="mx-auto max-w-3xl px-5 py-10 sm:px-8 sm:py-14">
        <ReservationStatusCard view={view} locale={bookingLocale} />
        <StatusStepper status={view.status} locale={bookingLocale} class="mt-8" />
        {/* Single action — both old buttons went to /fleet, so one CTA suffices.
            Full-width on mobile, auto-width centered on desktop. */}
        <div class="mt-8 flex justify-center">
          <a
            href="/fleet"
            class="bg-foreground text-background rounded-button inline-flex h-12 w-full items-center justify-center gap-1.5 px-6 text-sm font-semibold sm:w-auto sm:px-8"
          >
            {bt("fleet.backToFleet")}
            <svg
              class="size-3.5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M5 12h14M13 6l6 6-6 6" />
            </svg>
          </a>
        </div>
      </main>
    ) : (
      <main class="mx-auto max-w-2xl px-5 py-24 text-center sm:px-8">
        <p class="text-muted-foreground text-xs font-semibold tracking-wide uppercase">{t("fleet.notFoundEyebrow")}</p>
        <h1 class="text-foreground mt-3 text-3xl font-bold tracking-tight">{t("booking.statusNotFoundTitle")}</h1>
        <p class="text-muted-foreground mx-auto mt-3 max-w-md">{t("booking.statusNotFoundBody")}</p>
        <a
          href="/fleet"
          class="bg-foreground text-background rounded-button mt-7 inline-flex h-11 items-center px-6 text-sm font-semibold"
        >
          {t("fleet.backToFleet")}
        </a>
      </main>
    )
  }
  <SiteFooter />
</Layout>
