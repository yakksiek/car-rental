---
// core
import { Image } from "astro:assets";

// components
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import InfoIcon from "../components/icons/InfoIcon.astro";
import CategoryIcon from "../components/vehicle/CategoryIcon.astro";

// others
import type { InfoIconName } from "../components/icons/info-icons";
import { getCategoryCounts } from "../lib/services/vehicles";
import heroImg from "../assets/hero-airfield.jpg";

// O nas — static marketing page (design `ScreenAboutDesktop/Mobile`, AboutBody) over
// the shared shell. One live datum: the "pojazdy we flocie" stat = active-vehicle
// count (getCategoryCounts). Everything else is verbatim design copy. The hero photo
// reuses src/assets/hero-airfield.jpg via astro:assets (mirrors index.astro).

const { t } = Astro.locals;
const counts = await getCategoryCounts(Astro.locals.supabase);
// LIVE fleet count; "—" when Supabase is unset/empty (states-undesigned deviation).
const fleetCount = counts.total > 0 ? String(counts.total) : "—";

// STATS cards (design AboutBody STATS, pulled 2026-08-02): accent bar + faint corner
// watermark + number + label — no small top icon. The "pojazdy we flocie" card uses the
// canonical truck glyph (CategoryIcon, consistent with P9); the other three keep II.* icons.
const stats: { icon: InfoIconName | "truck"; n: string; l: string }[] = [
  { icon: "shield", n: t("info.statYearsValue"), l: t("info.statYearsLabel") },
  { icon: "truck", n: fleetCount, l: t("info.statFleetLabel") },
  { icon: "headset", n: t("info.statSupportValue"), l: t("info.statSupportLabel") },
  { icon: "spark", n: t("info.statAgeValue"), l: t("info.statAgeLabel") },
];

// "Nasza flota" list (design FLEET_ITEMS, pulled 2026-08-02) — canonical Icon.* glyphs.
// `title` / `desc` rather than the old `t` / `d`: `t` is now the translator.
const fleetItems: { icon: InfoIconName; title: string; desc: string }[] = [
  { icon: "truck", title: t("info.fleetVansT"), desc: t("info.fleetVansD") },
  { icon: "bus", title: t("info.fleetBusesT"), desc: t("info.fleetBusesD") },
  { icon: "box", title: t("info.fleetBoxT"), desc: t("info.fleetBoxD") },
  { icon: "flatbed", title: t("info.fleetTailliftT"), desc: t("info.fleetTailliftD") },
  { icon: "van", title: t("info.fleetCrewT"), desc: t("info.fleetCrewD") },
  { icon: "city", title: t("info.fleetCityT"), desc: t("info.fleetCityD") },
];

const values: { icon: InfoIconName; title: string; desc: string }[] = [
  { icon: "shield", title: t("info.valueInsuranceT"), desc: t("info.valueInsuranceD") },
  { icon: "gauge", title: t("info.valueMileageT"), desc: t("info.valueMileageD") },
  { icon: "spark", title: t("info.valueModernT"), desc: t("info.valueModernD") },
  { icon: "calendar", title: t("info.valueFlexibleT"), desc: t("info.valueFlexibleD") },
  { icon: "invoice", title: t("info.valueInvoiceT"), desc: t("info.valueInvoiceD") },
  { icon: "headset", title: t("info.valueSupportT"), desc: t("info.valueSupportD") },
];

const contacts: { icon: InfoIconName; k: string; v: string; href?: string }[] = [
  { icon: "phone", k: t("info.contactPhoneKey"), v: "+48 22 100 20 30", href: "tel:+48221002030" },
  { icon: "mail", k: t("info.contactEmailKey"), v: "kontakt@flota.pl", href: "mailto:kontakt@flota.pl" },
  { icon: "pin", k: t("info.contactAddressKey"), v: t("info.contactAddressValue") },
  { icon: "clock", k: t("info.contactHoursKey"), v: t("info.contactHoursValue") },
];
---

<Layout title={t("info.aboutTitle")}>
  <SiteHeader active="about" />

  <main>
    <!-- Hero -->
    <div
      class="bg-card border-b border-[var(--flota-hair-2)] px-[22px] pt-[30px] pb-[34px] sm:px-[48px] sm:pt-[58px] sm:pb-[62px]"
    >
      <div class="mx-auto max-w-[1180px]">
        <div class="text-primary inline-flex items-center gap-2 text-[12px] font-bold tracking-[1px] uppercase">
          <span class="bg-primary size-1.5 rounded-full"></span>
          {t("info.aboutEyebrow")}
        </div>
        <h1
          class="text-foreground mt-4 text-[34px] leading-[1.02] font-bold tracking-[-1px] text-balance sm:text-[54px] sm:tracking-[-1.8px]"
        >
          {t("info.aboutHeading")}
        </h1>
        <p class="mt-4 max-w-[680px] text-[15px] leading-[1.55] text-[var(--flota-ink-2)] sm:text-[18px]">
          {t("info.aboutLead")}
        </p>
      </div>
    </div>

    <!-- Stats band (fleet count is live) -->
    <div class="mx-auto max-w-[1180px] px-[22px] pt-[32px] sm:px-[48px] sm:pt-[54px]">
      <div class="grid grid-cols-2 gap-3 sm:grid-cols-4 sm:gap-4">
        {
          stats.map((s) => (
            <div class="bg-card relative overflow-hidden rounded-[16px] border border-[var(--flota-hair-2)] p-[18px] shadow-[0_1px_2px_rgba(15,23,42,0.03)] sm:px-[26px] sm:py-[24px]">
              {/* Crimson top-accent bar */}
              <div class="bg-primary absolute inset-x-0 top-0 h-[3px] opacity-[0.85]" />
              {/* Faint corner watermark of the card's own icon */}
              <div class="pointer-events-none absolute right-[-18px] bottom-[-24px] opacity-[0.05]">
                {s.icon === "truck" ? (
                  <CategoryIcon category="cargo_van" class="size-24 text-[var(--flota-ink)] sm:size-[132px]" />
                ) : (
                  <InfoIcon name={s.icon} color="var(--flota-ink)" class="size-24 sm:size-[132px]" />
                )}
              </div>
              <div class="relative">
                <div class="text-foreground mt-1 text-[32px] leading-none font-[780] tracking-[-2px] sm:mt-1.5 sm:text-[46px]">
                  {s.n}
                </div>
                <div class="text-muted-foreground mt-2 text-[12.5px] font-semibold sm:text-[13.5px]">{s.l}</div>
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Narrative + photo -->
    <div class="mx-auto max-w-[1180px] px-[22px] pt-[32px] sm:px-[48px] sm:pt-[54px]">
      <div class="grid grid-cols-1 items-center gap-[22px] sm:grid-cols-2 sm:gap-[44px]">
        <div>
          <div class="text-primary inline-flex items-center gap-2 text-[12px] font-bold tracking-[1px] uppercase">
            <span class="bg-primary size-1.5 rounded-full"></span>
            {t("info.storyEyebrow")}
          </div>
          <h2 class="text-foreground mt-3 text-[23px] font-bold tracking-[-0.6px] sm:text-[32px] sm:tracking-[-1px]">
            {t("info.storyHeading")}
          </h2>
          <p class="mt-3.5 text-[14.5px] leading-[1.65] text-[var(--flota-ink-2)] sm:text-[15.5px]">
            {t("info.storyP1")}
          </p>
          <p class="mt-3 text-[14.5px] leading-[1.65] text-[var(--flota-ink-2)] sm:text-[15.5px]">
            {t("info.storyP2")}
          </p>
        </div>
        <div
          class="relative h-[220px] overflow-hidden rounded-[22px] border border-[var(--flota-hair)] bg-[#0A0D14] sm:h-[340px]"
        >
          <Image
            src={heroImg}
            format="webp"
            alt=""
            width={1180}
            height={680}
            class="absolute inset-0 h-full w-full object-cover"
            style="position: absolute; inset: 0; height: 100%; width: 100%; object-fit: cover;"
          />
        </div>
      </div>
    </div>

    <!-- Nasza flota -->
    <div class="mx-auto max-w-[1180px] px-[22px] pt-[32px] sm:px-[48px] sm:pt-[54px]">
      <h2 class="text-foreground text-[23px] font-bold tracking-[-0.6px] sm:text-[32px] sm:tracking-[-1px]">
        {t("info.fleetHeading")}
      </h2>
      <div class="mt-1 mb-1.5 text-[14px] text-[var(--flota-ink-2)] sm:text-[15px]">
        {t("info.fleetLead")}
      </div>
      <div class="mt-1 grid grid-cols-1 sm:mt-3 sm:grid-cols-2 sm:gap-x-14">
        {
          fleetItems.map((item) => (
            <div class="flex items-start gap-4 border-b border-[var(--flota-hair-2)] py-[15px] sm:px-[2px] sm:py-[18px]">
              <span class="mt-0.5 shrink-0 leading-none">
                <InfoIcon name={item.icon} size={26} color="var(--flota-accent)" />
              </span>
              <div>
                <div class="text-foreground text-[15px] font-bold tracking-[-0.3px] sm:text-[16px]">{item.title}</div>
                <div class="text-muted-foreground mt-[3px] text-[13px] leading-[1.45]">{item.desc}</div>
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Dlaczego Flota -->
    <div class="mx-auto max-w-[1180px] px-[22px] pt-[32px] sm:px-[48px] sm:pt-[54px]">
      <h2 class="text-foreground text-[23px] font-bold tracking-[-0.6px] sm:text-[32px] sm:tracking-[-1px]">
        {t("info.valuesHeading")}
      </h2>
      <div class="mt-2 grid grid-cols-1 sm:mt-[26px] sm:grid-cols-3 sm:gap-x-11 sm:gap-y-[34px]">
        {
          values.map((v) => (
            <div class="border-t border-[var(--flota-hair-2)] py-[18px] sm:border-t-0 sm:py-[2px]">
              <InfoIcon name={v.icon} size={30} color="var(--flota-accent)" />
              <div class="text-foreground mt-3 text-[15.5px] font-bold tracking-[-0.3px] sm:mt-4 sm:text-[17px]">
                {v.title}
              </div>
              <div class="mt-1.5 max-w-[300px] text-[13.5px] leading-[1.55] text-[var(--flota-ink-2)] sm:text-[14.5px]">
                {v.desc}
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Kontakt card -->
    <div class="mx-auto max-w-[1180px] px-[22px] pt-[32px] sm:px-[48px] sm:pt-[54px]">
      <div
        id="kontakt"
        class="bg-ink-deep grid grid-cols-1 gap-[22px] rounded-[24px] p-6 sm:grid-cols-2 sm:gap-10 sm:px-[44px] sm:py-[40px]"
      >
        <div>
          <div class="text-primary inline-flex items-center gap-2 text-[12px] font-bold tracking-[1px] uppercase">
            <span class="bg-primary size-1.5 rounded-full"></span>
            {t("info.contactEyebrow")}
          </div>
          <div class="mt-3 mb-2 text-[24px] leading-[1.05] font-bold tracking-[-0.8px] text-white sm:text-[32px]">
            {t("info.contactHeading")}
          </div>
          <div class="text-[14px] leading-[1.55] text-white/[0.72] sm:text-[15.5px]">
            {t("info.contactLead")}
          </div>
          <a
            href="/fleet"
            class="bg-primary mt-5 inline-flex h-12 items-center gap-2 rounded-[12px] px-6 text-[15px] font-[650] text-white"
          >
            {t("info.reserveVehicle")}
            <InfoIcon name="arrowRight" size={17} color="#fff" />
          </a>
        </div>
        <div class="flex flex-col gap-1">
          {
            contacts.map((c) => (
              <div class="flex items-center gap-3.5 border-b border-white/10 py-[13px] last:border-b-0">
                <div class="flex size-[42px] shrink-0 items-center justify-center rounded-[11px] bg-white/10">
                  <InfoIcon name={c.icon} size={20} color="#fff" />
                </div>
                <div>
                  <div class="text-[11.5px] font-bold tracking-[0.4px] text-white/50 uppercase">{c.k}</div>
                  {c.href ? (
                    <a href={c.href} class="mt-0.5 block text-[15px] font-[650] text-white sm:text-[16px]">
                      {c.v}
                    </a>
                  ) : (
                    <div class="mt-0.5 text-[15px] font-[650] text-white sm:text-[16px]">{c.v}</div>
                  )}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <div class="h-9 sm:h-[60px]"></div>
  </main>

  <SiteFooter />
</Layout>
