---
// core
import { format } from "date-fns";
import { pl } from "date-fns/locale";

// components
import Layout from "../../layouts/Layout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import VehicleCard from "../../components/vehicle/VehicleCard.astro";
import CategoryIcon from "../../components/vehicle/CategoryIcon.astro";
import FilterBar from "../../components/vehicle/FilterBar.tsx";
import FleetTypeScroll from "../../components/vehicle/FleetTypeScroll.tsx";

// others
import type { CatalogSort, Vehicle, VehicleCategory, VehicleFilters } from "../../types";
import { parseFilters, serializeFilters, validateDateRange } from "../../lib/catalog-filters";
import { getCategoryCounts, listVehicles, searchAvailableVehicles } from "../../lib/services/vehicles";
import { categoryLabelPl, formatPayloadKg } from "../../lib/format";
import { fromIsoDate } from "../../lib/date-iso";

// The filterable catalog. Reads filter state from the URL, validates the date
// range against the booking rule, and routes to the dated availability RPC
// (`searchAvailableVehicles`) when a valid range is present, else the undated
// `listVehicles`. On an invalid range it skips the query and surfaces the inline
// message. Category tabs are plain anchors that preserve the other filters; the
// <FilterBar> island commits changes back to the URL. View transitions come from
// the layout's <ClientRouter />; FilterBar is intentionally NOT persisted so it
// remounts and re-reads `initial` from the live URL on every navigation.

const supabase = Astro.locals.supabase;
const filters = parseFilters(Astro.url.searchParams);
const dateCheck = validateDateRange(filters.pickup, filters.return);

let vehicles: Vehicle[] = [];
let dateError: string | null = null;

if (!dateCheck.ok) {
  dateError = dateCheck.error;
} else if (filters.pickup && filters.return) {
  vehicles = await searchAvailableVehicles(supabase, filters);
} else {
  vehicles = await listVehicles(supabase, filters);
}

const CATEGORIES: VehicleCategory[] = [
  "cargo_van",
  "passenger_van",
  "car_transporter",
  "refrigerated_truck",
  "flatbed_truck",
];

// Per-type fleet sizes for the tab counts (design screens 02/08: `label · N`).
const counts = await getCategoryCounts(supabase);

// Tab model: "Wszystkie" (grid icon) + one per category (silhouette icon). The
// count is the fleet size for that type, independent of the active filters.
const tabs: { category: VehicleCategory | null; label: string; count: number }[] = [
  { category: null, label: "Wszystkie", count: counts.total },
  ...CATEGORIES.map((category) => ({
    category,
    label: categoryLabelPl(category),
    count: counts.byCategory[category],
  })),
];

// Tab links preserve the current filters and only swap `category`.
function tabHref(category: VehicleCategory | null): string {
  const params = serializeFilters({ ...filters, category });
  const query = params.toString();
  return `/fleet${query ? `?${query}` : ""}`;
}

// The mobile dark type-pill scroller (FleetTypeScroll island) needs each tab's href
// resolved server-side so its anchors work before hydration / with JS off.
const scrollerPills = tabs.map((tab) => ({
  category: tab.category,
  label: tab.label,
  count: tab.count,
  href: tabHref(tab.category),
}));

// Active-filter summary chips: indicate what's applied and let the visitor drop a
// single filter (link to the listing minus that one) or clear all (→ /fleet).
const hasActiveFilters =
  filters.category !== null ||
  filters.pickup !== null ||
  filters.return !== null ||
  filters.minPayload !== null ||
  filters.sort !== null;

function withoutFilter(patch: Partial<VehicleFilters>): string {
  const params = serializeFilters({ ...filters, ...patch });
  const query = params.toString();
  return `/fleet${query ? `?${query}` : ""}`;
}

function rangeLabel(pickup: string, returnDate: string): string {
  const from = fromIsoDate(pickup);
  const to = fromIsoDate(returnDate);
  if (!from || !to) {
    return "";
  }
  return `${format(from, "d MMM", { locale: pl })} – ${format(to, "d MMM", { locale: pl })}`;
}

const SORT_LABELS: Record<CatalogSort, string> = {
  price_asc: "Cena: rosnąco",
  price_desc: "Cena: malejąco",
};

const chipClass =
  "bg-card text-foreground hover:border-foreground/25 inline-flex items-center gap-1.5 rounded-full border border-[var(--flota-hair)] px-3.5 py-1.5 text-[13px] font-semibold transition-colors";
---

<Layout title="Flota — przeglądaj pojazdy">
  <SiteHeader active="fleet" />

  <main class="max-w-app mx-auto px-5 pb-16 sm:px-8 lg:px-12">
    <!-- Result count (mock-silent; kept as a deviation per the keep-all decision,
         restyled to a compact on-brand scale that leads the pill bar). -->
    <div class="pt-8 pb-5 sm:pt-10">
      <h1 class="text-foreground text-[26px] font-bold tracking-tight sm:text-[30px]">
        {vehicles.length}{" "}
        <span class="text-muted-foreground font-normal">pojazdów gotowych do wynajmu.</span>
      </h1>
    </div>

    <!-- Category type-pills (desktop / tablet, design ScreenDesktopFleet). Each pill
         is an anchor carrying its category filter — instant nav preserved. Hidden
         below sm; the mobile scroll block below covers < sm until Phase 4 swaps in
         the dark scroller. -->
    <div class="hidden flex-wrap gap-3 pb-[22px] sm:flex">
      {
        tabs.map((tab) => (
          <a
            href={tabHref(tab.category)}
            class:list={[
              "inline-flex h-[52px] shrink-0 items-center gap-2.5 rounded-full pr-[22px] pl-4 text-[14.5px] font-semibold transition-colors",
              filters.category === tab.category
                ? "bg-[var(--flota-ink-deep)] text-white"
                : "bg-card text-foreground hover:border-foreground/25 border border-[var(--flota-hair)]",
            ]}
          >
            {tab.category === null ? (
              <svg
                class="size-[18px] shrink-0"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <rect x="3" y="3" width="7" height="7" />
                <rect x="14" y="3" width="7" height="7" />
                <rect x="3" y="14" width="7" height="7" />
                <rect x="14" y="14" width="7" height="7" />
              </svg>
            ) : (
              <CategoryIcon category={tab.category} class="size-[18px]" />
            )}
            <span>
              {tab.label} · {tab.count}
            </span>
          </a>
        ))
      }
    </div>

    <!-- Category type-pills (mobile, design ScreenMobileFleet). The dark animated
         scroller; anchors still navigate before hydration. Hidden at sm+. -->
    <FleetTypeScroll pills={scrollerPills} active={filters.category} client:visible />

    <!-- Filter bar -->
    <div class="pb-4">
      <FilterBar initial={filters} client:load />
    </div>

    <!-- Active filters -->
    {
      hasActiveFilters && (
        <div class="flex flex-wrap items-center gap-2 pb-6">
          <span class="text-muted-foreground text-xs font-semibold tracking-wide uppercase">Aktywne filtry:</span>
          {filters.category && (
            <a href={withoutFilter({ category: null })} class:list={chipClass}>
              {categoryLabelPl(filters.category)}
              <span aria-hidden="true" class="text-base leading-none">
                ×
              </span>
            </a>
          )}
          {dateCheck.ok && filters.pickup && filters.return && (
            <a href={withoutFilter({ pickup: null, return: null })} class:list={chipClass}>
              {rangeLabel(filters.pickup, filters.return)}
              <span aria-hidden="true" class="text-base leading-none">
                ×
              </span>
            </a>
          )}
          {filters.minPayload !== null && (
            <a href={withoutFilter({ minPayload: null })} class:list={chipClass}>
              od {formatPayloadKg(filters.minPayload)}
              <span aria-hidden="true" class="text-base leading-none">
                ×
              </span>
            </a>
          )}
          {filters.sort && (
            <a href={withoutFilter({ sort: null })} class:list={chipClass}>
              {SORT_LABELS[filters.sort]}
              <span aria-hidden="true" class="text-base leading-none">
                ×
              </span>
            </a>
          )}
          <a href="/fleet" class="text-muted-foreground hover:text-foreground ml-1 text-sm font-medium hover:underline">
            Wyczyść wszystko
          </a>
        </div>
      )
    }

    <!-- Results. The mock is silent on the empty / date-error states; these are
         designed on-brand (centered card in the results region, existing Polish
         copy). No loading treatment is warranted — results are SSR'd, so a filter
         apply navigates straight to the rendered page (no client-side fetch). -->
    {
      dateError ? (
        <div class="bg-card shadow-card mx-auto flex max-w-md flex-col items-center gap-3 rounded-[22px] px-6 py-16 text-center">
          <span class="text-primary bg-accent flex size-14 items-center justify-center rounded-full">
            <svg
              class="size-6"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect x="3" y="4" width="18" height="18" rx="2" />
              <path d="M3 10h18M8 2v4M16 2v4M12 14v3" />
              <circle cx="12" cy="18.5" r="0.6" fill="currentColor" stroke="none" />
            </svg>
          </span>
          <p class="text-foreground text-lg font-bold tracking-tight">{dateError}</p>
          <p class="text-muted-foreground text-sm">Popraw zakres dat, aby zobaczyć dostępne pojazdy.</p>
        </div>
      ) : vehicles.length === 0 ? (
        <div class="bg-card shadow-card mx-auto flex max-w-md flex-col items-center gap-3 rounded-[22px] px-6 py-16 text-center">
          <span class="text-muted-foreground bg-secondary flex size-14 items-center justify-center rounded-full">
            <svg
              class="size-6"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="11" cy="11" r="7" />
              <path d="M21 21l-4.3-4.3" />
            </svg>
          </span>
          <p class="text-foreground text-lg font-bold tracking-tight">Brak pojazdów spełniających kryteria</p>
          <p class="text-muted-foreground text-sm">Zmień filtry lub zakres dat, aby zobaczyć więcej.</p>
        </div>
      ) : (
        <div class="grid grid-cols-1 gap-[22px] sm:grid-cols-2 lg:grid-cols-3">
          {vehicles.map((vehicle) => (
            <VehicleCard vehicle={vehicle} pickup={filters.pickup} returnDate={filters.return} />
          ))}
        </div>
      )
    }
  </main>

  <SiteFooter />
</Layout>
