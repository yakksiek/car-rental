---
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";

import "../styles/global.css";
import Banner from "../components/Banner.astro";
import { missingConfigs } from "../lib/config-status";

interface Props {
  title?: string;
}

const { title = "Flota — wynajem pojazdów użytkowych" } = Astro.props;
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#B43638" />
    {
      /* Portfolio deployment — nothing here belongs in a search index. Site-wide
        rather than per-page because the reason is the deployment, not the route:
        the data is fictional, and /auth/signin publishes demo credentials.
        `public/robots.txt` is the companion, and the two do DIFFERENT jobs — that
        file stops crawling, this stops indexing of a URL found via a link (a CV,
        say). See the removal note in robots.txt if anything is already indexed.
        The page-level noindex on /reserve and /r/[token] predates this and stays:
        those are noindex for their own per-page reason. */
    }
    <meta name="robots" content="noindex, nofollow" />
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-instrument-serif" preload={[{ style: "normal" }]} />
    <Font cssVariable="--font-jetbrains-mono" />
    <ClientRouter />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body>
    {
      missingConfigs.map((cfg) => (
        <Banner variant="error">
          <strong>Uwaga:</strong> {cfg.message}
          {cfg.docsUrl && (
            <>
              {" "}
              <a href={cfg.docsUrl} target="_blank" rel="noopener noreferrer">
                {cfg.docsLabel ?? "Dokumentacja"}
              </a>
              .
            </>
          )}
        </Banner>
      ))
    }
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
